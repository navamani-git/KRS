@model IEnumerable<KRSDealerManagement.Application.DTOs.VehicleDto>
@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "My Vehicles";
    var isSubdealer = ViewBag.IsSubdealer ?? false;
    var isAdmin = ViewBag.IsAdmin ?? false;
    var subdealers = ViewBag.Subdealers as IEnumerable<UserDto>;
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-ev-front"></i> @(isSubdealer ? "My Vehicles" : "Subdealer Vehicles")</h1>
        <p class="text-muted">
            @(isSubdealer
                ? "All vehicles from your purchase orders and dealer-created orders — view details, book customers, request returns, upload subsidy documents."
                : "Vehicles under your dealership")
        </p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">From</label>
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">To</label>
                <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
            </div>
            @if (!isSubdealer)
            {
                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-0">Subdealer</label>
                    <select name="subdealerId" class="form-select form-select-sm">
                        <option value="">All Subdealers</option>
                        @if (subdealers != null)
                        {
                            @foreach (var s in subdealers)
                            {
                                <option value="@s.UserId" selected="@(ViewBag.SelectedSubdealerId?.ToString() == s.UserId.ToString())">
                                    @s.GetFullName()
                                </option>
                            }
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Search</label>
                <input type="text" name="searchTerm" class="form-control form-control-sm"
                       placeholder="Chassis, order, motor..." value="@ViewBag.SearchTerm" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter"></i> Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Vehicles (@(ViewBag.TotalItems ?? Model.Count()))</h3>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            @if (!isSubdealer)
                            {
                                <th>Subdealer</th>
                            }
                            <th>Order Date</th>
                            <th>Order #</th>
                            <th>Allocated</th>
                            <th>Chassis</th>
                            <th>Model</th>
                            <th>Color</th>
                            @if (isSubdealer)
                            {
                                <th>Source</th>
                            }
                            <th class="text-end">Price (₹)</th>
                            <th>Delivery</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sr = 1; }
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td>@(sr++)</td>
                                @if (!isSubdealer)
                                {
                                    <td><small>@v.SubdealerName</small></td>
                                }
                                <td>
                                    @if (v.OrderDate.HasValue)
                                    {
                                        <small>@v.OrderDate.Value.ToString("yyyy-MM-dd")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (v.PurchaseOrderId.HasValue)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "Details", new { id = v.PurchaseOrderId }, "Orders")">
                                            <small>@(v.OrderNumber ?? $"#{v.PurchaseOrderId}")</small>
                                        </a>
                                    }
                                    else
                                    {
                                        <small class="text-muted">—</small>
                                    }
                                </td>
                                <td>
                                    @if (v.AllocatedDate.HasValue)
                                    {
                                        <small>@v.AllocatedDate.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <a href="#" class="text-decoration-none chassis-link" data-id="@v.VehicleId" title="View motor, battery & component details">
                                        <code class="small">@v.ChassisNumber</code>
                                    </a>
                                </td>
                                <td>@v.ModelName</td>
                                <td>@v.ColorName</td>
                                @if (isSubdealer)
                                {
                                    <td>
                                        @if (v.CreatedByDealer)
                                        {
                                            <span class="badge bg-secondary">Dealer</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">My order</span>
                                        }
                                    </td>
                                }
                                <td class="text-end fw-bold">₹@v.CurrentPrice.ToString("N2")</td>
                                <td>
                                    @if (v.IsInDeliveryPipeline)
                                    {
                                        <span class="badge @v.GetDeliveryBadgeClass()">@v.GetDeliveryStatusDisplay()</span>
                                    }
                                    else
                                    {
                                        <small class="text-muted">@v.GetDeliveryStatusDisplay()</small>
                                    }
                                </td>
                                <td><span class="badge @v.GetBadgeClass()">@v.GetStatusDisplay()</span></td>
                                <td class="text-nowrap">
                                    @if (isSubdealer && v.CanRequestReturn)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning return-btn"
                                                data-id="@v.VehicleId"
                                                data-chassis="@v.ChassisNumber"
                                                data-price="@v.CurrentPrice">
                                            <i class="bi bi-arrow-return-left"></i> Return
                                        </button>
                                    }
                                    else if (isSubdealer && v.IsReturnPending)
                                    {
                                        <a href="@Url.Action("MyReturns", "Returns")" class="badge bg-warning text-dark text-decoration-none">Return pending</a>
                                    }
                                    @if (isSubdealer && v.CanBook)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "Book", new { vehicleId = v.VehicleId }, "VehicleBookings")" class="btn btn-sm btn-primary">Book</a>
                                    }
                                    else if (isSubdealer && v.IsAwaitingDealerApproval)
                                    {
                                        <span class="badge bg-warning text-dark" title="Dealer will allocate chassis and approve">Awaiting dealer</span>
                                    }
                                    @if (isSubdealer && v.CanSubmitSubsidyDocs)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "SubsidyDocs", new { id = v.VehicleBookingId }, "VehicleBookings")" class="btn btn-sm btn-warning">Subsidy Docs</a>
                                    }
                                    @if (isSubdealer && v.CanMarkDelivered)
                                    {
                                        <form method="post" action="@Url.EAction(QueryCrypto, "MarkDelivered", new { id = v.VehicleBookingId }, "VehicleBookings")" class="d-inline" onsubmit="return confirm('Mark this vehicle as delivered?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">Mark Delivered</button>
                                        </form>
                                    }
                                    @if (v.HasBooking)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "Manage", new { id = v.VehicleBookingId }, "VehicleBookings")" class="btn btn-sm btn-outline-info">View Booking</a>
                                    }
                                    @if (isAdmin)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "AdminEdit", new { id = v.VehicleId })" class="btn btn-sm btn-warning" title="Admin correction">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3 text-muted">
                <i class="bi bi-info-circle"></i> No vehicles found.
                @if (isSubdealer)
                {
                    <span>Place a <a href="@Url.Action("Create", "Orders")">purchase order</a> or ask your dealer to create one — vehicles appear here as soon as the order is submitted.</span>
                }
            </div>
        }
        <div class="p-3">
            <partial name="_Pagination" />
        </div>
    </div>
</div>

@if (isSubdealer)
{
    <div class="modal fade" id="returnRequestModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="RaiseReturn">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="vehicleId" id="returnVehicleId" />
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-arrow-return-left"></i> Request Return</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted mb-3">
                            Request a return for an approved vehicle that has not been booked yet.
                            Admin will review and process the refund.
                        </p>
                        <div class="mb-2">
                            <label class="form-label fw-bold">Chassis</label>
                            <input type="text" class="form-control" id="returnChassis" readonly />
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold">Vehicle price (₹)</label>
                            <input type="text" class="form-control" id="returnVehiclePrice" readonly />
                            <small class="text-muted">Refund amount will be set by admin when your return is approved.</small>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold">Reason for return</label>
                            <textarea name="returnReason" class="form-control" rows="3"
                                      placeholder="Explain why you want to return this vehicle..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-arrow-return-left"></i> Submit Return Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="vehicleDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-ev-front"></i> Vehicle Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="vehicleDetailsBody">
                <div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm"></span> Loading...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.return-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.getElementById('returnVehicleId').value = btn.dataset.id;
        document.getElementById('returnChassis').value = btn.dataset.chassis;
        document.getElementById('returnVehiclePrice').value = '₹' + Number(btn.dataset.price).toLocaleString('en-IN', { minimumFractionDigits: 2 });
        new bootstrap.Modal(document.getElementById('returnRequestModal')).show();
    });
});

document.querySelectorAll('.chassis-link').forEach(link => {
    link.addEventListener('click', async e => {
        e.preventDefault();
        const id = link.dataset.id;
        const modal = new bootstrap.Modal(document.getElementById('vehicleDetailsModal'));
        const body = document.getElementById('vehicleDetailsBody');
        body.innerHTML = '<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm"></span> Loading...</div>';
        modal.show();
        try {
            const resp = await KrsQueryString.fetchGet('/Vehicles/DetailsJson', { id });
            const data = await resp.json();
            if (!data.success) { body.innerHTML = '<div class="alert alert-danger">Unable to load vehicle details.</div>'; return; }
            const fmt = v => v ? v : '-';
            const fmtDate = v => v ? new Date(v).toLocaleDateString() : '-';
            let bookingHtml = '';
            if (data.booking) {
                const b = data.booking;
                bookingHtml = `
                <h6 class="mt-3 border-bottom pb-1">Booking & Delivery</h6>
                <table class="table table-sm table-bordered">
                    <tr><td width="35%"><strong>Booking Status</strong></td><td><span class="badge bg-primary">${fmt(b.status)}</span></td></tr>
                    <tr><td><strong>Customer</strong></td><td>${fmt(b.customerName)}${b.isCompanyBooking ? ' (Company)' : ''}</td></tr>
                    <tr><td><strong>Mobile / Alt</strong></td><td>${fmt(b.customerMobile)} / ${fmt(b.alternativeMobile)}</td></tr>
                    <tr><td><strong>Email</strong></td><td>${fmt(b.customerEmail)}</td></tr>
                    <tr><td><strong>Document / RTO</strong></td><td>${fmt(b.documentType)} · ${fmt(b.rtoLocation)}</td></tr>
                    <tr><td><strong>Payment / Financier</strong></td><td>${fmt(b.paymentMode)} · ${fmt(b.financier)}</td></tr>
                    <tr><td><strong>Nominee</strong></td><td>${fmt(b.nomineeName)} (${fmt(b.nomineeRelationship)}) · ${fmt(b.nomineeDob)}</td></tr>
                    <tr><td><strong>Submitted</strong></td><td>${fmt(b.submittedDate)}</td></tr>
                    <tr><td><strong>PAP Received</strong></td><td>${fmt(b.paperReceivedDate)}</td></tr>
                    <tr><td><strong>Invoice Date</strong></td><td>${fmt(b.invoiceDate)}</td></tr>
                    <tr><td><strong>Insurance Date</strong></td><td>${fmt(b.insuranceDate)}</td></tr>
                    <tr><td><strong>Agent Date</strong></td><td>${fmt(b.agentDate)}</td></tr>
                    <tr><td><strong>Registration</strong></td><td>${fmt(b.registrationDate)} · RTO: ${fmt(b.rtoNumber)}</td></tr>
                    <tr><td><strong>Number Plate</strong></td><td>${fmt(b.numberPlateReceivedDate)}</td></tr>
                    <tr><td><strong>Subsidy ID</strong></td><td>${fmt(b.subsidyId)}</td></tr>
                    <tr><td><strong>Subsidy Docs</strong></td><td>${fmt(b.subsidyDocsSubmittedDate)}</td></tr>
                </table>`;
            } else {
                bookingHtml = '<p class="text-muted mt-3"><em>No booking submitted yet.</em></p>';
            }
            body.innerHTML = `
                <h6 class="border-bottom pb-1">Vehicle</h6>
                <table class="table table-sm">
                    <tr><td width="35%"><strong>Chassis</strong></td><td><code>${data.chassisNumber}</code></td></tr>
                    <tr><td><strong>Model / Color</strong></td><td>${data.modelName} · ${data.colorName}</td></tr>
                    <tr><td><strong>Status</strong></td><td><span class="badge bg-primary">${fmt(data.statusName)}</span></td></tr>
                    <tr><td><strong>Motor</strong></td><td>${fmt(data.motorNo)}</td></tr>
                    <tr><td><strong>Battery</strong></td><td>${fmt(data.batteryNo)}</td></tr>
                    <tr><td><strong>Charger</strong></td><td>${fmt(data.chargerNo)}</td></tr>
                    <tr><td><strong>Controller</strong></td><td>${fmt(data.controllerNo)}</td></tr>
                    <tr><td><strong>Converter</strong></td><td>${fmt(data.converterNo)}</td></tr>
                    <tr><td><strong>Order #</strong></td><td>${fmt(data.orderNumber)}</td></tr>
                    <tr><td><strong>Order Date</strong></td><td>${fmt(data.orderDate)}</td></tr>
                    <tr><td><strong>Allocated</strong></td><td>${fmt(data.allocatedDate)}</td></tr>
                    <tr><td><strong>Subdealer</strong></td><td>${fmt(data.subdealerName)}</td></tr>
                    <tr><td><strong>Current Price</strong></td><td>₹${Number(data.currentPrice).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td></tr>
                    <tr><td><strong>Original Price</strong></td><td>${data.originalPrice != null ? '₹' + Number(data.originalPrice).toLocaleString('en-IN', {minimumFractionDigits: 2}) : '-'}</td></tr>
                    <tr><td><strong>Delivery Status</strong></td><td><span class="badge bg-primary">${data.deliveryStatus}</span></td></tr>
                    <tr><td><strong>Change History</strong></td><td><small style="white-space:pre-wrap">${fmt(data.notes || data.correctionHistory)}</small></td></tr>
                </table>
                ${bookingHtml}`;
        } catch {
            body.innerHTML = '<div class="alert alert-danger">Failed to load vehicle details.</div>';
        }
    });
});
</script>
}
