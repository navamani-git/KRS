@model IEnumerable<KRSDealerManagement.Application.DTOs.VehicleDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "My Vehicles";
    var isSubdealer = ViewBag.IsSubdealer ?? false;
    var isAdmin = ViewBag.IsAdmin ?? false;
    var subdealers = ViewBag.Subdealers as IEnumerable<UserDto>;
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-ev-front"></i> @(isSubdealer ? "My Vehicles" : "Subdealer Vehicles")</h1>
        <p class="text-muted">
            @(isSubdealer
                ? "All vehicles from your purchase orders and dealer-created orders — view details, book customers, request returns, upload subsidy documents."
                : "Vehicles under your dealership")
        </p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end" id="gridFilterForm">
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">From</label>
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">To</label>
                <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
            </div>
            @if (!isSubdealer)
            {
                var locations = ViewBag.DealershipLocations as IEnumerable<string> ?? Enumerable.Empty<string>();
                var selectedLocation = ViewBag.SelectedDealershipLocation as string;
                <div class="col-md-2">
                    <label class="form-label form-label-sm mb-0">Dealer location</label>
                    <select name="dealershipLocation" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">All locations</option>
                        @foreach (var loc in locations)
                        {
                            <option value="@loc" selected="@(string.Equals(selectedLocation, loc, StringComparison.OrdinalIgnoreCase))">@loc</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-0">Subdealer</label>
                    <select name="subdealerId" class="form-select form-select-sm">
                        <option value="">All Subdealers</option>
                        @if (subdealers != null)
                        {
                            @foreach (var s in subdealers)
                            {
                                <option value="@s.UserId" selected="@(ViewBag.SelectedSubdealerId?.ToString() == s.UserId.ToString())">
                                    @s.GetFullName()
                                </option>
                            }
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Search</label>
                <input type="text" name="searchTerm" class="form-control form-control-sm"
                       placeholder="Chassis, order, motor..." value="@ViewBag.SearchTerm" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter"></i> Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Vehicles (@(ViewBag.TotalItems ?? Model.Count()))</h3>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <partial name="_GridScrollHint" />
            <div class="table-responsive">
                <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@GridIds.Vehicles">
                    <thead class="table-dark">
                        <tr>
                            <th class="grid-col-rownum">#</th>
                            @if (!isSubdealer)
                            {
                                <th>Subdealer</th>
                            }
                            <th>Order Date</th>
                            <th>Order #</th>
                            <th>Allocated</th>
                            <th>Model</th>
                            <th>Color</th>
                            <th>Chassis</th>
                            @if (isSubdealer)
                            {
                                <th>Source</th>
                            }
                            <th class="text-end">Price (₹)</th>
                            <th>Delivery</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                        <partial name="_PaginatedGridFilters" />
                    </thead>
                    <tbody>
                        @{ int sr = 1; }
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td>@(sr++)</td>
                                @if (!isSubdealer)
                                {
                                    <td><small>@v.SubdealerName</small></td>
                                }
                                <td>
                                    @if (v.OrderDate.HasValue)
                                    {
                                        <small>@v.OrderDate.Value.ToString("yyyy-MM-dd")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (v.PurchaseOrderId.HasValue)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "Details", new { id = v.PurchaseOrderId }, "Orders")">
                                            <small>@(v.OrderNumber ?? $"#{v.PurchaseOrderId}")</small>
                                        </a>
                                    }
                                    else
                                    {
                                        <small class="text-muted">—</small>
                                    }
                                </td>
                                <td>
                                    @if (v.AllocatedDate.HasValue)
                                    {
                                        <small>@v.AllocatedDate.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@v.ModelName</td>
                                <td>@v.ColorName</td>
                                <td>
                                    <partial name="_ChassisLink" view-data='new ViewDataDictionary(ViewData) {
                                        { "VehicleId", v.VehicleId }, { "Chassis", v.ChassisNumber } }' />
                                </td>
                                @if (isSubdealer)
                                {
                                    <td>
                                        @if (v.CreatedByDealer)
                                        {
                                            <span class="badge bg-secondary">Dealer</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">My order</span>
                                        }
                                    </td>
                                }
                                <td class="text-end fw-bold">₹@v.CurrentPrice.ToString("N2")</td>
                                <td>
                                    @if (v.IsDelivered)
                                    {
                                        <span class="badge @v.GetDeliveryBadgeClass()"
                                              title="@v.GetDeliveryDateTooltip()">@v.GetDeliveryStatusDisplay()</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@v.GetDeliveryStatusDisplay()</span>
                                    }
                                </td>
                                <td><span class="badge @v.GetBadgeClass()">@v.GetStatusDisplay()</span></td>
                                <td class="text-nowrap">
                                    @if (isSubdealer && v.CanRequestReturn)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning return-btn"
                                                data-id="@v.VehicleId"
                                                data-chassis="@v.ChassisNumber"
                                                data-price="@v.CurrentPrice">
                                            <i class="bi bi-arrow-return-left"></i> Return
                                        </button>
                                    }
                                    else if (isSubdealer && v.IsReturnPending)
                                    {
                                        <a href="@Url.Action("MyReturns", "Returns")" class="badge bg-warning text-dark text-decoration-none">Return pending</a>
                                    }
                                    @if (isSubdealer && v.CanBook)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "Book", new { vehicleId = v.VehicleId }, "VehicleBookings")" class="btn btn-sm btn-primary">Book</a>
                                    }
                                    else if (isSubdealer && v.IsAwaitingDealerApproval)
                                    {
                                        <span class="badge bg-warning text-dark" title="Dealer will allocate chassis and approve">Awaiting dealer</span>
                                    }
                                    @if (isSubdealer && v.CanSubmitSubsidyDocs)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "SubsidyDocs", new { id = v.VehicleBookingId }, "VehicleBookings")" class="btn btn-sm btn-warning">Subsidy Docs</a>
                                    }
                                    @if (isSubdealer && v.CanMarkDelivered)
                                    {
                                        <button type="button" class="btn btn-sm btn-success deliver-btn"
                                                data-vehicle-id="@v.VehicleId"
                                                data-order-date="@(v.OrderDate?.ToString("yyyy-MM-dd") ?? v.CreatedDate.ToString("yyyy-MM-dd"))"
                                                data-chassis="@v.ChassisNumber">
                                            <i class="bi bi-check-circle"></i> Deliver
                                        </button>
                                    }
                                    @if (isSubdealer && v.CanEditBooking)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "Edit", new { id = v.VehicleBookingId }, "VehicleBookings")" class="btn btn-sm btn-outline-primary">Edit Booking</a>
                                    }
                                    @if (v.HasBooking)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "Manage", new { id = v.VehicleBookingId }, "VehicleBookings")" class="btn btn-sm btn-outline-info">View Booking</a>
                                    }
                                    @if (isSubdealer && v.HasBooking)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(v.InvoicePath))
                                        {
                                            <a href="@BookingFileUrls.Download(Url, QueryCrypto, v.InvoicePath)" class="btn btn-sm btn-outline-secondary py-0" title="Download invoice"><i class="bi bi-download"></i> Inv</a>
                                        }
                                        else if (v.BookingInvoiceDate.HasValue)
                                        {
                                            <span class="btn btn-sm btn-outline-secondary py-0 disabled" title="Invoice pending upload from dealer"><i class="bi bi-download"></i> Inv</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(v.InsurancePath))
                                        {
                                            <a href="@BookingFileUrls.Download(Url, QueryCrypto, v.InsurancePath)" class="btn btn-sm btn-outline-secondary py-0" title="Download insurance"><i class="bi bi-download"></i> Ins</a>
                                        }
                                        else if (v.BookingInsuranceDate.HasValue)
                                        {
                                            <span class="btn btn-sm btn-outline-secondary py-0 disabled" title="Insurance pending upload from dealer"><i class="bi bi-download"></i> Ins</span>
                                        }
                                    }
                                    @if (isAdmin)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "AdminEdit", new { id = v.VehicleId })" class="btn btn-sm btn-warning" title="Admin correction">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3 text-muted">
                <i class="bi bi-info-circle"></i> No vehicles found.
                @if (isSubdealer)
                {
                    <span>Place a <a href="@Url.Action("Create", "Orders")">purchase order</a> or ask your dealer to create one — vehicles appear here as soon as the order is submitted.</span>
                }
            </div>
        }
        <div class="p-3">
            <partial name="_Pagination" />
        </div>
    </div>
</div>

@if (isSubdealer)
{
    <div class="modal fade" id="deliverModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="MarkDelivered">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="vehicleId" id="deliverVehicleId" />
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-check-circle"></i> Mark Delivered</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted mb-3">Record the date the vehicle was delivered to the customer.</p>
                        <div class="mb-2">
                            <label class="form-label fw-bold">Chassis</label>
                            <input type="text" class="form-control" id="deliverChassis" readonly />
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-bold">Delivery date <span class="text-danger">*</span></label>
                            <input type="date" name="deliveryDate" id="deliverDate" class="form-control" required />
                            <small class="text-muted">Cannot be in the future or before the order date.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Mark Delivered
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="returnRequestModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="RaiseReturn">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="vehicleId" id="returnVehicleId" />
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-arrow-return-left"></i> Request Return</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted mb-3">
                            Request a return for an approved vehicle that has not been booked yet.
                            Admin will review and process the refund.
                        </p>
                        <div class="mb-2">
                            <label class="form-label fw-bold">Chassis</label>
                            <input type="text" class="form-control" id="returnChassis" readonly />
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold">Vehicle price (₹)</label>
                            <input type="text" class="form-control" id="returnVehiclePrice" readonly />
                            <small class="text-muted">Refund amount will be set by admin when your return is approved.</small>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold">Reason for return</label>
                            <textarea name="returnReason" class="form-control" rows="3"
                                      placeholder="Explain why you want to return this vehicle..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-arrow-return-left"></i> Submit Return Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
const todayIso = new Date().toISOString().slice(0, 10);
document.querySelectorAll('.deliver-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.getElementById('deliverVehicleId').value = btn.dataset.vehicleId;
        document.getElementById('deliverChassis').value = btn.dataset.chassis;
        const dateInput = document.getElementById('deliverDate');
        dateInput.min = btn.dataset.orderDate;
        dateInput.max = todayIso;
        dateInput.value = todayIso;
        new bootstrap.Modal(document.getElementById('deliverModal')).show();
    });
});
document.querySelectorAll('.return-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.getElementById('returnVehicleId').value = btn.dataset.id;
        document.getElementById('returnChassis').value = btn.dataset.chassis;
        document.getElementById('returnVehiclePrice').value = '₹' + Number(btn.dataset.price).toLocaleString('en-IN', { minimumFractionDigits: 2 });
        new bootstrap.Modal(document.getElementById('returnRequestModal')).show();
    });
});
</script>
}
