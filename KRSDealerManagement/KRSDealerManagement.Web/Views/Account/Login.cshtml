@using KRSDealerManagement.Web.Helpers
@{
    ViewData["Title"] = "Login - KRS Dealer Management";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" class="login-page">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="shortcut icon" href="~/images/krslogo.png" type="image/png" />

    <style>
        html.login-page,
        body.login-page-body {
            width: 100%;
            margin: 0;
            padding: 0;
        }

        html.login-page {
            font-size: 17px;
            min-height: 100dvh;
            height: auto;
            overflow-x: hidden;
            overflow-y: auto;
            scrollbar-gutter: stable;
        }

        body.login-page-body {
            font-family: Verdana, Geneva, Tahoma, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
            background-attachment: fixed;
            min-height: 100dvh;
            margin: 0;
            overflow-x: hidden;
            overflow-y: visible;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            padding-top: calc(1.5rem + env(safe-area-inset-top, 0px));
            padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
            box-sizing: border-box;
        }

        .login-shell {
            width: 100%;
            max-width: 520px;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            flex: 0 0 auto;
        }

        .login-font-bar {
            width: 100%;
            max-width: 520px;
            display: flex;
            justify-content: flex-end;
            margin-bottom: 0.75rem;
            flex-shrink: 0;
        }

        .login-font-bar label {
            color: #fff !important;
        }

        .login-font-bar .form-select {
            background-color: rgba(255, 255, 255, 0.96);
            color: #212529;
            border-color: rgba(255, 255, 255, 0.45);
            min-width: 6.5rem;
        }

        .login-box {
            width: 100%;
            max-width: 520px;
            flex-shrink: 0;
        }

        .login-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 14px 48px rgba(0, 0, 0, 0.22);
            overflow: hidden;
        }

        .login-header {
            text-align: center;
            padding: 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .login-brand {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-brand--dealer {
            width: 100%;
            margin: 12px 0 0;
            overflow: hidden;
            border-radius: 12px 12px 0 0;
        }

        .login-brand__logo--dealer {
            display: block;
            width: 100%;
            max-width: 100%;
            max-height: 96px;
            height: auto;
            object-fit: contain;
            object-position: center;
        }

        .login-body {
            padding: 28px 36px 0;
        }

        .login-brand--ampere {
            width: calc(100% + 72px);
            margin: 18px -36px 0;
            padding: 0;
            overflow: hidden;
            background-color: #f9f9f9;
            border-top: 1px solid #f0f0f0;
            border-radius: 0 0 12px 12px;
            min-height: 80px;
            display: flex;
            align-items: stretch;
            justify-content: center;
        }

        .login-brand__logo--ampere {
            display: block;
            width: 100%;
            height: 100%;
            max-height: 80px;
            min-height: 72px;
            object-fit: contain;
            object-position: center;
            padding: 12px 18px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            font-weight: 500;
            color: #333;
            margin-bottom: 10px;
            font-size: 16px;
        }

        .form-control {
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 15px;
            min-height: 44px;
        }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

        .input-group-text {
            border: 1px solid #ddd;
            background-color: #f9f9f9;
            color: #667eea;
            min-height: 44px;
            padding-left: 12px;
            padding-right: 12px;
        }

        .btn-login {
            width: 100%;
            padding: 12px;
            min-height: 46px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 6px;
            color: white;
            font-weight: 600;
            font-size: 17px;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .form-check {
            font-size: 16px;
            margin-bottom: 1.25rem !important;
        }

        .alert-error {
            border-left: 4px solid #dc3545;
            background-color: #fff5f5;
            color: #842029;
            border-radius: 5px;
            padding: 12px;
            margin-bottom: 20px;
        }

        .alert-error i {
            margin-right: 8px;
        }

        .login-font-control label {
            color: #fff !important;
        }

        .login-font-control .form-select {
            background-color: rgba(255, 255, 255, 0.96);
            color: #212529;
            border-color: rgba(255, 255, 255, 0.45);
            min-width: 6.5rem;
        }

        .bi {
            font-family: "bootstrap-icons" !important;
        }

        @@media (max-width: 576px) {
            body.login-page-body {
                justify-content: flex-start;
                padding: calc(1rem + env(safe-area-inset-top, 0px)) 1rem calc(2.5rem + env(safe-area-inset-bottom, 0px));
            }

            .login-shell {
                max-width: 100%;
            }

            .login-font-bar {
                order: 2;
                margin-top: 1rem;
                margin-bottom: 0;
                justify-content: center;
            }

            .login-box {
                order: 1;
            }

            .login-body {
                padding: 24px 24px 0;
            }

            .login-brand--ampere {
                width: calc(100% + 48px);
                margin: 18px -24px 0;
                min-height: 72px;
            }

            .login-brand__logo--ampere {
                min-height: 72px;
                padding: 10px 14px;
            }
        }
    </style>
</head>
<body class="login-page-body">
    <div class="login-shell">
        <div class="login-font-bar login-font-control">
            <partial name="_FontSizeControl" />
        </div>
    <div class="login-box">
        <div class="card login-card">
            <div class="login-header">
                <div class="login-brand login-brand--dealer">
                    <img src="~/images/krslogo.png" asp-append-version="true" alt="KRS Enterprises" class="login-brand__logo--dealer" />
                </div>
            </div>

            <div class="login-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-error" role="alert">
                        <i class="bi bi-exclamation-circle"></i>
                        @TempData["Error"]
                    </div>
                }

                <form method="post" action="@Url.Action("Login", "Account")">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <div class="input-group">
                            <input type="text"
                                   class="form-control"
                                   id="username"
                                   name="username"
                                   placeholder="Enter your username"
                                   required
                                   autofocus />
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-group">
                            <input type="password"
                                   class="form-control"
                                   id="password"
                                   name="password"
                                   placeholder="Enter your password"
                                   required />
                            <span class="input-group-text" id="togglePassword" style="cursor: pointer;">
                                <i class="bi bi-eye"></i>
                            </span>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" />
                        <label class="form-check-label" for="rememberMe">Remember me</label>
                    </div>

                    <button type="submit" class="btn btn-login">
                        <i class="bi bi-box-arrow-in-right"></i> Sign In
                    </button>
                </form>

                <div class="login-brand login-brand--ampere">
                    <img src="~/images/amperelogo.png" asp-append-version="true" alt="Ampere" class="login-brand__logo--ampere" />
                </div>
            </div>
        </div>
    </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const passwordInput = document.getElementById('password');
            const icon = this.querySelector('i');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        });

        document.getElementById('rememberMe').addEventListener('change', function () {
            localStorage.setItem('rememberMe', this.checked);
        });

        window.addEventListener('load', function () {
            document.getElementById('rememberMe').checked = localStorage.getItem('rememberMe') === 'true';
        });
    </script>
</body>
</html>
