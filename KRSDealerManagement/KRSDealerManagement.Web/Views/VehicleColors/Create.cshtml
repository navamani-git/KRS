@{
    ViewData["Title"] = "Add Vehicle Color";
    ViewData["ExcelImportKey"] = KRSDealerManagement.Web.Helpers.ExcelImport.ExcelImportKeys.VehicleColors;
    ViewData["ExcelImportReturnAction"] = "Create";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-palette"></i> Add Vehicle Color</h1>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<partial name="_ExcelImport" />

<div class="row">
    <div class="col-md-6">
        <div class="card card-primary">
            <div class="card-header"><h3 class="card-title">New Color</h3></div>
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Color Name <span class="text-danger">*</span></label>
                        <input type="text" name="colorName" class="form-control"
                               placeholder="e.g., Pearl White, Jet Black, Ocean Blue" required autofocus />
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Hex Color Code</label>
                        <div class="input-group">
                            <input type="color" name="hexCodePicker" id="hexCodePicker" class="form-control form-control-color" value="#FFFFFF" />
                            <input type="text" name="hexCode" id="hexCode" class="form-control"
                                   placeholder="#FFFFFF (optional)" pattern="^#[0-9A-Fa-f]{6}$" />
                        </div>
                        <small class="text-muted">Pick a color or enter hex code manually</small>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Color</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary ms-2"><i class="bi bi-x-circle"></i> Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('hexCodePicker').addEventListener('input', function() {
            document.getElementById('hexCode').value = this.value;
        });
        document.getElementById('hexCode').addEventListener('input', function() {
            if (/^#[0-9A-Fa-f]{6}$/.test(this.value)) {
                document.getElementById('hexCodePicker').value = this.value;
            }
        });
    </script>
}
