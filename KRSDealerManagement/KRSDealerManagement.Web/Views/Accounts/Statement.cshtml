@model IEnumerable<KRSDealerManagement.Application.DTOs.AccountTransactionDto>
@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Account Statement";
    var balance = ViewBag.Balance as AccountBalanceDto;
    var backUrl = ViewBag.StatementBackUrl as string ?? Url.Action("Index");
    var isReadOnly = ViewBag.IsReadOnlyStatement as bool? ?? false;
    var accountId = ViewBag.AccountId as int?;
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-file-text"></i> Account Statement</h1>
        @if (balance != null)
        {
            <p class="text-muted">@balance.SubdealerName — @balance.AccountName</p>
        }
    </div>
    <div class="col-md-6 text-end">
        @if (accountId.HasValue)
        {
            <partial name="_ExportExcel" view-data='new ViewDataDictionary(ViewData) { { "ExportAction", "ExportStatement" } }' />
        }
        <a href="@backUrl" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

@if (isReadOnly)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Read-only view for branch managers. Payment approvals are handled by finance.
    </div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" id="gridFilterForm">
            @if (accountId.HasValue)
            {
                <input type="hidden" name="id" value="@accountId" />
            }
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-0">From Date</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-0">To Date</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search"></i> Filter</button>
                    <a href="@Url.Action("Statement", new { id = accountId })" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-clockwise"></i></a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Balance Summary -->
@if (balance != null)
{
    @if (balance.ReservedAmount > 0)
    {
        <div class="alert alert-warning d-flex align-items-center mb-3">
            <i class="bi bi-lock-fill fs-4 me-3"></i>
            <div>
                <strong>₹@balance.ReservedAmount.ToString("N2") reserved</strong> for pending vehicle order(s).
                This amount is held until orders are approved or rejected; it is not available for new orders.
            </div>
        </div>
    }
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>₹@balance.CurrentBalance.ToString("N2")</h3>
                    <p>Current Balance</p>
                </div>
                <div class="icon"><i class="bi bi-wallet2"></i></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3>₹@balance.ReservedAmount.ToString("N2")</h3>
                    <p>Reserved (Orders)</p>
                </div>
                <div class="icon"><i class="bi bi-lock"></i></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="small-box bg-info">
                <div class="inner">
                    <h3>₹@balance.AvailableBalance.ToString("N2")</h3>
                    <p>Available Balance</p>
                </div>
                <div class="icon"><i class="bi bi-unlock"></i></div>
            </div>
        </div>
    </div>
}

<!-- Transaction History (like Excel ledger) -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-table"></i> Transaction History (@Model.Count())</h3>
    </div>
    <div class="card-body">
        <partial name="_AccountStatementLedger" model="Model" />
    </div>
</div>
