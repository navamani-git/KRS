@model KRSDealerManagement.Domain.Entities.PaymentType
@{
    ViewData["Title"] = "Edit Payment Type";
}

<div class="row mb-3">
    <div class="col-md-8"><h1 class="m-0">Edit Payment Type</h1></div>
    <div class="col-md-4 text-end"><a href="@Url.Action("Index")" class="btn btn-secondary">Back</a></div>
</div>

<div class="card" style="max-width:560px">
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.PaymentTypeId" />
        <div class="card-body">
            <div class="mb-3">
                <label class="fw-bold">Type Code <span class="text-danger">*</span></label>
                <input name="typeCode" class="form-control text-uppercase" style="text-transform:uppercase"
                       oninput="this.value=this.value.toUpperCase()" value="@Model.TypeCode" required />
                <small class="text-muted">Use <code>OTHERS</code> to show "specify type" field; <code>FINANCE</code> for finance details</small>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Type Name <span class="text-danger">*</span></label>
                <input name="typeName" class="form-control" value="@Model.TypeName" required />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Sort Order</label>
                <input name="sortOrder" type="number" min="0" class="form-control" value="@Model.SortOrder" />
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="requiresFinanceDetails" value="true"
                       id="requiresFinanceDetails" @(Model.RequiresFinanceDetails ? "checked" : "") />
                <label class="form-check-label" for="requiresFinanceDetails">Requires finance details</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="isActive">Active</label>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>
