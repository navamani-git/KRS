@{
    ViewData["Title"] = "Add Payment Type";
    ViewData["ExcelImportKey"] = KRSDealerManagement.Web.Helpers.ExcelImport.ExcelImportKeys.PaymentTypes;
    ViewData["ExcelImportReturnAction"] = "Create";
}

<div class="row mb-3">
    <div class="col-md-8"><h1 class="m-0">Add Payment Type</h1></div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>
    </div>
</div>

<partial name="_ExcelImport" />

<div class="card card-primary" style="max-width:560px">
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div class="mb-3">
                <label class="fw-bold">Type Code</label>
                <input name="typeCode" class="form-control text-uppercase" style="text-transform:uppercase"
                       oninput="this.value=this.value.toUpperCase()" placeholder="e.g. NEFT" />
                <small class="text-muted">Optional — auto-generated from name if left blank</small>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Type Name <span class="text-danger">*</span></label>
                <input name="typeName" class="form-control" required placeholder="e.g. NEFT" />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Sort Order</label>
                <input name="sortOrder" type="number" min="0" class="form-control" value="0" />
                <small class="text-muted">Lower numbers appear first in dropdowns</small>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="requiresFinanceDetails" value="true" id="requiresFinanceDetails" />
                <label class="form-check-label" for="requiresFinanceDetails">Requires finance details (customer, finance name, VIN)</label>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>
