@model KRSDealerManagement.Domain.Entities.GstRate
@{ ViewData["Title"] = "Edit GST Rate"; }

<div class="row mb-3">
    <div class="col-md-8"><h1 class="m-0">Edit GST %</h1></div>
    <div class="col-md-4 text-end"><a href="@Url.Action("Index")" class="btn btn-secondary">Back</a></div>
</div>

<div class="card" style="max-width:520px">
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.GstRateId" />
        <div class="card-body">
            <div class="mb-3">
                <label class="fw-bold">GST % <span class="text-danger">*</span></label>
                <input name="ratePercent" type="number" step="0.01" min="0.01" max="100" class="form-control" value="@Model.RatePercent" required />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Sort order</label>
                <input name="sortOrder" type="number" min="0" class="form-control" value="@Model.SortOrder" />
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="isActive">Active</label>
            </div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Save</button></div>
    </form>
</div>
