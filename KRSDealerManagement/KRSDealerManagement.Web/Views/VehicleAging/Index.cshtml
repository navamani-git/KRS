@model IEnumerable<KRSDealerManagement.Application.DTOs.VehicleAgingRowDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Shared.Helpers
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "Vehicle Ageing";
    var isSubdealerView = ViewBag.IsSubdealerView as bool? ?? false;
    var locations = ViewBag.DealershipLocations as IEnumerable<string> ?? Enumerable.Empty<string>();
    var subdealers = ViewBag.Subdealers as IEnumerable<UserDto> ?? Enumerable.Empty<UserDto>();
    var selectedLocation = ViewBag.SelectedDealershipLocation as string;
    string Days(int? value) => value.HasValue ? value.Value.ToString() : "—";
}

<div class="row mb-3">
    <div class="col-lg-8">
        <h1 class="m-0"><i class="bi bi-hourglass-split"></i> Vehicle Ageing</h1>
        <p class="text-muted mb-0">
            Allocated vehicles stay here until subsidy documents (Face, RC, Booth, Undertaking) are uploaded
            and staff/admin clicks <strong>All subsidy completed – Approve</strong> on Manage.
            Return requested / returned vehicles are excluded.
        </p>
        <details class="mt-2 small text-muted">
            <summary class="fw-semibold">How ageing is calculated (each column)</summary>
            <table class="table table-sm table-bordered mt-2 mb-0 bg-white">
                <thead><tr><th>Column</th><th>Starts after</th><th>Ends when</th><th>Done =</th><th>Pending =</th></tr></thead>
                <tbody>
                    <tr><td>Booked</td><td>Vehicle allocated</td><td>Customer booking submitted</td><td>0</td><td>Days since allocation</td></tr>
                    <tr><td>Paper Received</td><td>Booked</td><td>Paper received date saved</td><td>0</td><td>Days since booked</td></tr>
                    <tr><td>Invoice</td><td>Paper received</td><td>Invoice date saved</td><td>0</td><td>Days since paper received</td></tr>
                    <tr><td>Insurance</td><td>Invoice</td><td>Insurance date saved</td><td>0</td><td>Days since invoice</td></tr>
                    <tr><td>Agent</td><td>Insurance</td><td>Agent / RTO requested date saved</td><td>0</td><td>Days since insurance</td></tr>
                    <tr><td>Registration</td><td>Agent</td><td>Registration / RTO number date saved</td><td>0</td><td>Days since agent</td></tr>
                    <tr><td>Subsidy</td><td>Registration</td><td>Subsidy ID entered</td><td>0</td><td>Days since registration</td></tr>
                    <tr><td>Subsidy Documents</td><td>Subsidy ID entered</td><td>All subsidy docs approved on Manage</td><td>0</td><td>Days since subsidy ID</td></tr>
                </tbody>
            </table>
            <p class="mb-0 mt-2">— means that earlier step is not done yet, so this column does not apply. Only one column should show a positive number at a time (the current waiting step).</p>
        </details>
    </div>
    <div class="col-lg-4 text-lg-end mt-2 mt-lg-0">
        <partial name="_ExportExcel" />
        <div class="mt-2">
            <span class="badge bg-primary fs-6">On this page: @Model.Count() of @(ViewBag.TotalItems ?? Model.Count())</span>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end" id="gridFilterForm">
            @if (!isSubdealerView)
            {
                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-0">Location</label>
                    <select name="dealershipLocation" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">All locations</option>
                        @foreach (var loc in locations)
                        {
                            <option value="@loc" selected="@(string.Equals(selectedLocation, loc, StringComparison.OrdinalIgnoreCase))">@loc</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-0">Subdealer</label>
                    <select name="subdealerId" class="form-select form-select-sm">
                        <option value="">All subdealers</option>
                        @foreach (var s in subdealers)
                        {
                            <option value="@s.UserId" selected="@(ViewBag.SelectedSubdealerId?.ToString() == s.UserId.ToString())">@s.GetFullName()</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-4">
                <label class="form-label form-label-sm mb-0">Search</label>
                <input type="text" name="searchTerm" class="form-control form-control-sm"
                       placeholder="ID, chassis, model..." value="@ViewBag.SearchTerm" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0">Ageing list (@(ViewBag.TotalItems ?? Model.Count()))</h3>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <partial name="_GridScrollHint" />
            <div class="table-responsive">
                <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@GridIds.VehicleAging">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Chassis</th>
                            <th>Model</th>
                            <th>Color</th>
                            @if (!isSubdealerView)
                            {
                                <th>Subdealer</th>
                            }
                            <th>Booked Ageing</th>
                            <th>Paper Received Ageing</th>
                            <th>Invoice Ageing</th>
                            <th>Insurance Ageing</th>
                            <th>Agent Ageing</th>
                            <th>Registration Ageing</th>
                            <th>Subsidy Ageing</th>
                            <th>Subsidy Documents Ageing</th>
                        </tr>
                        <partial name="_PaginatedGridFilters" />
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.VehicleId</td>
                                <td class="text-nowrap">@r.ChassisNumber</td>
                                <td>@r.ModelName</td>
                                <td>@r.ColorName</td>
                                @if (!isSubdealerView)
                                {
                                    <td>@r.SubdealerName</td>
                                }
                                <td>@Days(r.BookedAging)</td>
                                <td>@Days(r.PaperReceivedAging)</td>
                                <td>@Days(r.InvoiceAging)</td>
                                <td>@Days(r.InsuranceAging)</td>
                                <td>@Days(r.AgentAging)</td>
                                <td>@Days(r.RegistrationAging)</td>
                                <td>@Days(r.SubsidyAging)</td>
                                <td>@Days(r.SubsidyDocumentsAging)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" />
        }
        else
        {
            <p class="text-muted p-3 mb-0">No vehicles on ageing.</p>
        }
    </div>
</div>
