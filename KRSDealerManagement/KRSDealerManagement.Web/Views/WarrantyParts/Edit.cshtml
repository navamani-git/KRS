@model KRSDealerManagement.Domain.Entities.WarrantyPartMaster
@{
    ViewData["Title"] = "Edit Warranty Part";
}

<h1 class="mb-3"><i class="bi bi-pencil"></i> Edit Warranty Part</h1>

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.WarrantyPartId" />
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Part Name *</label>
                <input name="partName" class="form-control" value="@Model.PartName" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Part Code</label>
                <input name="partCode" class="form-control" value="@Model.PartCode" />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActive" checked="@Model.IsActive" />
                <label class="form-check-label" for="isActive">Active</label>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="@Url.Action("Index")" class="btn btn-link">Cancel</a>
        </div>
    </div>
</form>
