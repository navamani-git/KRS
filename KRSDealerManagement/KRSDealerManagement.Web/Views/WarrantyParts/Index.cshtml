@model IEnumerable<KRSDealerManagement.Domain.Entities.WarrantyPartMaster>
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "Warranty Parts";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-tools"></i> Warranty Parts</h1>
        <p class="text-muted">Manage warranty part names for claim dropdowns</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add Part</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <partial name="_GridScrollHint" />
        <div class="table-responsive">
            <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@GridIds.WarrantyParts">
                <thead class="table-dark">
                    <tr>
                        <th class="grid-col-rownum">#</th>
                        <th>Part Name</th>
                        <th>Part Code</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                    <partial name="_PaginatedGridFilters" />
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@(i++)</td>
                            <td><strong>@p.PartName</strong></td>
                            <td>@p.PartCode</td>
                            <td>@(p.IsActive ? "Active" : "Inactive")</td>
                            <td class="text-end"><a href="@Url.Action("Edit", new { id = p.WarrantyPartId })" class="btn btn-sm btn-outline-primary">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="p-3"><partial name="_Pagination" /></div>
    </div>
</div>
