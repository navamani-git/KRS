@model KRSDealerManagement.Application.Queries.DashboardSummary
@using KRSDealerManagement.Shared.Constants
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = ViewBag.IsAdmin ?? false;
    var isSubdealer = ViewBag.IsSubdealer ?? false;
    var isBranchManager = ViewBag.IsBranchManager ?? false;
    var fullName = ViewBag.FullName ?? "User";
    var dealershipName = ViewBag.DealershipName as string;
    var canViewOrders = ViewBag.CanViewPendingOrders ?? isSubdealer;
    var canViewReturns = ViewBag.CanViewPendingReturns ?? isSubdealer;
    var canViewPayments = ViewBag.CanViewPendingPayments ?? isSubdealer;
    var canViewCommissions = ViewBag.CanViewPendingCommissions ?? isSubdealer;
    var canViewBookings = ViewBag.CanViewBookings ?? false;
    var showBookingCounts = canViewBookings && (isAdmin || isBranchManager);

    var pendingOrdersUrl = isSubdealer
        ? Url.Action("MyOrders", "Orders", new { status = UnifiedVehicleStatus.Submitted })
        : Url.Action("Index", "Orders", new { status = UnifiedVehicleStatus.Submitted });
    var pendingReturnsUrl = isSubdealer
        ? Url.Action("MyReturns", "Returns", new { status = UnifiedVehicleStatus.ReturnRequested })
        : Url.Action("Index", "Returns", new { status = UnifiedVehicleStatus.ReturnRequested });
    var pendingPaymentsUrl = isSubdealer
        ? Url.Action("MyPayments", "Payments", new { status = 0 })
        : Url.Action("Index", "Payments", new { status = 0 });
    var pendingCommissionsUrl = isSubdealer
        ? Url.Action("MyCommissions", "Commissions")
        : Url.Action("Approvals", "Commissions", new { status = 0 });

    string BookingUrl(int status) => Url.Action("Index", "VehicleBookings", new { status })!;
    var bookedToCustomerUrl = Url.Action("BookedToCustomer", "VehicleBookings")!;
}

<!-- Page Header -->
<div class="row mb-3">
    <div class="col-12">
        <h1 class="m-0">
            <i class="bi bi-speedometer2"></i> Dashboard
        </h1>
        <p class="text-muted">
            Welcome back, <strong>@fullName</strong>!
            @if (!string.IsNullOrWhiteSpace(dealershipName))
            {
                <span class="badge bg-secondary ms-1">@dealershipName</span>
            }
        </p>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row">
    @if (isAdmin)
    {
        <!-- Admin Dashboard Cards -->
        <div class="col-lg-3 col-6">
            <div class="small-box bg-info">
                <div class="inner">
                    <h3>@Model.TotalSubdealers</h3>
                    <p>Total Subdealers</p>
                </div>
                <div class="icon">
                    <i class="bi bi-people"></i>
                </div>
                <a href="@Url.Action("Index", "Subdealers")" class="small-box-footer">
                    More info <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-3 col-6">
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>@Model.TotalAccounts</h3>
                    <p>Total Accounts</p>
                </div>
                <div class="icon">
                    <i class="bi bi-person-badge"></i>
                </div>
                <a href="@Url.Action("Index", "Accounts")" class="small-box-footer">
                    More info <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-3 col-6">
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3>₹@Model.TotalBalance.ToString("N2")</h3>
                    <p>Total Balance</p>
                </div>
                <div class="icon">
                    <i class="bi bi-currency-rupee"></i>
                </div>
                <a href="@Url.Action("Index", "Accounts")" class="small-box-footer">
                    More info <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-3 col-6">
            <div class="small-box bg-danger">
                <div class="inner">
                    <h3>₹@Model.TotalReservedAmount.ToString("N2")</h3>
                    <p>Reserved Amount</p>
                </div>
                <div class="icon">
                    <i class="bi bi-lock"></i>
                </div>
                <a href="@Url.Action("Index", "Orders")" class="small-box-footer">
                    More info <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>
    }
    else if (isSubdealer)
    {
        <!-- Subdealer Dashboard Cards -->
        <div class="col-lg-4 col-6">
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>₹@Model.TotalBalance.ToString("N2")</h3>
                    <p>Current Balance</p>
                </div>
                <div class="icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <a href="@Url.Action("Statement", "Account")" class="small-box-footer">
                    View Statement <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-6">
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3>₹@Model.TotalReservedAmount.ToString("N2")</h3>
                    <p>Reserved Amount</p>
                </div>
                <div class="icon">
                    <i class="bi bi-lock"></i>
                </div>
                <a href="@Url.Action("MyOrders", "Orders")" class="small-box-footer">
                    View Orders <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-4 col-6">
            <div class="small-box bg-info">
                <div class="inner">
                    <h3>₹@((Model.TotalBalance - Model.TotalReservedAmount).ToString("N2"))</h3>
                    <p>Available Balance</p>
                </div>
                <div class="icon">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <a href="@Url.Action("Create", "Orders")" class="small-box-footer">
                    Create Order <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>
    }
</div>

@if (showBookingCounts)
{
    <div class="row mb-2">
        <div class="col-12">
            <h5 class="text-muted mb-2"><i class="bi bi-truck-front"></i> Manage Vehicles</h5>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-3 col-6">
            <a href="@bookedToCustomerUrl" class="text-decoration-none text-dark d-block dashboard-pending-link">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-primary"><i class="bi bi-person-check"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Booked to Customer</span>
                        <span class="info-box-number">@Model.BookedToCustomerCount</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-6">
            <a href="@BookingUrl(UnifiedVehicleStatus.PaperReceived)" class="text-decoration-none text-dark d-block dashboard-pending-link">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-secondary"><i class="bi bi-file-earmark-text"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Paper Received</span>
                        <span class="info-box-number">@Model.PaperReceivedCount</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-6">
            <a href="@BookingUrl(UnifiedVehicleStatus.Invoiced)" class="text-decoration-none text-dark d-block dashboard-pending-link">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-info"><i class="bi bi-receipt"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Invoiced</span>
                        <span class="info-box-number">@Model.InvoicedCount</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-6">
            <a href="@BookingUrl(UnifiedVehicleStatus.InsuranceCreated)" class="text-decoration-none text-dark d-block dashboard-pending-link">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-success"><i class="bi bi-shield-check"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Insurance Created</span>
                        <span class="info-box-number">@Model.InsuranceCreatedCount</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-6">
            <a href="@BookingUrl(UnifiedVehicleStatus.RtoRequested)" class="text-decoration-none text-dark d-block dashboard-pending-link">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-warning"><i class="bi bi-signpost"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">RTO Requested</span>
                        <span class="info-box-number">@Model.RtoRequestedCount</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-6">
            <a href="@BookingUrl(UnifiedVehicleStatus.Registered)" class="text-decoration-none text-dark d-block dashboard-pending-link">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-dark"><i class="bi bi-card-checklist"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Registered</span>
                        <span class="info-box-number">@Model.RegisteredCount</span>
                    </div>
                </div>
            </a>
        </div>
    </div>
}

<!-- Pending Items Row -->
<style>
    .dashboard-pending-link .info-box {
        transition: box-shadow 0.15s ease, transform 0.15s ease;
        cursor: pointer;
    }
    .dashboard-pending-link:hover .info-box {
        box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.12);
        transform: translateY(-1px);
    }
</style>
<div class="row">
    @if (canViewOrders)
    {
    <div class="col-lg-3 col-6">
        <a href="@pendingOrdersUrl" class="text-decoration-none text-dark d-block dashboard-pending-link">
            <div class="info-box mb-0">
                <span class="info-box-icon bg-warning"><i class="bi bi-cart-check"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Pending Orders</span>
                    <span class="info-box-number">@Model.PendingPurchaseOrders</span>
                </div>
            </div>
        </a>
    </div>
    }

    @if (canViewReturns)
    {
    <div class="col-lg-3 col-6">
        <a href="@pendingReturnsUrl" class="text-decoration-none text-dark d-block dashboard-pending-link">
            <div class="info-box mb-0">
                <span class="info-box-icon bg-danger"><i class="bi bi-arrow-return-left"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Pending Returns</span>
                    <span class="info-box-number">@Model.PendingReturnRequests</span>
                </div>
            </div>
        </a>
    </div>
    }

    @if (canViewPayments)
    {
    <div class="col-lg-3 col-6">
        <a href="@pendingPaymentsUrl" class="text-decoration-none text-dark d-block dashboard-pending-link">
            <div class="info-box mb-0">
                <span class="info-box-icon bg-success"><i class="bi bi-credit-card"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Pending Payments</span>
                    <span class="info-box-number">@Model.PendingPayments</span>
                </div>
            </div>
        </a>
    </div>
    }

    @if (canViewCommissions)
    {
    <div class="col-lg-3 col-6">
        <a href="@pendingCommissionsUrl" class="text-decoration-none text-dark d-block dashboard-pending-link">
            <div class="info-box mb-0">
                <span class="info-box-icon bg-info"><i class="bi bi-cash-stack"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Pending Commissions</span>
                    <span class="info-box-number">@Model.PendingCommissions</span>
                </div>
            </div>
        </a>
    </div>
    }
</div>

@if (isAdmin)
{
    <!-- Recent Activities (System Admin only) -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-clock-history"></i> Recent Activities
                    </h3>
                </div>
                <div class="card-body">
                    @if (Model.RecentActivities.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Description</th>
                                        <th>User</th>
                                        <th>Date/Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var activity in Model.RecentActivities)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary">@activity.ActivityType</span>
                                            </td>
                                            <td>@activity.Description</td>
                                            <td>@activity.UserName</td>
                                            <td>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar"></i> @activity.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")
                                                </small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> No recent activities to display.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Quick Actions -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-lightning"></i> Quick Actions
                </h3>
            </div>
            <div class="card-body">
                <div class="row">
                    @if (isAdmin)
                    {
                        <div class="col-md-3 col-6 mb-3">
                            <a href="@Url.Action("Create", "VehicleModels")" class="btn btn-primary btn-block">
                                <i class="bi bi-car-front"></i> Add Vehicle Model
                            </a>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <a href="@Url.Action("Create", "Subdealers")" class="btn btn-success btn-block">
                                <i class="bi bi-person-plus"></i> Add Subdealer
                            </a>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <a href="@Url.Action("Index", "Orders")" class="btn btn-warning btn-block">
                                <i class="bi bi-cart-check"></i> Manage Orders
                            </a>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <a href="@Url.Action("Index", "Reports")" class="btn btn-info btn-block">
                                <i class="bi bi-graph-up"></i> View Reports
                            </a>
                        </div>
                    }
                    else if (isSubdealer)
                    {
                        <div class="col-md-4 col-6 mb-3">
                            <a href="@Url.Action("Index", "Vehicles")" class="btn btn-info btn-block">
                                <i class="bi bi-ev-front"></i> My Vehicles
                            </a>
                        </div>
                        <div class="col-md-4 col-6 mb-3">
                            <a href="@Url.Action("Create", "Orders")" class="btn btn-primary btn-block">
                                <i class="bi bi-cart-plus"></i> Create Order
                            </a>
                        </div>
                        <div class="col-md-4 col-6 mb-3">
                            <a href="@Url.Action("Submit", "Commissions")" class="btn btn-success btn-block">
                                <i class="bi bi-cash-stack"></i> Submit Commission
                            </a>
                        </div>
                        <div class="col-md-4 col-6 mb-3">
                            <a href="@Url.Action("Statement", "Account")" class="btn btn-outline-info btn-block">
                                <i class="bi bi-file-text"></i> View Statement
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
