@model IEnumerable<KRSDealerManagement.Application.DTOs.AccountTransactionDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "Account Statement";
    var balance = ViewBag.Balance as AccountBalanceDto;
    var accountId = ViewBag.AccountId as int?;
    var totalItems = (int)(ViewBag.TotalItems ?? Model.Count());
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-file-text"></i> Account Statement</h1>
        @if (balance != null)
        {
            <p class="text-muted">Your balance & transaction history</p>
        }
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" view-data='new ViewDataDictionary(ViewData) { { "ExportAction", "ExportStatement" } }' />
        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<!-- Date Filter -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" id="gridFilterForm">
            @if (accountId.HasValue)
            {
                <input type="hidden" name="accountId" value="@accountId" />
            }
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-0">From Date</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm mb-0">To Date</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search"></i> Filter</button>
                    <a href="@Url.Action("Statement", "Account")" class="btn btn-sm btn-secondary" title="Reset filters"><i class="bi bi-arrow-clockwise"></i></a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Balance Summary -->
@if (balance != null)
{
    @if (balance.ReservedAmount > 0)
    {
        <div class="alert alert-warning d-flex align-items-center mb-3">
            <i class="bi bi-lock-fill fs-4 me-3"></i>
            <div>
                <strong>₹@balance.ReservedAmount.ToString("N2") reserved</strong> for pending vehicle order(s).
                This amount is held until orders are approved or rejected; it is not available for new orders.
            </div>
        </div>
    }
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="info-box bg-success">
                <span class="info-box-icon"><i class="bi bi-wallet2"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text text-white">Current Balance</span>
                    <span class="info-box-number text-white">₹@balance.CurrentBalance.ToString("N2")</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-box bg-warning">
                <span class="info-box-icon"><i class="bi bi-lock"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text text-white">Reserved (Orders)</span>
                    <span class="info-box-number text-white">₹@balance.ReservedAmount.ToString("N2")</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-box bg-info">
                <span class="info-box-icon"><i class="bi bi-unlock"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text text-white">Available</span>
                    <span class="info-box-number text-white">₹@balance.AvailableBalance.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
}

<!-- Statement Table (Excel-style ledger) -->
<div class="card">
    <div class="card-header d-flex justify-content-between">
        <h3 class="card-title mb-0"><i class="bi bi-table"></i> Transactions (@totalItems)</h3>
    </div>
    <div class="card-body p-0">
        <partial name="_AccountStatementLedger" model="Model" />
    </div>
</div>
