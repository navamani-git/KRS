@{
    ViewData["Title"] = "Reports";
    var isAdmin = Context.Session.GetInt32("UserRole") == 1;
}

<div class="row mb-3">
    <div class="col-12">
        <h1 class="m-0"><i class="bi bi-graph-up"></i> Reports</h1>
    </div>
</div>

<div class="row">
    @if (isAdmin)
    {
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-people fs-1 text-info"></i>
                    <h5 class="mt-2">Subdealer Summary</h5>
                    <a href="@Url.Action("Index", "Accounts")" class="btn btn-info btn-sm">View</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-cart-check fs-1 text-warning"></i>
                    <h5 class="mt-2">Order History</h5>
                    <a href="@Url.Action("Index", "Orders")" class="btn btn-warning btn-sm">View</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-cash-stack fs-1 text-success"></i>
                    <h5 class="mt-2">Commission Report</h5>
                    <a href="@Url.Action("Index", "Commissions")" class="btn btn-success btn-sm">View</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-credit-card fs-1 text-primary"></i>
                    <h5 class="mt-2">Payment Report</h5>
                    <a href="@Url.Action("Index", "Payments")" class="btn btn-primary btn-sm">View</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-file-text fs-1 text-info"></i>
                    <h5 class="mt-2">Account Statement</h5>
                    <a href="@Url.Action("AccountStatement")" class="btn btn-info btn-sm">View</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-list-check fs-1 text-warning"></i>
                    <h5 class="mt-2">My Orders</h5>
                    <a href="@Url.Action("MyOrders", "Orders")" class="btn btn-warning btn-sm">View</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-wallet2 fs-1 text-success"></i>
                    <h5 class="mt-2">My Payments</h5>
                    <a href="@Url.Action("MyPayments", "Payments")" class="btn btn-success btn-sm">View</a>
                </div>
            </div>
        </div>
    }
</div>
