@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Add Commission Rate";
    var models = ViewBag.Models as IEnumerable<VehicleModelDto>;
    var currentMonth = (int)(ViewBag.CurrentMonth ?? DateTime.Now.Month);
    var currentYear = (int)(ViewBag.CurrentYear ?? DateTime.Now.Year);
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-plus-circle"></i> Add Commission Rate</h1>
        <p class="text-muted">Set commission amount for a vehicle model</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card card-primary">
            <div class="card-header"><h3 class="card-title">Commission Rate Entry</h3></div>
            <form method="post" asp-action="CreateRate">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Vehicle Model <span class="text-danger">*</span></label>
                        <select name="modelId" class="form-select" required>
                            <option value="">-- Select Model --</option>
                            @if (models != null)
                            {
                                @foreach (var m in models)
                                {
                                    <option value="@m.ModelId">@m.ModelName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Commission Amount (₹) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" name="commissionAmount" class="form-control"
                                   placeholder="e.g., 5000" min="1" step="0.01" required />
                        </div>
                    </div>

                    <hr />
                    <h6 class="fw-bold">Effective Period</h6>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Start Month <span class="text-danger">*</span></label>
                                <select name="startMonth" class="form-select" required>
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m" selected="@(m == currentMonth)">
                                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Start Year <span class="text-danger">*</span></label>
                                <select name="startYear" class="form-select" required>
                                    @for (int y = currentYear - 1; y <= currentYear + 3; y++)
                                    {
                                        <option value="@y" selected="@(y == currentYear)">@y</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Expiry Month <small class="text-muted">(optional)</small></label>
                                <select name="expiryMonth" class="form-select">
                                    <option value="0">-- No Expiry (Ongoing) --</option>
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m">
                                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Expiry Year <small class="text-muted">(optional)</small></label>
                                <select name="expiryYear" class="form-select">
                                    <option value="0">-- No Expiry --</option>
                                    @for (int y = currentYear; y <= currentYear + 5; y++)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Notes</label>
                        <input type="text" name="notes" class="form-control"
                               placeholder="Optional: reason for this rate" />
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Rate</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card card-info">
            <div class="card-header"><h3 class="card-title"><i class="bi bi-info-circle"></i> How Commission Works</h3></div>
            <div class="card-body">
                <ul>
                    <li>Commission rate is set per <strong>vehicle model per month</strong></li>
                    <li>Subdealers submit commission for each vehicle sold</li>
                    <li>The system auto-fills commission amount when subdealer selects model + month</li>
                    <li>Rates can vary monthly — set a new rate for each month as needed</li>
                    <li>Leave expiry blank for <strong>ongoing rates</strong></li>
                </ul>
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-triangle"></i>
                    If multiple active rates exist for the same model and month, the most recent one is used.
                </div>
            </div>
        </div>
    </div>
</div>
