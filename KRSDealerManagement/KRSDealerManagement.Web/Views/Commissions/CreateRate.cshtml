@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Add Commission Rate";
    var models = ViewBag.Models as IEnumerable<VehicleModelDto>;
    var effectiveFrom = ViewBag.EffectiveFrom as string ?? DateTime.Now.ToString("yyyy-MM-dd");
    var effectiveTo = ViewBag.EffectiveTo as string ?? DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-plus-circle"></i> Add Commission Rate</h1>
        <p class="text-muted">Set commission for a vehicle model for a specific date range</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card card-primary">
            <div class="card-header"><h3 class="card-title">Commission Rate Entry</h3></div>
            <form method="post" asp-action="CreateRate">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Vehicle Model <span class="text-danger">*</span></label>
                        <select name="modelId" class="form-select" required>
                            <option value="">-- Select Model --</option>
                            @if (models != null)
                            {
                                @foreach (var m in models)
                                {
                                    <option value="@m.ModelId">@m.ModelName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Commission Amount (₹) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" name="commissionAmount" class="form-control"
                                   placeholder="e.g., 5000" min="1" step="0.01" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Effective From <span class="text-danger">*</span></label>
                                <input type="date" name="effectiveFrom" class="form-control"
                                       value="@effectiveFrom" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Effective To <span class="text-danger">*</span></label>
                                <input type="date" name="effectiveTo" class="form-control"
                                       value="@effectiveTo" required />
                            </div>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">
                        Defaults to the first and last day of the current month. Adjust as needed (e.g. 01–15 and 15–30 for split periods).
                    </p>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Notes</label>
                        <input type="text" name="notes" class="form-control"
                               placeholder="Optional: reason for this rate" />
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Rate</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card card-info">
            <div class="card-header"><h3 class="card-title"><i class="bi bi-info-circle"></i> Rules</h3></div>
            <div class="card-body">
                <ul class="mb-0">
                    <li>One rate per <strong>model</strong> for each date range</li>
                    <li>Same model, same month — use separate ranges (e.g. 01–15 and 15–30)</li>
                    <li><strong>Overlapping</strong> ranges are rejected (13–31 cannot overlap 01–15)</li>
                    <li><strong>Adjacent</strong> ranges are OK (01–15 then 15–30)</li>
                    <li>Subdealer commission uses the rate matching the vehicle <strong>invoice date</strong></li>
                </ul>
            </div>
        </div>
    </div>
</div>
