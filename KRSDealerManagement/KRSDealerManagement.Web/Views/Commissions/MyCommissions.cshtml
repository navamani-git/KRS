@model IEnumerable<KRSDealerManagement.Application.DTOs.CommissionDto>
@{
    ViewData["Title"] = "My Commissions";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-cash-stack"></i> My Commissions</h1>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Submit")" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Submit New Commission
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Commission History (@Model.Count())</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Month/Year</th>
                            <th>Chassis No.</th>
                            <th class="text-end">Amount (₹)</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Approved</th>
                            <th>Rejected</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sr = 1; }
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>@(sr++)</td>
                                <td>
                                    <span class="badge bg-info">
                                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(c.Month) @c.Year
                                    </span>
                                </td>
                                <td><code>@c.VehicleChassisNumber</code></td>
                                <td class="text-end fw-bold">₹@c.CommissionAmount.ToString("N2")</td>
                                <td>
                                    @{
                                        var badgeClass = c.GetBadgeClass();
                                    }
                                    <span class="badge @badgeClass">@c.GetStatusDisplay()</span>
                                </td>
                                <td><small>@c.CreatedDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                <td>
                                    @if (c.ApprovedDate.HasValue)
                                    {
                                        <small>@c.ApprovedDate.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (c.RejectedDate.HasValue)
                                    {
                                        <small>@c.RejectedDate.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><small class="text-muted">@c.Notes</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No commissions submitted yet.
                <a href="@Url.Action("Submit")">Submit your first commission.</a>
            </div>
        }
    </div>
</div>
