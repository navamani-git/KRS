@using KRSDealerManagement.Application.DTOs
@model IEnumerable<CommissionPreviewRowDto>
@{
    ViewData["Title"] = "Submit Commission";
    var pending = ViewBag.Pending as IEnumerable<CommissionPreviewRowDto> ?? Model ?? Enumerable.Empty<CommissionPreviewRowDto>();
    var rates = ViewBag.CommissionRates as IEnumerable<CommissionRateDto> ?? Enumerable.Empty<CommissionRateDto>();
    var ratePeriod = ViewBag.RatePeriodLabel as string ?? DateTime.Now.ToString("MMMM yyyy");
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-cash-stack"></i> Submit Commission</h1>
        <p class="text-muted">Submit commission after invoice and RTO registration are recorded by the dealer</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("InvoicedVehicles")" class="btn btn-outline-info">
            <i class="bi bi-table"></i> Invoiced Vehicles
        </a>
        <a href="@Url.Action("MyCommissions")" class="btn btn-secondary">
            <i class="bi bi-list"></i> My Commissions
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-cash-coin"></i> Commission Rates — @ratePeriod (view only)</h3>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Model</th>
                                <th class="text-end">Commission (₹)</th>
                                <th>Effective From</th>
                                <th>Effective To</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (rates.Any())
                            {
                                @foreach (var r in rates.OrderBy(r => r.ModelName).ThenBy(r => r.EffectiveFrom))
                                {
                                    <tr>
                                        <td>@r.ModelName</td>
                                        <td class="text-end fw-bold text-success">₹@r.CommissionAmount.ToString("N2")</td>
                                        <td><small>@r.EffectiveFrom.ToString("yyyy-MM-dd")</small></td>
                                        <td><small>@r.EffectiveTo.ToString("yyyy-MM-dd")</small></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-muted text-center">No commission rates configured for @ratePeriod.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card card-success">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-send"></i> Pending Submission (@pending.Count())</h3>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Model</th>
                                <th>Color</th>
                                <th>Chassis</th>
                                <th>Invoice Date</th>
                                <th>RTO Registration</th>
                                <th class="text-end">Commission (₹)</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (pending.Any())
                            {
                                @foreach (var row in pending)
                                {
                                    <tr>
                                        <td>@row.ModelName</td>
                                        <td>@row.ColorName</td>
                                        <td><code>@row.ChassisNumber</code></td>
                                        <td>@row.InvoiceDate.ToString("yyyy-MM-dd")</td>
                                        <td>@(row.RegistrationDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                        <td class="text-end fw-bold text-success">
                                            @(row.ApplicableRate.HasValue ? $"₹{row.ApplicableRate.Value:N2}" : "—")
                                        </td>
                                        <td class="text-center">
                                            @if (row.CanSubmit)
                                            {
                                                <form method="post" asp-action="SubmitRow" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="vehicleId" value="@row.VehicleId" />
                                                    <button type="submit" class="btn btn-sm btn-success"
                                                            onclick="return confirm('Submit commission of ₹@(row.ApplicableRate?.ToString("N2")) for chassis @row.ChassisNumber?');">
                                                        <i class="bi bi-send"></i> Submit
                                                    </button>
                                                </form>
                                            }
                                            else if (!row.ApplicableRate.HasValue || row.ApplicableRate.Value <= 0)
                                            {
                                                <span class="badge bg-warning text-dark">No rate</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@row.CommissionStatus</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-muted text-center">
                                        All invoiced vehicles have been submitted. Check <a href="@Url.Action("MyCommissions")">My Commissions</a> for status.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
