@model IEnumerable<KRSDealerManagement.Application.DTOs.CommissionRateDto>
@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Commission Rates";
    var models = ViewBag.Models as IEnumerable<VehicleModelDto>;
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-cash-coin"></i> Commission Rates</h1>
        <p class="text-muted">Set commission amounts per vehicle model per month</p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
        <a href="@Url.Action("CreateRate")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Commission Rate
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get">
            <div class="row">
                <div class="col-md-4">
                    <select name="modelId" class="form-select">
                        <option value="">All Models</option>
                        @if (models != null)
                        {
                            @foreach (var m in models)
                            {
                                <option value="@m.ModelId"
                                        selected="@(ViewBag.SelectedModelId?.ToString() == m.ModelId.ToString())">
                                    @m.ModelName
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="activeOnly"
                               value="true" @(ViewBag.ActiveOnly == true ? "checked" : "") />
                        <label class="form-check-label">Active Rates Only</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-filter"></i> Filter</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="bi bi-arrow-clockwise"></i> Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Commission Rates Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-list"></i> Commission Rates (@Model.Count())</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Vehicle Model</th>
                            <th class="text-end">Commission (₹)</th>
                            <th>Effective From</th>
                            <th>Expires</th>
                            <th>Status</th>
                            <th>Notes</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rate in Model)
                        {
                            var isActive = rate.IsActive();
                            <tr class="@(isActive ? "" : "table-secondary")">
                                <td><strong>@rate.ModelName</strong></td>
                                <td class="text-end">
                                    <strong class="text-success">₹@rate.CommissionAmount.ToString("N2")</strong>
                                </td>
                                <td>
                                    <span class="badge bg-info">
                                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(rate.StartMonth) @rate.StartYear
                                    </span>
                                </td>
                                <td>
                                    @if (rate.ExpiryYear.HasValue && rate.ExpiryMonth.HasValue)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(rate.ExpiryMonth.Value) @rate.ExpiryYear
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Ongoing</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(isActive ? "bg-success" : "bg-secondary")">
                                        @(isActive ? "Active" : "Expired")
                                    </span>
                                </td>
                                <td><small class="text-muted">@(rate.Notes ?? "-")</small></td>
                                <td><small class="text-muted">@rate.CreatedDate.ToString("yyyy-MM-dd")</small></td>
                                <td>
                                    @{
                                        ViewData["CrudId"] = rate.CommissionRateId;
                                        ViewData["CrudController"] = "Commissions";
                                        ViewData["CrudEditAction"] = "EditRate";
                                        ViewData["CrudDeleteAction"] = "DeleteRate";
                                    }
                                    <partial name="_CrudActions" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No commission rates found.
                <a href="@Url.Action("CreateRate")">Add the first rate.</a>
            </div>
        }
        <partial name="_Pagination" />
    </div>
</div>
