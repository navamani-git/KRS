@model IEnumerable<KRSDealerManagement.Application.DTOs.CommissionDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Domain.Entities
@using KRSDealerManagement.Web.Helpers
@{
    ViewData["Title"] = "Commission Approvals";
    ViewData["ExportAction"] = "ExportApprovals";
    var subdealers = ViewBag.Subdealers as IEnumerable<UserDto>;
    var statuses = ViewBag.Statuses as IEnumerable<StatusLookup> ?? Enumerable.Empty<StatusLookup>();
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-check2-square"></i> Commission Approvals</h1>
        <p class="text-muted">Review subdealer commission submissions and credit approved amounts to accounts</p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-cash-coin"></i> Commission Rates
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">From</label>
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">To</label>
                <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Subdealer</label>
                <select name="subdealerId" class="form-select form-select-sm">
                    <option value="">All Subdealers</option>
                    @if (subdealers != null)
                    {
                        @foreach (var s in subdealers)
                        {
                            <option value="@s.UserId" selected="@(ViewBag.SelectedSubdealerId?.ToString() == s.UserId.ToString())">
                                @s.GetFullName()
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">Status</label>
                <select name="status" class="form-select form-select-sm" asp-items="StatusViewHelper.ToSelectList(statuses, ViewBag.SelectedStatus as int?)">
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter"></i> Filter</button>
                <a href="@Url.Action("Approvals")" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Commissions Awaiting Approval (@(ViewBag.TotalItems ?? Model.Count()))
            <span class="badge bg-warning text-dark ms-2">@(ViewBag.PendingCount ?? 0) Awaiting</span>
        </h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Subdealer</th>
                            <th>Chassis</th>
                            <th>Period</th>
                            <th class="text-end">Amount (₹)</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Approved</th>
                            <th>Rejected</th>
                            <th>Remarks</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr class="@(c.CanBeApproved() ? "table-warning bg-opacity-25" : "")">
                                <td>@c.CommissionId</td>
                                <td><strong>@c.SubdealerName</strong></td>
                                <td><code class="small">@c.VehicleChassisNumber</code></td>
                                <td>
                                    <span class="badge bg-info">
                                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(c.Month) @c.Year
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-success">₹@c.CommissionAmount.ToString("N2")</td>
                                <td><span class="badge @c.GetBadgeClass()">@c.GetStatusDisplay()</span></td>
                                <td><small>@c.CreatedDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                <td>
                                    @if (c.ApprovedDate.HasValue)
                                    {
                                        <small>@c.ApprovedDate.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (c.RejectedDate.HasValue)
                                    {
                                        <small>@c.RejectedDate.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><small class="text-muted">@(c.Notes ?? "-")</small></td>
                                <td>
                                    @if (c.CanBeApproved())
                                    {
                                        <button type="button" class="btn btn-sm btn-success"
                                                onclick="showApprove(@c.CommissionId, @c.CommissionAmount)">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger"
                                                onclick="showReject(@c.CommissionId)">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <small class="text-muted">—</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No commission submissions found.
            </div>
        }
        <partial name="_Pagination" />
    </div>
</div>

<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Approve Commission</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="Approve">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="id" id="approveId" />
                    <p>Approve commission of <strong id="approveAmtDisplay">₹0</strong> and credit to subdealer account.</p>
                    <div class="form-group mb-3">
                        <label class="fw-bold">Remarks</label>
                        <textarea name="remarks" class="form-control" rows="2" placeholder="Optional approval note"></textarea>
                    </div>
                    <div class="alert alert-success mb-0">
                        <i class="bi bi-info-circle"></i>
                        Amount will be credited to the subdealer balance and recorded in account transactions.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Approve &amp; Credit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Reject Commission</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="Reject">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="id" id="rejectId" />
                    <div class="form-group">
                        <label class="fw-bold">Rejection Reason <span class="text-danger">*</span></label>
                        <textarea name="remarks" class="form-control" rows="2" required
                                  placeholder="Enter reason for rejection..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showApprove(id, amount) {
            document.getElementById('approveId').value = id;
            document.getElementById('approveAmtDisplay').textContent =
                `₹${parseFloat(amount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
            new bootstrap.Modal(document.getElementById('approveModal')).show();
        }
        function showReject(id) {
            document.getElementById('rejectId').value = id;
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }
    </script>
}
