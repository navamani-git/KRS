@model KRSDealerManagement.Domain.Entities.CommissionRate
@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Edit Commission Rate";
    var models = ViewBag.Models as IEnumerable<VehicleModelDto> ?? Enumerable.Empty<VehicleModelDto>();
    var modelName = models.FirstOrDefault(m => m.ModelId == Model.ModelId)?.ModelName ?? $"Model #{Model.ModelId}";
}

<div class="row mb-3">
    <div class="col-md-8"><h1 class="m-0">Edit Commission Rate</h1></div>
    <div class="col-md-4 text-end"><a href="@Url.Action("Index")" class="btn btn-secondary">Back</a></div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.CommissionRateId" />
        <div class="card-body">
            <p class="mb-3"><strong>@modelName</strong></p>

            <div class="mb-3">
                <label class="fw-bold">Commission Amount (₹) <span class="text-danger">*</span></label>
                <input type="number" name="commissionAmount" class="form-control" step="0.01" min="0.01" value="@Model.CommissionAmount" required />
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="fw-bold">Effective From <span class="text-danger">*</span></label>
                    <input type="date" name="effectiveFrom" class="form-control"
                           value="@Model.EffectiveFrom.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-6">
                    <label class="fw-bold">Effective To <span class="text-danger">*</span></label>
                    <input type="date" name="effectiveTo" class="form-control"
                           value="@Model.EffectiveTo.ToString("yyyy-MM-dd")" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Notes</label>
                <textarea name="notes" class="form-control" rows="2">@Model.Notes</textarea>
            </div>

            <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle"></i>
                Only one rate period can cover the same model on the same day. If a rate runs until 21-Aug, the next period must start on <strong>22-Aug</strong> or later.
                Overlapping dates (e.g. 01–21 then 16–22) are not allowed — edit the existing row first.
            </div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Save</button></div>
    </form>
</div>
