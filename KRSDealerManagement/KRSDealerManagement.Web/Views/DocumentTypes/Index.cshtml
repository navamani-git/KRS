@model IEnumerable<KRSDealerManagement.Domain.Entities.DocumentTypeMaster>
@{
    ViewData["Title"] = "Document Types";
}

<div class="row mb-3">
    <div class="col-md-6"><h1 class="m-0"><i class="bi bi-card-text"></i> Document Types</h1></div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="table-dark">
                <tr><th>#</th><th>Type</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@d.TypeName</td>
                        <td><span class="badge @(d.IsActive ? "bg-success" : "bg-secondary")">@(d.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            @{ ViewData["CrudId"] = d.DocumentTypeId; ViewData["CrudController"] = "DocumentTypes"; }
                            <partial name="_CrudActions" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="p-3"><partial name="_Pagination" /></div>
    </div>
</div>
