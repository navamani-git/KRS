@model KRSDealerManagement.Web.Controllers.StaffRoleFormModel
@using KRSDealerManagement.Shared.Constants
@{
    ViewData["Title"] = "Configure Role";
    ViewData["RoleForm"] = Model;
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-shield-lock"></i> @Model.RoleName</h1>
        <p class="text-muted mb-0"><code>@Model.RoleCode</code> · @(Model.RoleTemplateCode ?? "Custom")</p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="RoleCode" value="@Model.RoleCode" />
    <input type="hidden" name="RoleTemplateCode" value="@Model.RoleTemplateCode" />
    <input type="hidden" name="DealershipId" value="@Model.DealershipId" />

    <div class="card card-primary mb-3">
        <div class="card-header"><h3 class="card-title mb-0">Role Details</h3></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6 col-lg-4">
                    <label class="form-label fw-bold">Display Name</label>
                    <input type="text" name="RoleName" class="form-control" value="@Model.RoleName" required />
                </div>
                <div class="col-md-6 col-lg-8">
                    <label class="form-label fw-bold">Description</label>
                    <input type="text" name="Description" class="form-control" value="@Model.Description" />
                </div>
                <div class="col-12">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                        <label class="form-check-label" for="isActive">Active</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <partial name="_MenuPermissionMatrix" />

    <div class="mt-3">
        <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-save"></i> Save Role</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg ms-2">Cancel</a>
    </div>
</form>
