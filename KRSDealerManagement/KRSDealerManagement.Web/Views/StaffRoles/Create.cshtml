@model KRSDealerManagement.Web.Controllers.StaffRoleFormModel
@using KRSDealerManagement.Shared.Constants
@{
    ViewData["Title"] = "Add Staff Role";
    ViewData["RoleForm"] = Model;
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-plus-circle"></i> Add Staff Role</h1>
        <p class="text-muted mb-0">Create a shared role and choose which menus staff can access. Assign locations when creating staff users.</p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="RoleTemplateCode" value="@RoleTemplateCodes.Custom" />

    <div class="card card-primary mb-3">
        <div class="card-header"><h3 class="card-title mb-0">Role Details</h3></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6 col-lg-4">
                    <label class="form-label fw-bold">Display Name <span class="text-danger">*</span></label>
                    <input type="text" name="RoleName" id="roleName" class="form-control" value="@Model.RoleName" required placeholder="e.g., Finance Manager" />
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="form-label fw-bold">Role Code <span class="text-danger">*</span></label>
                    <input type="text" name="RoleCode" id="roleCode" class="form-control" value="@Model.RoleCode" required placeholder="Auto-suggested from name" />
                    <small class="text-muted">Unique code used internally. Shared across all locations.</small>
                </div>
                <div class="col-md-12">
                    <label class="form-label fw-bold">Description</label>
                    <input type="text" name="Description" class="form-control" value="@Model.Description" placeholder="Optional note about this role" />
                </div>
            </div>
        </div>
    </div>

    <partial name="_MenuPermissionMatrix" />

    <div class="mt-3">
        <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-save"></i> Create Role</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg ms-2">Cancel</a>
    </div>
</form>

@section Scripts {
<script>
    async function refreshSuggestedCode() {
        const roleName = document.getElementById('roleName').value;
        if (!roleName) return;
        const res = await fetch('@Url.Action("SuggestCode")?roleName=' + encodeURIComponent(roleName));
        const data = await res.json();
        if (data.code) document.getElementById('roleCode').value = data.code;
    }

    document.getElementById('roleName').addEventListener('blur', refreshSuggestedCode);
</script>
}
