@model IEnumerable<KRSDealerManagement.Application.DTOs.StaffRoleDto>
@{
    ViewData["Title"] = "Staff Roles";
    var dealerships = ViewBag.Dealerships as IEnumerable<KRSDealerManagement.Application.Queries.DealershipDto>
        ?? Enumerable.Empty<KRSDealerManagement.Application.Queries.DealershipDto>();
}

<div class="row mb-3">
    <div class="col-md-7">
        <h1 class="m-0"><i class="bi bi-shield-lock"></i> Staff Roles</h1>
        <p class="text-muted">Create regional roles, configure menu access, and read-only screens.</p>
    </div>
    <div class="col-md-5 text-end">
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Role</a>
        <a href="@Url.Action("Index", "RoleTemplates")" class="btn btn-outline-primary"><i class="bi bi-diagram-3"></i> Role Templates</a>
        <a href="@Url.Action("Index", "StaffUsers")" class="btn btn-outline-secondary"><i class="bi bi-person-badge"></i> Staff Users</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label form-label-sm mb-0">Search</label>
                <input type="text" name="searchTerm" class="form-control form-control-sm" value="@ViewBag.SearchTerm" placeholder="Role name or code..." />
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Dealership</label>
                <select name="dealershipId" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var d in dealerships)
                    {
                        <option value="@d.DealershipId" selected="@(ViewBag.DealershipId?.ToString() == d.DealershipId.ToString())">@d.DealershipName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">Status</label>
                <select name="isActive" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="true" selected="@(ViewBag.IsActive == true)">Active</option>
                    <option value="false" selected="@(ViewBag.IsActive == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter"></i> Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive">
        @if (Model.Any())
        {
            <table class="table table-sm table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Role</th>
                        <th>Template</th>
                        <th>Dealership</th>
                        <th>Menus</th>
                        <th>Users</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                <strong>@r.RoleName</strong><br />
                                <code class="small">@r.RoleCode</code>
                            </td>
                            <td>@r.RoleTemplateName</td>
                            <td>@r.DealershipName</td>
                            <td>@r.MenuCount</td>
                            <td>@r.UserCount</td>
                            <td>
                                @if (r.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Edit", new { id = r.RoleId })" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Configure</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No staff roles found.</p>
        }
    </div>
</div>
