@using KRSDealerManagement.Shared.Constants
@{
    ViewData["Title"] = "Add Resolution Type";
}

<h1 class="mb-3"><i class="bi bi-plus"></i> Add Resolution Type</h1>

<form method="post">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Name *</label>
                <input name="name" class="form-control" required maxlength="100" />
            </div>
            <div class="mb-3">
                <label class="form-label">Code</label>
                <input name="code" class="form-control text-uppercase" maxlength="50" placeholder="Optional — auto from name" style="text-transform:uppercase" />
            </div>
            <div class="mb-3">
                <label class="form-label">Action Type *</label>
                <select name="actionType" class="form-select" required>
                    @foreach (var a in WarrantyResolutionActionTypes.All)
                    {
                        <option value="@a">@a</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Sort Order</label>
                <input name="sortOrder" type="number" class="form-control" value="0" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="@Url.Action("Index")" class="btn btn-link">Cancel</a>
        </div>
    </div>
</form>
