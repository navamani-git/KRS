@model IEnumerable<KRSDealerManagement.Domain.Entities.WarrantyResolutionType>
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "Warranty Resolution Types";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-list-check"></i> Resolution Types</h1>
        <p class="text-muted">Configure warranty claim resolution options and action types</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add Resolution</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <partial name="_GridScrollHint" />
        <div class="table-responsive">
            <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@GridIds.WarrantyResolutionTypes">
                <thead class="table-dark">
                    <tr>
                        <th class="grid-col-rownum">#</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Action Type</th>
                        <th>Sort</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                    <partial name="_PaginatedGridFilters" />
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@(i++)</td>
                            <td><strong>@r.Code</strong></td>
                            <td>@r.Name</td>
                            <td>@r.ActionType</td>
                            <td>@r.SortOrder</td>
                            <td>@(r.IsActive ? "Active" : "Inactive")</td>
                            <td class="text-end"><a href="@Url.Action("Edit", new { id = r.WarrantyResolutionTypeId })" class="btn btn-sm btn-outline-primary">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="p-3"><partial name="_Pagination" /></div>
    </div>
</div>
