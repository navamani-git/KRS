@model IEnumerable<KRSDealerManagement.Application.DTOs.ShowroomStockRowDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "Subdealer Stock";
    var locations = ViewBag.DealershipLocations as IEnumerable<string> ?? Enumerable.Empty<string>();
    var subdealers = ViewBag.Subdealers as IEnumerable<UserDto> ?? Enumerable.Empty<UserDto>();
    var selectedLocation = ViewBag.SelectedDealershipLocation as string;
    var totalValue = (decimal)(ViewBag.TotalStockValue ?? 0m);
}

<div class="row mb-3">
    <div class="col-lg-8">
        <h1 class="m-0"><i class="bi bi-box-seam"></i> Subdealer Stock</h1>
        <p class="text-muted mb-0">
            Vehicles allocated to subdealers that are <strong>not yet booked</strong> and <strong>not invoiced</strong>.
            Dealer showroom (unallocated) vehicles are not included.
        </p>
    </div>
    <div class="col-lg-4 text-lg-end mt-2 mt-lg-0">
        <partial name="_ExportExcel" />
        <div class="mt-2">
            <span class="badge bg-primary fs-6">On this page: @Model.Count() of @(ViewBag.TotalItems ?? Model.Count())</span>
            <span class="badge bg-secondary fs-6 ms-1">Value: ₹@totalValue.ToString("N2")</span>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end" id="gridFilterForm">
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Location</label>
                <select name="dealershipLocation" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All locations</option>
                    @foreach (var loc in locations)
                    {
                        <option value="@loc" selected="@(string.Equals(selectedLocation, loc, StringComparison.OrdinalIgnoreCase))">@loc</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Subdealer</label>
                <select name="subdealerId" class="form-select form-select-sm">
                    <option value="">All subdealers@(string.IsNullOrWhiteSpace(selectedLocation) ? "" : $" in {selectedLocation}")</option>
                    @foreach (var s in subdealers)
                    {
                        <option value="@s.UserId" selected="@(ViewBag.SelectedSubdealerId?.ToString() == s.UserId.ToString())">@s.GetFullName()</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label form-label-sm mb-0">Search</label>
                <input type="text" name="searchTerm" class="form-control form-control-sm"
                       placeholder="Chassis, model, subdealer..." value="@ViewBag.SearchTerm" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0">Stock list (@(ViewBag.TotalItems ?? Model.Count()))</h3>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <partial name="_GridScrollHint" />
            <div class="table-responsive">
                <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@GridIds.ShowroomStock">
                    <thead class="table-dark">
                        <tr>
                            <th class="grid-col-rownum">#</th>
                            <th>Location</th>
                            <th>Subdealer</th>
                            <th>Chassis</th>
                            <th>Model</th>
                            <th>Color</th>
                            <th>Order #</th>
                            <th>Allocated</th>
                            <th>Days in stock</th>
                            <th class="text-end">Price (₹)</th>
                        </tr>
                        <partial name="_PaginatedGridFilters" />
                    </thead>
                    <tbody>
                        @{ var sr = 1; }
                        @foreach (var row in Model)
                        {
                            <tr>
                                <td>@(sr++)</td>
                                <td><small>@(row.DealershipLocation ?? "—")</small></td>
                                <td><small>@row.SubdealerName</small></td>
                                <td>
                                    <partial name="_ChassisLink" view-data='new ViewDataDictionary(ViewData) {
                                        { "VehicleId", row.VehicleId }, { "Chassis", row.ChassisNumber }, { "ChassisCodeClass", "small" } }' />
                                </td>
                                <td>@row.ModelName</td>
                                <td>@row.ColorName</td>
                                <td><small>@(row.OrderNumber ?? "—")</small></td>
                                <td><small>@(row.AllocatedDate?.ToString("yyyy-MM-dd") ?? "—")</small></td>
                                <td><span class="badge bg-light text-dark border">@row.DaysInStock</span></td>
                                <td class="text-end fw-bold">₹@row.CurrentPrice.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="px-3 pb-3 pt-2">
                <partial name="_Pagination" />
            </div>
        }
        else
        {
            <div class="alert alert-info m-3 mb-0">
                <i class="bi bi-info-circle"></i> No showroom stock found for the selected filters.
            </div>
        }
    </div>
</div>
