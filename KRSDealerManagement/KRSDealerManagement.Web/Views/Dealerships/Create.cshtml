@{
    ViewData["Title"] = "Add Dealership";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0">Add Dealership Location</h1>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="card card-primary">
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div class="mb-3">
                <label class="fw-bold">Code <span class="text-danger">*</span></label>
                <input name="dealershipCode" class="form-control" placeholder="e.g. COIMBATORE" required />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Name <span class="text-danger">*</span></label>
                <input name="dealershipName" class="form-control" placeholder="e.g. KRS Coimbatore" required />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Location</label>
                <input name="location" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Phone</label>
                <input name="contactPhone" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Email</label>
                <input name="email" type="email" class="form-control" />
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>
