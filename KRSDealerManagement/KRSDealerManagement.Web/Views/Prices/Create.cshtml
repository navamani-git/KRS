@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Add / Update Price";
    var models = ViewBag.Models as IEnumerable<VehicleModelDto>;
    var currentMonth = (int)(ViewBag.CurrentMonth ?? DateTime.Now.Month);
    var currentYear = (int)(ViewBag.CurrentYear ?? DateTime.Now.Year);
    var modelColorMapJson = ViewBag.ModelColorMapJson as string ?? "{}";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-currency-rupee"></i> Add / Update Price</h1>
        <p class="text-muted">Set price for a model + color — multiple prices per month allowed with effective date</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card card-primary">
            <div class="card-header"><h3 class="card-title">Price Entry</h3></div>
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <!-- Model -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Vehicle Model <span class="text-danger">*</span></label>
                        <select name="modelId" id="modelId" class="form-select" required>
                            <option value="">-- Select Model --</option>
                            @if (models != null)
                            {
                                @foreach (var m in models)
                                {
                                    <option value="@m.ModelId" selected="@(ViewBag.SelectedModelId?.ToString() == m.ModelId.ToString())">
                                        @m.ModelName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Color -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Color <span class="text-danger">*</span></label>
                        <select name="colorId" id="colorId" class="form-select" required>
                            <option value="">-- Select Model First --</option>
                        </select>
                    </div>

                    <!-- Month and Year -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Month <span class="text-danger">*</span></label>
                                <select name="month" class="form-select" required>
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m" selected="@(m == currentMonth)">
                                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Year <span class="text-danger">*</span></label>
                                <select name="year" class="form-select" required>
                                    @for (int y = currentYear - 1; y <= currentYear + 2; y++)
                                    {
                                        <option value="@y" selected="@(y == currentYear)">@y</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Effective From <span class="text-danger">*</span></label>
                        <input type="date" name="effectiveFrom" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        <small class="text-muted">Vehicles invoiced on or after this date will use this price. Earlier invoices keep prior price.</small>
                    </div>

                    <!-- Price -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Price (₹) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" name="price" class="form-control"
                                   placeholder="e.g., 1250000" min="1" step="0.01" required />
                        </div>
                        <small class="text-muted">Enter price in Indian Rupees (₹)</small>
                    </div>

                    <!-- Notes -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Notes</label>
                        <input type="text" name="notes" class="form-control"
                               placeholder="Optional: reason for this price (e.g., Price revision for Q3)" />
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <strong>Note:</strong> If a price already exists for the same Model + Color + Month + Year,
                        it will be updated automatically.
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Price</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Help -->
    <div class="col-md-6">
        <div class="card card-info">
            <div class="card-header"><h3 class="card-title"><i class="bi bi-info-circle"></i> Instructions</h3></div>
            <div class="card-body">
                <ul>
                    <li>Each Model + Color combination can have <strong>different prices per month</strong></li>
                    <li>If you add the same combination for the same month/year, it <strong>updates the existing price</strong></li>
                    <li>Prices are used when subdealers create purchase orders</li>
                    <li>The system picks the price for the <strong>current month</strong> when an order is placed</li>
                </ul>
                <hr />
                <p><strong>Example:</strong></p>
                <ul>
                    <li>Ampere Nexus EX + Pearl White → August 2026 → ₹1,15,000</li>
                    <li>Ampere Nexus ST + Jet Black → August 2026 → ₹1,20,000</li>
                    <li>Ampere Magnus Pro + Ocean Blue → August 2026 → ₹1,05,000</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/model-color-filter.js"></script>
    <script>
        KrsModelColors.init(@Html.Raw(modelColorMapJson));
        const modelSelect = document.getElementById('modelId');
        const colorSelect = document.getElementById('colorId');
        KrsModelColors.bind(modelSelect, colorSelect);
    </script>
}
