@model KRSDealerManagement.Domain.Entities.VehiclePriceHistory
@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Edit Price";
    var models = ViewBag.Models as IEnumerable<VehicleModelDto> ?? Enumerable.Empty<VehicleModelDto>();
    var colors = ViewBag.Colors as IEnumerable<VehicleColorDto> ?? Enumerable.Empty<VehicleColorDto>();
    var modelName = models.FirstOrDefault(m => m.ModelId == Model.ModelId)?.ModelName ?? $"Model #{Model.ModelId}";
    var colorName = colors.FirstOrDefault(c => c.ColorId == Model.ColorId)?.ColorName ?? $"Color #{Model.ColorId}";
}

<div class="row mb-3">
    <div class="col-md-8"><h1 class="m-0">Edit Price</h1></div>
    <div class="col-md-4 text-end"><a href="@Url.Action("Index")" class="btn btn-secondary">Back</a></div>
</div>

<div class="card">
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.PriceHistoryId" />
        <div class="card-body">
            <p><strong>@modelName</strong> · @colorName</p>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Effective From <span class="text-danger">*</span></label>
                    <input type="date" name="effectiveFrom" class="form-control" value="@Model.EffectiveFrom.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="fw-bold">Effective To <span class="text-danger">*</span></label>
                    <input type="date" name="effectiveTo" class="form-control" value="@Model.EffectiveTo.ToString("yyyy-MM-dd")" required />
                </div>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Price (₹) <span class="text-danger">*</span></label>
                <input type="number" name="price" class="form-control" step="0.01" min="0.01" value="@Model.Price" required />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Notes</label>
                <textarea name="notes" class="form-control" rows="2">@Model.Notes</textarea>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Change reason</label>
                <input type="text" name="remarks" class="form-control" placeholder="Optional audit note" />
            </div>
            <div class="alert alert-warning mb-0">
                Editing dates must not overlap another price line for the same model and color.
            </div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Save</button></div>
    </form>
</div>
