@model IEnumerable<KRSDealerManagement.Application.DTOs.VehiclePriceHistoryDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "Price Management";
    var models = ViewBag.Models as IEnumerable<VehicleModelDto>;
    var colors = ViewBag.Colors as IEnumerable<VehicleColorDto>;
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-currency-rupee"></i> Price Management</h1>
        <p class="text-muted">Set monthly prices for each model and color combination</p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add/Update Price
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" id="gridFilterForm">
            <div class="row g-2">
                <div class="col-md-3">
                    <select name="modelId" class="form-select">
                        <option value="">All Models</option>
                        @if (models != null)
                        {
                            @foreach (var m in models)
                            {
                                <option value="@m.ModelId" selected="@(ViewBag.SelectedModelId?.ToString() == m.ModelId.ToString())">
                                    @m.ModelName
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="colorId" class="form-select">
                        <option value="">All Colors</option>
                        @if (colors != null)
                        {
                            @foreach (var c in colors)
                            {
                                <option value="@c.ColorId" selected="@(ViewBag.SelectedColorId?.ToString() == c.ColorId.ToString())">
                                    @c.ColorName
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="month" class="form-select">
                        <option value="">All Months</option>
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(ViewBag.SelectedMonth?.ToString() == m.ToString())">
                                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="number" name="year" class="form-control" value="@ViewBag.SelectedYear"
                           placeholder="Year" min="2020" max="2030" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Filter</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="bi bi-arrow-clockwise"></i></a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Prices Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-table"></i> Price List (@Model.Count() records)</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <partial name="_GridScrollHint" />
            <div class="table-responsive">
                <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@GridIds.Prices">
                    <thead class="table-dark">
                        <tr>
                            <th>Model</th>
                            <th>Color</th>
                            <th>Month / Year</th>
                            <th>Effective From</th>
                            <th class="text-end">Price (₹)</th>
                            <th>Notes</th>
                            <th>Last Updated</th>
                            <th>Actions</th>
                        </tr>
                        <partial name="_PaginatedGridFilters" />
                    </thead>
                    <tbody>
                        @foreach (var price in Model)
                        {
                            <tr>
                                <td><strong>@price.ModelName</strong></td>
                                <td>@price.ColorName</td>
                                <td>
                                    <span class="badge bg-info">
                                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(price.Month) @price.Year
                                    </span>
                                </td>
                                <td>@price.EffectiveFrom.ToString("yyyy-MM-dd")</td>
                                <td class="text-end"><strong>₹@price.Price.ToString("N2")</strong></td>
                                <td>
                                    <small class="text-muted">@(price.Notes ?? "-")</small>
                                </td>
                                <td>
                                    <small class="text-muted">@price.ModifiedDate.ToString("yyyy-MM-dd")</small>
                                </td>
                                <td>
                                    @{ ViewData["CrudId"] = price.PriceHistoryId; ViewData["CrudController"] = "Prices"; }
                                    <partial name="_CrudActions" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No prices found for selected filters.
                <a href="@Url.Action("Create")">Add a price entry.</a>
            </div>
        }
        <partial name="_Pagination" />
    </div>
</div>
