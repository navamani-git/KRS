@model IEnumerable<KRSDealerManagement.Application.DTOs.PaymentDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Domain.Entities
@using KRSDealerManagement.Web.Helpers
@{
    ViewData["Title"] = "My Payments";
    var paymentTypes = ViewBag.PaymentTypes as IEnumerable<PaymentType> ?? Enumerable.Empty<PaymentType>();
    var financeNames = ViewBag.FinanceNames as IEnumerable<FinanceNameMaster> ?? Enumerable.Empty<FinanceNameMaster>();
    var statuses = ViewBag.Statuses as IEnumerable<StatusLookup> ?? Enumerable.Empty<StatusLookup>();
    var statusOptions = StatusViewHelper.ToSelectList(statuses, ViewBag.SelectedStatus as int?, "All");
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-wallet2"></i> My Payments</h1>
        <p class="text-muted">View payment history and submit new payments</p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" view-data='new ViewDataDictionary(ViewData) { { "ExportAction", "ExportMyPayments" } }' />
        <button class="btn btn-primary" onclick="new bootstrap.Modal(document.getElementById('paymentModal')).show()">
            <i class="bi bi-plus-circle"></i> Add Payment
        </button>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">From</label>
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">To</label>
                <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Status</label>
                <select name="status" class="form-select form-select-sm" asp-items="statusOptions">
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter"></i> Filter</button>
                <a href="@Url.Action("MyPayments")" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Payment History (@(ViewBag.TotalItems ?? Model.Count()))</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover table-sm">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th>Customer</th>
                            <th>Finance</th>
                            <th>VIN</th>
                            <th>Proof</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Processed</th>
                            <th>Your Remarks</th>
                            <th>Admin Corrections</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sr = 1; }
                        @foreach (var p in Model)
                        {
                            var badgeClass = p.GetBadgeClass();
                            <tr>
                                <td>@(sr++)</td>
                                <td><small>@p.PaymentDate.ToString("yyyy-MM-dd")</small></td>
                                <td><span class="badge bg-info">@p.GetPaymentTypeDisplay()</span></td>
                                <td class="text-end fw-bold text-success">₹@p.Amount.ToString("N2")</td>
                                <td><small>@(p.CustomerName ?? "-")</small></td>
                                <td><small>@(p.FinanceName ?? "-")</small></td>
                                <td><code class="small">@(p.VinNumber ?? "-")</code></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.PaymentProofPath))
                                    {
                                        <a href="@QueryStringUrlHelper.EncryptedAction(Url, QueryCrypto, "DownloadProof", new { path = p.PaymentProofPath })" class="btn btn-xs btn-outline-secondary btn-sm" title="Proof 1"><i class="bi bi-paperclip"></i></a>
                                    }
                                    @if (!string.IsNullOrEmpty(p.PaymentProof2Path))
                                    {
                                        <a href="@QueryStringUrlHelper.EncryptedAction(Url, QueryCrypto, "DownloadProof", new { path = p.PaymentProof2Path })" class="btn btn-xs btn-outline-secondary btn-sm" title="Proof 2"><i class="bi bi-paperclip"></i>2</a>
                                    }
                                </td>
                                <td><span class="badge @badgeClass">@p.GetStatusDisplay()</span></td>
                                <td><small>@p.CreatedDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                <td>
                                    @if (p.ProcessedDate.HasValue)
                                    {
                                        <small>@p.ProcessedDate.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><small class="text-muted">@(p.SubdealerRemarks ?? "-")</small></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(p.DealerRemarks))
                                    {
                                        <small style="white-space: pre-wrap">@p.DealerRemarks</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">-</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info"><i class="bi bi-info-circle"></i> No payments submitted yet.</div>
        }
        <partial name="_Pagination" />
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Add Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="Submit" enctype="multipart/form-data" id="paymentForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Amount (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input type="number" name="amount" class="form-control" min="1" step="0.01" required />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Payment Date <span class="text-danger">*</span></label>
                            <input type="date" name="paymentDate" class="form-control"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold">Payment Type <span class="text-danger">*</span></label>
                        <select name="paymentTypeId" id="paymentTypeId" class="form-select" required onchange="onPaymentTypeChange()">
                            <option value="">-- Select --</option>
                            @foreach (var t in paymentTypes)
                            {
                                <option value="@t.PaymentTypeId"
                                        data-code="@t.TypeCode"
                                        data-requires-finance="@(t.RequiresFinanceDetails ? "1" : "0")">
                                    @t.TypeName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3 d-none" id="otherTypeDiv">
                        <label class="fw-bold">Specify Payment Type</label>
                        <input type="text" name="otherPaymentType" class="form-control" placeholder="e.g., Cheque, IMPS" />
                    </div>

                    <div id="financeFields" class="border rounded p-3 mb-3 bg-light d-none">
                        <p class="fw-bold mb-2 text-primary"><i class="bi bi-bank"></i> Finance details</p>
                        <div class="mb-3">
                            <label class="fw-bold">Customer Name (CAPS) <span class="text-danger finance-req">*</span></label>
                            <input type="text" name="customerName" id="customerName" class="form-control text-uppercase"
                                   style="text-transform:uppercase" oninput="this.value=this.value.toUpperCase()"
                                   placeholder="CUSTOMER NAME" />
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold">Finance Name <span class="text-danger finance-req">*</span></label>
                            <select name="financeNameId" id="financeNameId" class="form-select">
                                <option value="">-- Select finance --</option>
                                @foreach (var f in financeNames)
                                {
                                    <option value="@f.FinanceNameId">@f.FinanceName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-0">
                            <label class="fw-bold">VIN Number (Chassis) <span class="text-danger finance-req">*</span></label>
                            <input type="text" name="vinNumber" id="vinNumber" class="form-control text-uppercase"
                                   style="text-transform:uppercase" oninput="this.value=this.value.toUpperCase()"
                                   placeholder="CORRECT CHASSIS NO." />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Payment Proof <span class="text-danger">*</span></label>
                            <input type="file" name="paymentProof" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp,.gif" required />
                            <small class="text-muted">PDF / Image — mandatory</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Payment Proof 2</label>
                            <input type="file" name="paymentProof2" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp,.gif" />
                            <small class="text-muted">Optional</small>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="fw-bold">Remarks</label>
                        <textarea name="subdealerRemarks" class="form-control" rows="2" placeholder="Optional remarks..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Submit Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function onPaymentTypeChange() {
        const sel = document.getElementById('paymentTypeId');
        const opt = sel.options[sel.selectedIndex];
        const code = (opt.getAttribute('data-code') || '').toUpperCase();
        const requires = opt.getAttribute('data-requires-finance') === '1' || code === 'FINANCE';
        document.getElementById('financeFields').classList.toggle('d-none', !requires);
        document.getElementById('otherTypeDiv').classList.toggle('d-none', code !== 'OTHERS');

        ['customerName', 'financeNameId', 'vinNumber'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.required = requires;
        });
    }
</script>
}
