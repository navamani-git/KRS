@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Book Vehicle";
    var vehicle = ViewBag.Vehicle as VehicleDto;
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-journal-check"></i> Book Vehicle</h1>
        <p class="text-muted">@vehicle?.ModelName · @vehicle?.ColorName · <strong>@vehicle?.ChassisNumber</strong></p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index", "Vehicles")" class="btn btn-secondary">Back to Vehicles</a>
    </div>
</div>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="vehicleId" value="@vehicle?.VehicleId" />

    <partial name="_BookingCustomerFormFields" />

    <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check-circle"></i> Submit Booking</button>
</form>

@section Scripts {
    <partial name="_BookingFormScripts" />
}
