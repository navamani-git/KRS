@using KRSDealerManagement.Shared.Helpers
@model KRSDealerManagement.Domain.Entities.VehicleBooking
@using KRSDealerManagement.Domain.Entities
@using KRSDealerManagement.Shared.Constants
@using KRSDealerManagement.Web.Helpers
@{
    ViewData["Title"] = "Vehicle Booking";
    var isStaff = ViewBag.IsStaff ?? false;
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var isStaffNonAdmin = isStaff && !isAdmin;
    var statuses = ViewBag.Statuses as IEnumerable<StatusLookup> ?? Enumerable.Empty<StatusLookup>();
    var vehicleStatus = (int)(ViewBag.VehicleStatus ?? Model.BookingStatus);
    var manageDateTimeMax = ViewBag.ManageDateTimeMax as string ?? IstTime.DateTimeLocalMaxValue();
    var staffInvoiceLocked = ViewBag.StaffInvoiceLocked as bool? ?? false;
    var staffInsuranceLocked = ViewBag.StaffInsuranceLocked as bool? ?? false;
    var canViewSubsidyDocs = ViewBag.CanViewSubsidyDocs as bool? ?? false;
    var canEditSubsidyDocs = ViewBag.CanEditSubsidyDocs as bool? ?? false;
    var canEditNumberPlate = ViewBag.CanEditNumberPlate as bool? ?? false;
    var staffMilestoneLocked = isStaffNonAdmin;
    var staffPaperLocked = staffMilestoneLocked && Model.PaperReceivedDate.HasValue;
    var staffInvoiceDateLocked = staffMilestoneLocked && Model.InvoiceDate.HasValue;
    var staffInsuranceDateLocked = staffMilestoneLocked && Model.InsuranceDate.HasValue;
    var staffAgentLocked = staffMilestoneLocked && Model.AgentDate.HasValue;
    var staffRegistrationLocked = staffMilestoneLocked && Model.RegistrationDate.HasValue;
    var staffRtoLocked = staffMilestoneLocked && !string.IsNullOrWhiteSpace(Model.RtoNumber);
    var staffSubsidyLocked = staffMilestoneLocked && !string.IsNullOrWhiteSpace(Model.SubsidyId);
    var canWriteManage = ViewBag.CanWriteManage as bool? ?? !isStaffNonAdmin;
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-journal-text"></i> Booking #@Model.VehicleBookingId</h1>
        <p class="text-muted">@ViewBag.ModelName · @ViewBag.ColorName · <span class="text-nowrap">@ViewBag.Chassis</span> · @ViewBag.PaymentModeLabel</p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index", "Vehicles")" class="btn btn-secondary">Vehicles</a>
        @if (isStaff) { <a href="@Url.Action("Index")" class="btn btn-outline-secondary">All Bookings</a> }
        @if (ViewBag.CanEditBooking == true)
        {
            <a href="@Url.Action("Edit", new { id = Model.VehicleBookingId })" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit Booking
            </a>
        }
        @if (canEditSubsidyDocs && !string.IsNullOrWhiteSpace(Model.SubsidyId))
        {
            <a href="@Url.Action("SubsidyDocs", new { id = Model.VehicleBookingId })" class="btn btn-outline-primary">
                <i class="bi bi-folder2-open"></i> Subsidy Docs
            </a>
        }
    </div>
</div>

    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title mb-0">Booking Summary</h3></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Mobile 1</th>
                            <th>Mobile 2</th>
                            <th>Model</th>
                            <th>Color</th>
                            <th>Chassis</th>
                            <th>RTO District</th>
                            <th>RTO Location</th>
                            <th>Fancy</th>
                            <th>Payment / Finance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="fw-bold">
                            <td>@Model.CustomerName</td>
                            <td>@Model.CustomerMobile</td>
                            <td>@Model.AlternativeMobile</td>
                            <td>@ViewBag.ModelName</td>
                            <td>@ViewBag.ColorName</td>
                            <td class="text-nowrap">@ViewBag.Chassis</td>
                            <td>@(ViewBag.RtoDistrictName ?? "—")</td>
                            <td>@(ViewBag.RtoLocationName ?? "—")</td>
                            <td>@(ViewBag.FancyNumberLabel ?? "—")</td>
                            <td>@ViewBag.PaymentModeLabel / @(ViewBag.FinanceName ?? "—")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<div class="row">
    <div class="col-md-7">
        <div class="card mb-3"><div class="card-header"><h3 class="card-title">Documents Uploaded</h3></div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.SubsidyId))
            {
                <p class="small mb-2"><strong>Subsidy ID:</strong> @Model.SubsidyId</p>
            }
            <div class="d-flex flex-wrap gap-2">
                <partial name="_FileAttachmentLinks" view-data='new ViewDataDictionary(ViewData) { { "FilePath", Model.EAadhaarPath }, { "FileLabel", "E-Aadhaar" } }' />
                <partial name="_FileAttachmentLinks" view-data='new ViewDataDictionary(ViewData) { { "FilePath", Model.DocumentPath }, { "FileLabel", "ID Doc" } }' />
                @if (!string.IsNullOrEmpty(Model.GstCertificatePath)) {
                    <partial name="_FileAttachmentLinks" view-data='new ViewDataDictionary(ViewData) { { "FilePath", Model.GstCertificatePath }, { "FileLabel", "GST" } }' /> }
                <partial name="_FileAttachmentLinks" view-data='new ViewDataDictionary(ViewData) { { "FilePath", Model.CustomerPhotoPath }, { "FileLabel", "Photo" } }' />
                <partial name="_FileAttachmentLinks" view-data='new ViewDataDictionary(ViewData) { { "FilePath", Model.ChassisPhotoPath }, { "FileLabel", "Chassis Img" } }' />
                <partial name="_FileAttachmentLinks" view-data='new ViewDataDictionary(ViewData) { { "FilePath", Model.CustomerSignPath }, { "FileLabel", "Sign/Seal" } }' />
            </div>
        </div></div>

        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title mb-0">Invoice &amp; Insurance</h3></div>
            <div class="card-body">
                <p class="text-muted small mb-2">Uploaded by dealer staff. Subdealer can view and download here.</p>
                <div class="d-flex flex-wrap gap-2">
                    <partial name="_InvoiceInsuranceLinks" view-data='new ViewDataDictionary(ViewData) {
                        { "FilePath", Model.InvoicePath }, { "FileLabel", "Invoice" },
                        { "MilestoneDate", Model.InvoiceDate }, { "FileAvailable", ViewBag.InvoiceFileAvailable } }' />
                    <partial name="_InvoiceInsuranceLinks" view-data='new ViewDataDictionary(ViewData) {
                        { "FilePath", Model.InsurancePath }, { "FileLabel", "Insurance" },
                        { "MilestoneDate", Model.InsuranceDate }, { "FileAvailable", ViewBag.InsuranceFileAvailable } }' />
                </div>
            </div>
        </div>

        @if (canEditSubsidyDocs && !string.IsNullOrWhiteSpace(Model.SubsidyId))
        {
            <div class="alert alert-info">
                Subsidy ID assigned. <a href="@Url.Action("SubsidyDocs", new { id = Model.VehicleBookingId })" class="alert-link">Upload or update subsidy documents</a>
            </div>
        }
        @if (canViewSubsidyDocs && !string.IsNullOrWhiteSpace(Model.SubsidyId)
            && (Model.SubsidyDocsSubmittedDate.HasValue
                || !string.IsNullOrWhiteSpace(Model.FaceVerificationPath)
                || !string.IsNullOrWhiteSpace(Model.RcImagePath)
                || !string.IsNullOrWhiteSpace(Model.BoothPhotoPath)
                || !string.IsNullOrWhiteSpace(Model.SubsidyUndertakingPath)))
        {
            <div class="card mb-3"><div class="card-header">Subsidy Documents</div><div class="card-body d-flex gap-2 flex-wrap">
                <partial name="_FileAttachmentLinks" view-data='new ViewDataDictionary(ViewData) { { "FilePath", Model.FaceVerificationPath }, { "FileLabel", "Face Verification" } }' />
                <partial name="_FileAttachmentLinks" view-data='new ViewDataDictionary(ViewData) { { "FilePath", Model.RcImagePath }, { "FileLabel", "RC Image" } }' />
                <partial name="_FileAttachmentLinks" view-data='new ViewDataDictionary(ViewData) { { "FilePath", Model.BoothPhotoPath }, { "FileLabel", "Booth Photo" } }' />
                <partial name="_FileAttachmentLinks" view-data='new ViewDataDictionary(ViewData) { { "FilePath", Model.SubsidyUndertakingPath }, { "FileLabel", "Undertaking" } }' />
                <p class="w-100 mb-0"><small>Customer (CAPS): @Model.SubsidyCustomerNameCaps</small></p>
            </div></div>
        }

        @{
            var allSubsidyDocsUploaded = ViewBag.AllSubsidyDocsUploaded as bool? ?? false;
            var subsidyCompletedApproved = ViewBag.SubsidyCompletedApproved as bool? ?? false;
            var subsidyApprovedOn = ViewBag.SubsidyCompletedApprovedDate as string;
        }
        @if (isStaff)
        {
            <div class="card mb-3 @(allSubsidyDocsUploaded ? "border-success" : "")">
                <div class="card-header"><h3 class="card-title mb-0">All subsidy completed – Approve</h3></div>
                <div class="card-body">
                    @if (subsidyCompletedApproved)
                    {
                        <p class="mb-2">Approved@(string.IsNullOrWhiteSpace(subsidyApprovedOn) ? "" : $" on {subsidyApprovedOn}"). Vehicle is off Vehicle Aging.</p>
                    }
                    else if (!allSubsidyDocsUploaded)
                    {
                        <p class="text-muted mb-0">Enabled after Face Verification, RC Image, Booth Photo and Subsidy Undertaking are all uploaded.</p>
                    }
                    @if (isAdmin && allSubsidyDocsUploaded)
                    {
                        <form method="post" asp-action="ApproveSubsidyCompleted">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.VehicleBookingId" />
                            <button type="submit" class="btn btn-success"
                                    onclick="return confirm('@(subsidyCompletedApproved ? "Already approved. Do you want to approve again? The approval date will be updated." : "Mark all subsidy documents as complete and remove this vehicle from Vehicle Aging?")');">
                                <i class="bi bi-check2-all"></i> All subsidy completed – Approve
                            </button>
                        </form>
                    }
                    else if (!isAdmin && allSubsidyDocsUploaded && !subsidyCompletedApproved && canWriteManage)
                    {
                        <form method="post" asp-action="ApproveSubsidyCompleted">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.VehicleBookingId" />
                            <button type="submit" class="btn btn-success"
                                    onclick="return confirm('Mark all subsidy documents as complete and remove this vehicle from Vehicle Aging?');">
                                <i class="bi bi-check2-all"></i> All subsidy completed – Approve
                            </button>
                        </form>
                    }
                    else if (!isAdmin && subsidyCompletedApproved)
                    {
                        <button type="button" class="btn btn-success" disabled>All subsidy completed – Approve</button>
                    }
                    else if (!allSubsidyDocsUploaded)
                    {
                        <button type="button" class="btn btn-outline-secondary" disabled>All subsidy completed – Approve</button>
                    }
                </div>
            </div>
        }

        @if (canEditNumberPlate)
        {
            <div class="card mb-3">
                <div class="card-header"><h3 class="card-title mb-0">Number Plate Received</h3></div>
                <div class="card-body">
                    <form method="post" asp-action="NumberPlateReceived" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.VehicleBookingId" />
                        <div class="col-md-5">
                            <label class="form-label">Received date *</label>
                            <input type="datetime-local" name="numberPlateReceivedDate" class="form-control" required
                                   max="@manageDateTimeMax"
                                   value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.NumberPlateReceivedDate)" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Received by (name) *</label>
                            <input type="text" name="numberPlateReceivedBy" class="form-control" maxlength="200" required
                                   value="@Model.NumberPlateReceivedBy" placeholder="Person who received the number plate" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Save</button>
                        </div>
                    </form>
                    <small class="text-muted">Can be updated anytime after registration.</small>
                </div>
            </div>
        }

        @if (ViewBag.CanMarkDelivered == true)
        {
            <div class="card mb-3 border-success">
                <div class="card-header bg-success text-white"><h3 class="card-title mb-0">Confirm Delivery</h3></div>
                <div class="card-body">
                    <p class="mb-3">Mark this vehicle as <strong>Delivered</strong> and record the delivery date.</p>
                    <form method="post" asp-action="MarkDelivered" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.VehicleBookingId" />
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Delivery date &amp; time</label>
                            <input type="datetime-local" name="deliveryDate" class="form-control" required
                                   min="@ViewBag.MinDeliveryDate" max="@ViewBag.MaxDeliveryDate"
                                   value="@ViewBag.MaxDeliveryDate" />
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-success" onclick="return confirm('Mark this vehicle as delivered?');">
                                <i class="bi bi-check-circle"></i> Mark as Delivered
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
        @if (!isStaffNonAdmin && vehicleStatus == UnifiedVehicleStatus.Delivered)
        {
            <div class="alert alert-success"><i class="bi bi-check-circle"></i> Delivered@(ViewBag.DeliveryDate != null ? $" on {ViewBag.DeliveryDate}" : "").</div>
        }
    </div>

    @if (isStaff)
    {
        <div class="col-md-5">
            <div class="card card-primary"><div class="card-header"><h3 class="card-title">Staff Processing</h3></div>
            <div class="card-body">
                @if (!canWriteManage)
                {
                    <div class="alert alert-warning">This screen is read-only for your role. Export is still allowed from list screens.</div>
                }
                <fieldset @(canWriteManage ? null : "disabled")>
                <form method="post" enctype="multipart/form-data" id="staffBookingForm">@Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.VehicleBookingId" />
                    <input type="hidden" name="confirmPriceAdjustment" id="confirmPriceAdjustment" value="false" />
                    <input type="hidden" name="replaceInvoice" id="replaceInvoice" value="false" />
                    <div class="mb-2"><label class="fw-bold">Status</label>
                        @if (vehicleStatus == UnifiedVehicleStatus.Delivered)
                        {
                            <p class="form-control-plaintext mb-0">
                                <span class="badge bg-success">Delivered</span>
                                <small class="text-muted ms-1">(set by subdealer)</small>
                            </p>
                        }
                        else
                        {
                        <select name="bookingStatus" id="bookingStatus" class="form-select">
                            @foreach (var s in statuses)
                            {
                                var selectable = BookingStageFilter.IsStatusSelectable(
                                    s.StatusValue,
                                    Model.PaperReceivedDate,
                                    Model.InvoiceDate,
                                    Model.InsuranceDate,
                                    Model.AgentDate,
                                    Model.RegistrationDate,
                                    Model.SubsidyId);
                                if (vehicleStatus == s.StatusValue)
                                {
                                    <option value="@s.StatusValue" selected disabled="@(!selectable)">@s.StatusName</option>
                                }
                                else
                                {
                                    <option value="@s.StatusValue" disabled="@(!selectable)">@s.StatusName</option>
                                }
                            }
                        </select>
                        <small class="text-muted">Status must match entered milestone dates — earlier statuses are disabled when later dates are set.</small>
                        }
                    </div>
                    <div class="mb-2">
                        <label>Paper Received</label>
                        @if (staffPaperLocked)
                        {
                            <p class="form-control-plaintext mb-0"><small>@Model.PaperReceivedDate?.ToString("yyyy-MM-dd HH:mm")</small></p>
                            <input type="hidden" name="paperReceivedDate" id="paperReceivedDate" value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.PaperReceivedDate)" />
                        }
                        else
                        {
                            <input type="datetime-local" name="paperReceivedDate" id="paperReceivedDate" class="form-control milestone-input" max="@manageDateTimeMax" value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.PaperReceivedDate)" />
                        }
                    </div>
                    <div class="mb-2">
                        <label>Invoice</label>
                        @if (staffInvoiceDateLocked)
                        {
                            <p class="form-control-plaintext mb-0"><small>@Model.InvoiceDate?.ToString("yyyy-MM-dd HH:mm")</small></p>
                            <input type="hidden" name="invoiceDate" id="invoiceDate" value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.InvoiceDate)" />
                        }
                        else
                        {
                            <input type="datetime-local" name="invoiceDate" id="invoiceDate" class="form-control milestone-input" max="@manageDateTimeMax" value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.InvoiceDate)" />
                        }
                    </div>
                    <div class="mb-2">
                        <label>Invoice Document</label>
                        @if (staffInvoiceLocked)
                        {
                            <p class="form-control-plaintext mb-0">
                                <i class="bi bi-file-earmark-pdf"></i> @(ViewBag.InvoiceFileName ?? "Uploaded")
                                <small class="text-muted d-block">Uploaded — staff cannot replace. Contact admin to change.</small>
                            </p>
                        }
                        else
                        {
                            <input type="file" name="invoiceFile" id="invoiceFile" class="form-control manage-doc-input" accept=".pdf,.jpg,.jpeg,.png,.webp" data-doc-kind="invoice" />
                            @if (!string.IsNullOrEmpty(ViewBag.InvoiceFileName as string))
                            {
                                <div id="currentInvoiceWrap">
                                    <small class="text-muted d-block"><i class="bi bi-paperclip"></i> Current: @ViewBag.InvoiceFileName</small>
                                    @if (isAdmin)
                                    {
                                        <button type="button" id="btnMarkReplaceInvoice" class="btn btn-sm btn-outline-danger mt-1">
                                            <i class="bi bi-trash"></i> Delete invoice file
                                        </button>
                                    }
                                </div>
                                <p id="replaceInvoiceHint" class="small text-warning d-none mb-0 mt-1">
                                    Upload a new invoice, then click Save. The current invoice is removed only after Save.
                                </p>
                                @if (isAdmin)
                                {
                                    <button type="button" id="btnCancelReplaceInvoice" class="btn btn-sm btn-outline-secondary mt-1 d-none">Cancel</button>
                                }
                            }
                            else
                            {
                                <small class="text-muted">PDF or image, max 10 MB.</small>
                            }
                        }
                    </div>
                    <div class="mb-2">
                        <label>Insurance</label>
                        @if (staffInsuranceDateLocked)
                        {
                            <p class="form-control-plaintext mb-0"><small>@Model.InsuranceDate?.ToString("yyyy-MM-dd HH:mm")</small></p>
                            <input type="hidden" name="insuranceDate" id="insuranceDate" value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.InsuranceDate)" />
                        }
                        else
                        {
                            <input type="datetime-local" name="insuranceDate" id="insuranceDate" class="form-control milestone-input" max="@manageDateTimeMax" value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.InsuranceDate)" />
                        }
                    </div>
                    <div class="mb-2">
                        <label>Insurance Document</label>
                        @if (staffInsuranceLocked)
                        {
                            <p class="form-control-plaintext mb-0">
                                <i class="bi bi-file-earmark-pdf"></i> @(ViewBag.InsuranceFileName ?? "Uploaded")
                                <small class="text-muted d-block">Uploaded — staff cannot replace. Contact admin to change.</small>
                            </p>
                        }
                        else
                        {
                            <input type="file" name="insuranceFile" id="insuranceFile" class="form-control manage-doc-input" accept=".pdf,.jpg,.jpeg,.png,.webp" data-doc-kind="insurance" />
                            @if (!string.IsNullOrEmpty(ViewBag.InsuranceFileName as string))
                            {
                                <small class="text-muted d-block"><i class="bi bi-paperclip"></i> Current: @ViewBag.InsuranceFileName</small>
                                @if (isAdmin)
                                {
                                    <button type="submit" formaction="@Url.Action("DeleteManageDocument", new { id = Model.VehicleBookingId, documentKind = "insurance" })"
                                            formnovalidate class="btn btn-sm btn-outline-danger mt-1"
                                            onclick="return confirm('Delete the insurance document?');">
                                        <i class="bi bi-trash"></i> Delete insurance file
                                    </button>
                                }
                            }
                            else
                            {
                                <small class="text-muted">PDF or image, max 10 MB.</small>
                            }
                        }
                    </div>
                    <div class="mb-2">
                        <label>Agent</label>
                        @if (staffAgentLocked)
                        {
                            <p class="form-control-plaintext mb-0"><small>@Model.AgentDate?.ToString("yyyy-MM-dd HH:mm")</small></p>
                            <input type="hidden" name="agentDate" id="agentDate" value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.AgentDate)" />
                        }
                        else
                        {
                            <input type="datetime-local" name="agentDate" id="agentDate" class="form-control milestone-input" max="@manageDateTimeMax" value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.AgentDate)" />
                        }
                    </div>
                    <div class="mb-2">
                        <label>Registration</label>
                        @if (staffRegistrationLocked)
                        {
                            <p class="form-control-plaintext mb-0"><small>@Model.RegistrationDate?.ToString("yyyy-MM-dd HH:mm")</small></p>
                            <input type="hidden" name="registrationDate" id="registrationDate" value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.RegistrationDate)" />
                        }
                        else
                        {
                            <input type="datetime-local" name="registrationDate" id="registrationDate" class="form-control milestone-input" max="@manageDateTimeMax" value="@FormDateTimeHelper.ToDateTimeLocalValue(Model.RegistrationDate)" />
                        }
                    </div>
                    <div class="mb-2">
                        <label>RTO Number</label>
                        @if (staffRtoLocked)
                        {
                            <p class="form-control-plaintext mb-0">@Model.RtoNumber</p>
                            <input type="hidden" name="rtoNumber" id="rtoNumber" value="@Model.RtoNumber" />
                        }
                        else
                        {
                            <input name="rtoNumber" id="rtoNumber" class="form-control milestone-input" value="@Model.RtoNumber" />
                        }
                    </div>
                    <div class="mb-3">
                        <label>Subsidy ID</label>
                        @if (staffSubsidyLocked)
                        {
                            <p class="form-control-plaintext mb-0">@Model.SubsidyId</p>
                            <input type="hidden" name="subsidyId" id="subsidyId" value="@Model.SubsidyId" />
                        }
                        else
                        {
                            <input name="subsidyId" id="subsidyId" class="form-control milestone-input" value="@Model.SubsidyId" placeholder="Enter after invoice & insurance" />
                        }
                    </div>
                    <button type="submit" class="btn btn-primary w-100" @(canWriteManage ? null : "disabled")>Save</button>
                </form>
                </fieldset>
            </div></div>
        </div>
    }
</div>
@if (isStaff)
{
<script>
(function () {
    const flag = document.getElementById('replaceInvoice');
    const btn = document.getElementById('btnMarkReplaceInvoice');
    const cancel = document.getElementById('btnCancelReplaceInvoice');
    const wrap = document.getElementById('currentInvoiceWrap');
    const hint = document.getElementById('replaceInvoiceHint');
    const file = document.getElementById('invoiceFile');
    if (!flag || !btn) return;

    function setPending(pending) {
        flag.value = pending ? 'true' : 'false';
        if (wrap) wrap.classList.toggle('d-none', pending);
        if (hint) hint.classList.toggle('d-none', !pending);
        if (cancel) cancel.classList.toggle('d-none', !pending);
        if (file) {
            if (!pending) file.value = '';
            file.required = pending;
        }
    }

    btn.addEventListener('click', function () {
        if (!confirm('The current invoice stays on file until you upload a new invoice and click Save. Continue?'))
            return;
        setPending(true);
        file?.focus();
    });
    cancel?.addEventListener('click', function () { setPending(false); });
})();
</script>
}
@if (isStaff && vehicleStatus != UnifiedVehicleStatus.Delivered)
{
<script>
(function () {
    const statusSelect = document.getElementById('bookingStatus');
    const staffForm = statusSelect?.closest('form');
    if (!statusSelect || !staffForm) return;

    function toDateTimeLocalMax(d) {
        const pad = n => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }
    function refreshMilestoneMax() {
        const max = toDateTimeLocalMax(new Date());
        staffForm.querySelectorAll('input[type="datetime-local"]').forEach(function (el) { el.max = max; });
    }
    function applyMilestoneMinConstraints() {
        const chain = [
            { id: 'paperReceivedDate', prev: null },
            { id: 'invoiceDate', prev: 'paperReceivedDate' },
            { id: 'insuranceDate', prev: 'invoiceDate' },
            { id: 'agentDate', prev: 'insuranceDate' },
            { id: 'registrationDate', prev: 'agentDate' }
        ];
        chain.forEach(function (step) {
            const el = document.getElementById(step.id);
            if (!el || el.type !== 'datetime-local') return;
            if (step.prev) {
                const prev = document.getElementById(step.prev);
                el.min = prev && prev.value ? prev.value : '';
            } else {
                el.removeAttribute('min');
            }
        });
    }
    function refreshMilestoneDateConstraints() {
        refreshMilestoneMax();
        applyMilestoneMinConstraints();
    }
    staffForm.querySelectorAll('input[type="datetime-local"]').forEach(function (el) {
        el.addEventListener('focus', refreshMilestoneDateConstraints);
        el.addEventListener('click', refreshMilestoneDateConstraints);
        el.addEventListener('input', refreshMilestoneDateConstraints);
        el.addEventListener('change', refreshMilestoneDateConstraints);
    });
    refreshMilestoneDateConstraints();
    window.setInterval(refreshMilestoneMax, 30000);

    const Booked = @UnifiedVehicleStatus.BookedToCustomer;
    const Paper = @UnifiedVehicleStatus.PaperReceived;
    const Invoiced = @UnifiedVehicleStatus.Invoiced;
    const Insurance = @UnifiedVehicleStatus.InsuranceCreated;
    const Rto = @UnifiedVehicleStatus.RtoRequested;
    const Registered = @UnifiedVehicleStatus.Registered;
    const Subsidy = @UnifiedVehicleStatus.SubsidyIdCreated;

    function getMilestoneInputs() {
        return {
            paper: document.getElementById('paperReceivedDate')?.value || '',
            invoice: document.getElementById('invoiceDate')?.value || '',
            insurance: document.getElementById('insuranceDate')?.value || '',
            agent: document.getElementById('agentDate')?.value || '',
            registration: document.getElementById('registrationDate')?.value || '',
            subsidyId: document.getElementById('subsidyId')?.value?.trim() || ''
        };
    }

    function resolveFromMilestones(m) {
        if (m.subsidyId) return Subsidy;
        if (m.registration) return Registered;
        if (m.agent) return Rto;
        if (m.insurance) return Insurance;
        if (m.invoice) return Invoiced;
        if (m.paper) return Paper;
        return Booked;
    }

    function isStatusSelectable(statusValue, m) {
        const minFromDates = resolveFromMilestones(m);
        if (statusValue < minFromDates) return false;
        if (statusValue >= Paper && !m.paper) return false;
        if (statusValue >= Invoiced && !m.invoice) return false;
        if (statusValue >= Insurance && !m.insurance) return false;
        if (statusValue >= Rto && !m.agent) return false;
        if (statusValue >= Registered && !m.registration) return false;
        if (statusValue >= Subsidy && !m.subsidyId) return false;
        return true;
    }

    function applyStatusConstraints() {
        const m = getMilestoneInputs();
        const minFromDates = resolveFromMilestones(m);
        let firstSelectable = null;

        Array.from(statusSelect.options).forEach(function (opt) {
            const value = parseInt(opt.value, 10);
            const allowed = isStatusSelectable(value, m);
            opt.disabled = !allowed;
            if (allowed && firstSelectable === null) firstSelectable = value;
        });

        const current = parseInt(statusSelect.value, 10) || Booked;
        if (current < minFromDates && isStatusSelectable(minFromDates, m)) {
            statusSelect.value = String(minFromDates);
        } else if (!isStatusSelectable(current, m)) {
            const fallback = isStatusSelectable(minFromDates, m) ? minFromDates : firstSelectable;
            if (fallback !== null) statusSelect.value = String(fallback);
        }
    }

    const hasInvoiceFile = @(string.IsNullOrWhiteSpace(Model.InvoicePath) ? "false" : "true");
    const hasInsuranceFile = @(string.IsNullOrWhiteSpace(Model.InsurancePath) ? "false" : "true");

    function isReplacingInvoice() {
        return document.getElementById('replaceInvoice')?.value === 'true';
    }

    function invoiceFileOnRecord() {
        return hasInvoiceFile && !isReplacingInvoice();
    }

    function applyConditionalRequirements() {
        const invoiceDate = document.getElementById('invoiceDate')?.value || '';
        const insuranceDate = document.getElementById('insuranceDate')?.value || '';
        const registrationDate = document.getElementById('registrationDate')?.value || '';
        const invoiceFile = document.getElementById('invoiceFile');
        const insuranceFile = document.getElementById('insuranceFile');
        const rtoNumber = document.getElementById('rtoNumber');

        if (invoiceFile) invoiceFile.required = isReplacingInvoice() || (!!invoiceDate && !invoiceFileOnRecord());
        if (insuranceFile) insuranceFile.required = !!insuranceDate && !hasInsuranceFile;
        if (rtoNumber) rtoNumber.required = !!registrationDate;
    }

    function validateConditionalRequirements() {
        applyConditionalRequirements();
        const invoiceDate = document.getElementById('invoiceDate')?.value || '';
        const insuranceDate = document.getElementById('insuranceDate')?.value || '';
        const registrationDate = document.getElementById('registrationDate')?.value || '';
        const invoiceFile = document.getElementById('invoiceFile');
        const insuranceFile = document.getElementById('insuranceFile');
        const rtoNumber = document.getElementById('rtoNumber')?.value?.trim() || '';
        const hasNewInvoice = invoiceFile && invoiceFile.files && invoiceFile.files.length > 0;

        if (isReplacingInvoice() && !hasNewInvoice)
            return 'Upload a new invoice and click Save. The current invoice is removed only after Save.';
        if (invoiceDate && !invoiceFileOnRecord() && !hasNewInvoice)
            return 'Invoice document is required when Invoice date is set.';
        if (insuranceDate && !hasInsuranceFile && (!insuranceFile || !insuranceFile.files || insuranceFile.files.length === 0))
            return 'Insurance document is required when Insurance date is set.';
        if (registrationDate && !rtoNumber)
            return 'RTO Number is required when Registration date is set.';
        return null;
    }

    document.querySelectorAll('.milestone-input, .manage-doc-input').forEach(function (el) {
        el.addEventListener('change', function () {
            refreshMilestoneDateConstraints();
            applyStatusConstraints();
            applyConditionalRequirements();
        });
        el.addEventListener('input', function () {
            refreshMilestoneDateConstraints();
            applyStatusConstraints();
            applyConditionalRequirements();
        });
    });

    statusSelect.addEventListener('change', function () {
        const m = getMilestoneInputs();
        const selected = parseInt(statusSelect.value, 10);
        if (!isStatusSelectable(selected, m)) {
            applyStatusConstraints();
            alert('Selected status does not match the entered milestone dates. Choose a status at or after the latest date stage.');
        }
    });

    staffForm.addEventListener('submit', async function (e) {
        refreshMilestoneDateConstraints();
        const conditionalError = validateConditionalRequirements();
        if (conditionalError) {
            e.preventDefault();
            alert(conditionalError);
            return;
        }

        const m = getMilestoneInputs();
        const selected = parseInt(statusSelect.value, 10);
        if (!isStatusSelectable(selected, m)) {
            e.preventDefault();
            applyStatusConstraints();
            alert('Status cannot be earlier than the latest milestone date entered. Clear later dates or pick a matching status.');
            return;
        }

        if (staffForm.dataset.priceConfirmed === 'true') return;

        const invoiceInput = document.getElementById('invoiceDate');
        const invoiceDate = invoiceInput?.value || '';
        const previousInvoice = '@(Model.InvoiceDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")';
        if (!invoiceDate || invoiceDate === previousInvoice) return;

        e.preventDefault();
        try {
            const previewUrl = '@Url.Action("InvoicePricePreview", new { id = Model.VehicleBookingId })'
                + '&invoiceDate=' + encodeURIComponent(invoiceDate);
            const res = await fetch(previewUrl, { krsNoLoader: true });
            const data = await res.json();
            if (!data.success) {
                alert(data.message || 'Could not verify catalogue price for the invoice date.');
                return;
            }
            if (data.wouldChange) {
                const current = Number(data.currentPrice).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const next = Number(data.catalogPrice).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const ok = confirm('Earlier price is ₹' + current + ' and now it changed to ₹' + next + '.\n\nApply this adjustment to the dealer account?');
                if (!ok) return;
                document.getElementById('confirmPriceAdjustment').value = 'true';
            }
            staffForm.dataset.priceConfirmed = 'true';
            staffForm.submit();
        } catch (err) {
            alert('Could not verify invoice price. Please try again.');
        }
    });

    applyStatusConstraints();
    applyConditionalRequirements();
})();
</script>
}
