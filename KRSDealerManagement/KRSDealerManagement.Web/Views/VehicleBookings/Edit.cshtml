@model KRSDealerManagement.Domain.Entities.VehicleBooking
@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Edit Booking";
    var vehicle = ViewBag.Vehicle as VehicleDto;
    ViewBag.Booking = Model;
    ViewBag.HasGstCertificate = !string.IsNullOrWhiteSpace(Model.GstCertificatePath);
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-pencil-square"></i> Edit Booking</h1>
        <p class="text-muted">@vehicle?.ModelName · @vehicle?.ColorName · <strong>@vehicle?.ChassisNumber</strong></p>
        <p class="text-warning small mb-0"><i class="bi bi-info-circle"></i>
            @if (ViewBag.IsAdminEdit == true)
            {
                @:Admin can edit customer and booking details and replace uploaded documents at any time. Leave file fields empty to keep existing uploads.
            }
            else
            {
                @:You can edit customer and booking details until the vehicle is invoiced. Leave file fields empty to keep existing uploads.
            }
        </p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Manage", new { id = Model.VehicleBookingId })" class="btn btn-secondary">Back to Booking</a>
    </div>
</div>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <partial name="_BookingCustomerFormFields" />

    <div class="card mb-3">
        <div class="card-body">
            <label class="fw-bold">Reason for change (optional)</label>
            <input name="editReason" class="form-control" placeholder="e.g. Customer mobile number corrected" maxlength="500" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check-circle"></i> Save Changes</button>
</form>

@section Scripts {
    <partial name="_BookingFormScripts" />
}
