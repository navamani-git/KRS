@model KRSDealerManagement.Application.DTOs.VehicleModelDto
@{
    ViewData["Title"] = "Vehicle Model Details";
}

<!-- Page Header -->
<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-car-front"></i> @Model.ModelName</h1>
        <p class="text-muted">Vehicle model details and information</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.EAction(QueryCrypto, "Edit", new { id = Model.ModelId })" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-info-circle"></i> Model Details</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <td width="40%"><strong>Model ID</strong></td>
                        <td>@Model.ModelId</td>
                    </tr>
                    <tr>
                        <td><strong>Model Name</strong></td>
                        <td><strong>@Model.ModelName</strong></td>
                    </tr>
                    <tr>
                        <td><strong>Description</strong></td>
                        <td>@(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</td>
                    </tr>
                    <tr>
                        <td><strong>Available Colors</strong></td>
                        <td>
                            @if (Model.MappedColors.Any())
                            {
                                @foreach (var color in Model.MappedColors)
                                {
                                    <span class="badge bg-info text-dark me-1 mb-1">@color.ColorName</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">None mapped yet</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Status</strong></td>
                        <td>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Created Date</strong></td>
                        <td>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                    <tr>
                        <td><strong>Last Modified</strong></td>
                        <td>@Model.ModifiedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-lightning"></i> Quick Actions</h3>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @if (Model.MappedColors.Any())
                    {
                        <div class="mb-2">
                            @foreach (var color in Model.MappedColors)
                            {
                                <span class="badge bg-secondary me-1 mb-1">
                                    @if (!string.IsNullOrEmpty(color.HexCode))
                                    {
                                        <span style="display:inline-block; width:10px; height:10px; background:@color.HexCode; border-radius:50%;"></span>
                                    }
                                    @color.ColorName
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2 mb-2">
                            No colors mapped. <a href="@Url.EAction(QueryCrypto, "Edit", new { id = Model.ModelId })">Edit model</a> to assign colors.
                        </div>
                    }
                    <a href="@QueryStringUrlHelper.EncryptedAction(Url, QueryCrypto, "Index", new { modelId = Model.ModelId }, "Prices")" class="btn btn-success">
                        <i class="bi bi-currency-rupee"></i> Manage Prices for @Model.ModelName
                    </a>
                    <a href="@Url.EAction(QueryCrypto, "Edit", new { id = Model.ModelId })" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit This Model
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
