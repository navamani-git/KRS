@model IEnumerable<KRSDealerManagement.Application.DTOs.VehicleModelDto>
@{
    ViewData["Title"] = "Vehicle Models";
    var searchTerm = ViewBag.SearchTerm as string;
    var isActive = ViewBag.IsActive as bool?;
}

<!-- Page Header -->
<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0">
            <i class="bi bi-car-front"></i> Vehicle Models
        </h1>
        <p class="text-muted">Manage Ampere e-scooter models (e.g., Nexus EX, Magnus Pro)</p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Model
        </a>
    </div>
</div>

<!-- Search and Filter -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <form method="get" asp-action="Index">
                    <div class="row">
                        <div class="col-md-4">
                            <input type="text" name="searchTerm" class="form-control" placeholder="Search by model name..."
                                   value="@searchTerm" />
                        </div>
                        <div class="col-md-3">
                            <select name="isActive" class="form-select">
                                <option value="">All Status</option>
                                <option value="true" selected="@(isActive == true)">Active</option>
                                <option value="false" selected="@(isActive == false)">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search"></i> Search
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="bi bi-arrow-clockwise"></i> Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Vehicle Models Table -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-list"></i> All Vehicle Models (@Model.Count())
                </h3>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Model Name</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vm in Model)
                                {
                                    <tr>
                                        <td>@vm.ModelId</td>
                                        <td>
                                            <strong>@vm.ModelName</strong>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(vm.Description))
                                            {
                                                <span>@(vm.Description.Length > 50 ? vm.Description.Substring(0, 50) + "..." : vm.Description)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (vm.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @vm.CreatedDate.ToString("yyyy-MM-dd")
                                            </small>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="@Url.EAction(QueryCrypto, "Details", new { id = vm.ModelId })"
                                                   class="btn btn-info" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                @{
                                                    ViewData["CrudId"] = vm.ModelId;
                                                    ViewData["CrudController"] = "VehicleModels";
                                                    ViewData["CrudEncrypted"] = true;
                                                }
                                                <partial name="_CrudActions" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> No vehicle models found. 
                        <a href="@Url.Action("Create")">Click here to add your first model.</a>
                    </div>
                }
                <partial name="_Pagination" />
            </div>
        </div>
    </div>
</div>
