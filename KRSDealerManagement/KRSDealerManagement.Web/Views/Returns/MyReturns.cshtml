@model IEnumerable<KRSDealerManagement.Application.DTOs.ReturnRequestDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Domain.Entities
@using KRSDealerManagement.Shared.Constants
@using KRSDealerManagement.Web.Helpers
@{
    ViewData["Title"] = "My Returns";
    ViewData["ExportAction"] = "ExportMyReturns";
    var statuses = ViewBag.Statuses as IEnumerable<StatusLookup> ?? Enumerable.Empty<StatusLookup>();
    var statusOptions = StatusViewHelper.ToSelectList(statuses, ViewBag.SelectedStatus as int?, "All");
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-arrow-return-left"></i> My Returns</h1>
        <p class="text-muted">Track return requests, approval status, and refund credits to your account</p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
        <a href="@Url.Action("Index", "Vehicles")" class="btn btn-outline-primary">
            <i class="bi bi-ev-front"></i> My Vehicles
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">From</label>
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">To</label>
                <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Status</label>
                <select name="status" class="form-select form-select-sm" asp-items="statusOptions">
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter"></i> Filter</button>
                <a href="@Url.Action("MyReturns")" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
            <div class="col-md-2">
                <span class="badge bg-warning text-dark">Pending: @(ViewBag.PendingCount ?? 0)</span>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Return History (@(ViewBag.TotalItems ?? Model.Count()))</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover table-sm">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Request</th>
                            <th>Order</th>
                            <th>Chassis</th>
                            <th>Account</th>
                            <th class="text-end">Refund (₹)</th>
                            <th>Status</th>
                            <th>Reason</th>
                            <th>Requested</th>
                            <th>Processed</th>
                            <th>Refund Credited</th>
                            <th>Admin Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sr = 1; }
                        @foreach (var r in Model)
                        {
                            <tr class="@(r.Status == UnifiedVehicleStatus.ReturnRequested ? "table-warning bg-opacity-25" : "")">
                                <td>@(sr++)</td>
                                <td>#@r.ReturnRequestId</td>
                                <td><small>@r.OrderNumber</small></td>
                                <td><code class="small">@r.VehicleChassisNumber</code></td>
                                <td><small>@r.AccountName</small></td>
                                <td class="text-end fw-bold">₹@r.RefundAmount.ToString("N2")</td>
                                <td><span class="badge @r.GetBadgeClass()">@r.GetStatusDisplay()</span></td>
                                <td><small>@r.ReturnReason</small></td>
                                <td><small>@r.CreatedDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                <td>
                                    @if (r.ProcessedDate.HasValue)
                                    {
                                        <small>@r.ProcessedDate.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (r.RefundCreditedDate.HasValue)
                                    {
                                        <small class="text-success fw-semibold">@r.RefundCreditedDate.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else if (r.Status == UnifiedVehicleStatus.ReturnApproved)
                                    {
                                        <span class="text-muted">Pending credit</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><small class="text-muted">@(r.AdminRemarks ?? "—")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle"></i> No return requests found.
                You can request a return from <a href="@Url.Action("Index", "Vehicles")">My Vehicles</a> for approved vehicles that are not yet booked.
            </div>
        }
        <partial name="_Pagination" />
    </div>
</div>
