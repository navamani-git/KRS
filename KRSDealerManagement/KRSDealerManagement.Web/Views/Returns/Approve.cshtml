@using System.Globalization

@model KRSDealerManagement.Application.DTOs.ReturnRequestDto

@{

    ViewData["Title"] = $"Approve Return #{Model.ReturnRequestId}";

}



<div class="row mb-3">

    <div class="col-md-8">

        <h1 class="m-0"><i class="bi bi-check-circle text-success"></i> Approve Return #@Model.ReturnRequestId</h1>

        <p class="text-muted mb-0">@(Model.SubdealerName ?? Model.AccountName) · @Model.VehicleChassisNumber · Order @Model.OrderNumber</p>

        <p class="text-muted mb-0"><small>Requested @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</small></p>

    </div>

    <div class="col-md-4 text-end">

        <a href="@Url.Action("Index")" class="btn btn-secondary">Back to list</a>

    </div>

</div>



<div class="card">

    <form method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.ReturnRequestId" />

        <div class="card-body">

            <p>Approving will <strong class="text-success">credit</strong> @Model.AccountName and return the vehicle to <strong>@Model.DealershipLocation</strong> showroom stock.</p>



            <div class="mb-3">

                <label class="fw-bold">Refund amount (₹) <span class="text-danger">*</span></label>

                <div class="input-group" style="max-width: 280px;">

                    <span class="input-group-text">₹</span>

                    <input type="number" name="refundAmount" class="form-control"

                           step="0.01" min="0.01" required

                           value="@Model.RefundAmount.ToString(CultureInfo.InvariantCulture)" />

                </div>

            </div>



            <div class="mb-3">

                <label class="fw-bold">Vehicle destination</label>

                <p class="mb-0 text-muted">@Model.DealershipLocation showroom stock</p>

            </div>



            <div class="mb-0">

                <label class="fw-bold">Remarks <span class="text-danger">*</span></label>

                <textarea name="remarks" class="form-control" rows="3" required

                          placeholder="Enter approval remarks..."></textarea>

            </div>

        </div>

        <div class="card-footer">

            <button type="submit" class="btn btn-success">

                <i class="bi bi-check-circle"></i> Approve &amp; Credit

            </button>

            <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Cancel</a>

        </div>

    </form>

</div>



