@using System.Globalization
@model IEnumerable<KRSDealerManagement.Application.DTOs.ReturnRequestDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Domain.Entities
@using KRSDealerManagement.Shared.Constants
@using KRSDealerManagement.Web.Helpers
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "Return Requests";
    var statuses = ViewBag.Statuses as IEnumerable<StatusLookup> ?? Enumerable.Empty<StatusLookup>();
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-arrow-return-left"></i> Return Requests</h1>
        <p class="text-muted">Review and process vehicle return requests</p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end" id="gridFilterForm">
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Status</label>
                <select name="status" class="form-select form-select-sm" asp-items="StatusViewHelper.ToSelectList(statuses, ViewBag.SelectedStatus as int?)">
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter"></i> Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
            <div class="col-md-3">
                <span class="badge bg-warning text-dark">Pending: @(ViewBag.PendingCount ?? 0)</span>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Return Requests (@(ViewBag.TotalItems ?? Model.Count()))</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <partial name="_GridScrollHint" />
            <div class="table-responsive">
                <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@GridIds.Returns">
                    <thead class="table-dark">
                        <tr>
                            <th class="grid-col-rownum">#</th>
                            <th>Account</th>
                            <th>Order</th>
                            <th>Vehicle</th>
                            <th class="text-end">Refund (₹)</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Requested</th>
                            <th>Processed</th>
                            <th>Actions</th>
                        </tr>
                        <partial name="_PaginatedGridFilters" />
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var badgeClass = r.GetBadgeClass();
                            <tr class="@(r.Status == UnifiedVehicleStatus.ReturnRequested ? "table-warning bg-opacity-25" : "")">
                                <td>@r.ReturnRequestId</td>
                                <td>@r.AccountName</td>
                                <td><small>@r.OrderNumber</small></td>
                                <td>
                                    <partial name="_ChassisLink" view-data='new ViewDataDictionary(ViewData) {
                                        { "VehicleId", r.VehicleId }, { "Chassis", r.VehicleChassisNumber }, { "ChassisCodeClass", "small" } }' />
                                </td>
                                <td class="text-end fw-bold">
                                    @if (r.CanBeApproved())
                                    {
                                        <span title="Suggested — admin sets final amount on approval">₹@r.RefundAmount.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        @($"₹{r.RefundAmount:N2}")
                                    }
                                </td>
                                <td><small>@r.ReturnReason</small></td>
                                <td><span class="badge @badgeClass">@r.GetStatusDisplay()</span></td>
                                <td><small>@r.CreatedDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                <td>
                                    @if (r.ProcessedDate.HasValue)
                                    {
                                        <small>@r.ProcessedDate.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (r.CanBeApproved())
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "Approve", new { id = r.ReturnRequestId }, "Returns")"
                                           class="btn btn-sm btn-success" title="Approve return">
                                            <i class="bi bi-check-circle"></i>
                                        </a>
                                        <a href="@Url.EAction(QueryCrypto, "Reject", new { id = r.ReturnRequestId }, "Returns")"
                                           class="btn btn-sm btn-danger" title="Reject return">
                                            <i class="bi bi-x-circle"></i>
                                        </a>
                                    }
                                    else if (r.CanAllocateToSubdealer)
                                    {
                                        <a href="@Url.EAction(QueryCrypto, "Allocate", new { id = r.ReturnRequestId }, "Returns")"
                                           class="btn btn-sm btn-primary" title="Allocate to subdealer">
                                            <i class="bi bi-box-seam"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <small class="text-muted">@r.AdminRemarks</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info"><i class="bi bi-info-circle"></i> No return requests found.</div>
        }
        <partial name="_Pagination" />
    </div>
</div>
