@model IEnumerable<KRSDealerManagement.Application.DTOs.StaffUserDto>
@using KRSDealerManagement.Shared.Constants
@using KRSDealerManagement.Shared.Enums
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "Staff Users";
    ViewData["WorkflowPage"] = "users";
    var dealerships = ViewBag.Dealerships as IEnumerable<KRSDealerManagement.Application.Queries.DealershipDto>
        ?? Enumerable.Empty<KRSDealerManagement.Application.Queries.DealershipDto>();
    var filterRoles = ViewBag.Roles as IEnumerable<KRSDealerManagement.Application.DTOs.StaffRoleDto>
        ?? Enumerable.Empty<KRSDealerManagement.Application.DTOs.StaffRoleDto>();
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-person-badge"></i> Staff Users</h1>
        <p class="text-muted">Staff logins assigned to a dealership role</p>
    </div>
    <div class="col-md-6 text-end">
        @if (KRSDealerManagement.Web.Helpers.SessionHelper.CanWriteMenu(Context.Session, StaffMenuAccess.StaffUsers))
        {
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Add Staff User
            </a>
        }
    </div>
</div>

<partial name="_StaffAccessWorkflowHelp" />

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end" id="gridFilterForm">
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Search</label>
                <input type="text" name="searchTerm" class="form-control form-control-sm"
                       placeholder="Name, username, dealership..." value="@ViewBag.SearchTerm" />
            </div>
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-0">Role</label>
                <select name="roleId" class="form-select form-select-sm">
                    <option value="">All Roles</option>
                    @foreach (var r in filterRoles)
                    {
                        <option value="@r.RoleId" selected="@(ViewBag.RoleId?.ToString() == r.RoleId.ToString())">@r.RoleName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">Dealership</label>
                <select name="dealershipId" class="form-select form-select-sm">
                    <option value="">All Locations</option>
                    @foreach (var d in dealerships)
                    {
                        <option value="@d.DealershipId" selected="@(ViewBag.DealershipId?.ToString() == d.DealershipId.ToString())">
                            @d.DealershipName
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label form-label-sm mb-0">Status</label>
                <select name="isActive" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="true" selected="@(ViewBag.IsActive == true)">Active</option>
                    <option value="false" selected="@(ViewBag.IsActive == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter"></i> Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Staff Users (@(ViewBag.TotalItems ?? Model.Count()))</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <partial name="_GridScrollHint" />
            <div class="table-responsive">
                <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@GridIds.StaffUsers">
                    <thead class="table-dark">
                        <tr>
                            <th class="grid-col-rownum">#</th>
                            <th>Name</th>
                            <th>Role</th>
                            <th>Dealership</th>
                            <th>Username</th>
                            <th>Phone</th>
                            <th>Password</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                        <partial name="_PaginatedGridFilters" />
                    </thead>
                    <tbody>
                        @{ int sr = 1; }
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td>@(sr++)</td>
                                <td><strong>@u.FullName</strong></td>
                                <td>
                                    <span class="badge @(u.UserRole == 3 ? "bg-info" : "bg-primary")">@u.RoleName</span>
                                </td>
                                <td><small>@(u.DealershipName ?? "-")</small></td>
                                <td><code>@u.Username</code></td>
                                <td><small>@(u.PhoneNumber ?? "-")</small></td>
                                <td>
                                    @if (u.CanRevealPassword())
                                    {
                                        <code class="small">@u.PasswordHash</code>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Set by admin</small>
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td><small>@u.CreatedDate.ToString("yyyy-MM-dd")</small></td>
                                <td>
                                    @{ ViewData["CrudId"] = u.UserId; ViewData["CrudController"] = "StaffUsers"; }
                                    <partial name="_CrudActions" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle"></i> No staff users found.
                <a href="@Url.Action("Create")">Add Finance Admin or Branch Manager</a>.
            </div>
        }
        <partial name="_Pagination" />
    </div>
</div>
