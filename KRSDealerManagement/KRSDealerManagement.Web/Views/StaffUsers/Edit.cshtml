@model KRSDealerManagement.Application.DTOs.StaffUserDto
@{
    ViewData["Title"] = "Edit Staff User";
    var dealerships = ViewBag.Dealerships as IEnumerable<KRSDealerManagement.Application.Queries.DealershipDto>
        ?? Enumerable.Empty<KRSDealerManagement.Application.Queries.DealershipDto>();
    var roles = ViewBag.Roles as IEnumerable<KRSDealerManagement.Application.DTOs.StaffRoleDto>
        ?? Enumerable.Empty<KRSDealerManagement.Application.DTOs.StaffRoleDto>();
}

<div class="row mb-3">
    <div class="col-md-8"><h1 class="m-0">Edit Staff User</h1></div>
    <div class="col-md-4 text-end"><a href="@Url.Action("Index")" class="btn btn-secondary">Back</a></div>
</div>

<div class="card">
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.UserId" />
        <div class="card-body">
            <div class="mb-3">
                <label class="fw-bold">Full Name <span class="text-danger">*</span></label>
                <input name="fullName" class="form-control" value="@Model.FullName" required />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Username <span class="text-danger">*</span></label>
                <input name="username" class="form-control" value="@Model.Username" required autocomplete="off" />
                <small class="text-muted">Lowercase, no spaces. Must be unique across all users.</small>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Dealership</label>
                <select name="dealershipId" id="dealershipId" class="form-select" required>
                    @foreach (var d in dealerships)
                    {
                        <option value="@d.DealershipId" selected="@(Model.DealershipId == d.DealershipId)">@d.DealershipName</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Role</label>
                <select name="roleId" id="roleId" class="form-select" required>
                    @foreach (var r in roles)
                    {
                        <option value="@r.RoleId" data-dealership="@r.DealershipId" selected="@(Model.RoleId == r.RoleId)">@r.RoleName</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Email</label>
                <input name="email" type="email" class="form-control" value="@Model.Email" />
            </div>
            <div class="mb-3">
                <label class="fw-bold">Phone</label>
                <input name="phoneNumber" class="form-control" value="@Model.PhoneNumber" />
            </div>
            <div class="mb-3">
                <label class="fw-bold">New Password</label>
                <input name="password" type="text" class="form-control" placeholder="Leave blank to keep current" />
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="isActive">Active</label>
            </div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Save</button></div>
    </form>
</div>

@section Scripts {
<script>
    const dealershipSelect = document.getElementById('dealershipId');
    const roleSelect = document.getElementById('roleId');
    function filterRoles() {
        const dealerId = dealershipSelect.value;
        [...roleSelect.options].forEach(opt => {
            if (!opt.value) return;
            opt.hidden = dealerId && opt.dataset.dealership !== dealerId;
        });
        if (roleSelect.selectedOptions[0]?.hidden) roleSelect.value = '';
    }
    dealershipSelect.addEventListener('change', filterRoles);
    filterRoles();
</script>
}
