@{
    ViewData["Title"] = "Add Finance Name";
}

<div class="row mb-3">
    <div class="col-md-8"><h1 class="m-0">Add Finance Name</h1></div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="card card-primary" style="max-width:520px">
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <label class="fw-bold">Finance Name <span class="text-danger">*</span></label>
            <input name="financeName" class="form-control text-uppercase" style="text-transform:uppercase"
                   oninput="this.value=this.value.toUpperCase()" required placeholder="e.g. AMPERE EASY FINANCE" />
            <small class="text-muted">Stored in CAPS</small>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>
