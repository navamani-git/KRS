@model IEnumerable<KRSDealerManagement.Domain.Entities.FinanceNameMaster>
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "Finance Names";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-bank"></i> Finance Names</h1>
        <p class="text-muted">Ampere showroom finance options for payment dropdown</p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add Finance Name</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <form method="get" id="gridFilterForm" class="d-none" aria-hidden="true"></form>
        <partial name="_GridScrollHint" />
        <div class="table-responsive">
            <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@GridIds.FinanceNames">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Finance Name</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
                <partial name="_PaginatedGridFilters" />
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td><strong>@f.FinanceName</strong></td>
                        <td><span class="badge @(f.IsActive ? "bg-success" : "bg-secondary")">@(f.IsActive ? "Active" : "Inactive")</span></td>
                        <td><small>@f.CreatedDate.ToString("yyyy-MM-dd")</small></td>
                        <td>
                            @{
                                ViewData["CrudId"] = f.FinanceNameId;
                                ViewData["CrudController"] = "FinanceNames";
                            }
                            <partial name="_CrudActions" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        @if (!Model.Any())
        {
            <div class="p-3 text-muted">No finance names yet. <a href="@Url.Action("Create")">Add one</a>.</div>
        }
        <div class="p-3">
            <partial name="_Pagination" />
        </div>
    </div>
</div>
