@model KRSDealerManagement.Application.DTOs.AdminNotificationDetailDto
@using KRSDealerManagement.Shared.Helpers
@{
    ViewData["Title"] = Model.Title;
    var createdAt = IstTime.ToIst(Model.CreatedDate);
    var modifiedAt = IstTime.ToIst(Model.ModifiedDate);
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-bell"></i> @Model.Title</h1>
        <p class="text-muted">
            @Model.LocationSummary · @(createdAt?.ToString("dd-MMM-yyyy HH:mm") ?? "—")
            @if (!Model.IsActive)
            {
                <span class="badge bg-secondary ms-1">Deleted</span>
            }
        </p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
        @if (Model.IsActive)
        {
            <a href="@Url.Action("Edit", new { id = Model.NotificationId })" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-3">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Message</h3>
            </div>
            <div class="card-body">
                <div class="notification-body">@Model.Body</div>
                <hr />
                <small class="text-muted">
                    Created by @Model.CreatedByName
                    @if (modifiedAt.HasValue && !string.IsNullOrWhiteSpace(Model.ModifiedByName))
                    {
                        <span> · Last updated by @Model.ModifiedByName on @modifiedAt.Value.ToString("dd-MMM-yyyy HH:mm")</span>
                    }
                </small>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Delivery summary</h5>
                <p class="mb-1"><strong>Recipients:</strong> @Model.RecipientCount</p>
                <p class="mb-0"><strong>Read:</strong> @Model.ReadCount / @Model.RecipientCount</p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Recipients</h3>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Subdealer</th>
                        <th>Location</th>
                        <th>Read</th>
                        <th>Read date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Recipients)
                    {
                        var readAt = IstTime.ToIst(r.ReadDate);
                        <tr>
                            <td>@r.UserName</td>
                            <td>@r.SubDealerName</td>
                            <td>@r.DealershipName</td>
                            <td>
                                <span class="badge @(r.IsRead ? "bg-success" : "bg-warning text-dark")">
                                    @(r.IsRead ? "Yes" : "No")
                                </span>
                            </td>
                            <td><small>@(readAt?.ToString("dd-MMM-yyyy HH:mm") ?? "—")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Recipients.Any())
        {
            <div class="p-3 text-muted">No recipients.</div>
        }
    </div>
</div>

<style>
    .notification-body { white-space: pre-wrap; }
</style>
