@model KRSDealerManagement.Application.DTOs.SubdealerDetailDto
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Application.Queries
@using KRSDealerManagement.Shared.Constants
@{
    ViewData["Title"] = "Subdealer Details";
    var accounts = ViewBag.Accounts as IEnumerable<SubdealerAccountDto> ?? new List<SubdealerAccountDto>();
    var accountId = ViewBag.AccountId as int? ?? 0;
    var dealerships = ViewBag.Dealerships as IEnumerable<DealershipDto> ?? Enumerable.Empty<DealershipDto>();
    var lockedId = ViewBag.LockedDealershipId as int?;
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-person"></i> @Model.SubdealerName</h1>
        <p class="text-muted">@Model.Location &nbsp;|&nbsp; @Model.PrimaryPhone</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title mb-0">Edit Subdealer</h3></div>
            <form method="post" asp-action="Update">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />
                <div class="card-body">
                    <div class="form-group mb-2">
                        <label class="form-label fw-bold">Username <span class="text-danger">*</span></label>
                        <input type="text" name="username" class="form-control" value="@Model.Username" required />
                    </div>
                    <div class="form-group mb-2">
                        <label class="form-label fw-bold">Subdealer Name <span class="text-danger">*</span></label>
                        <input type="text" name="subdealerName" class="form-control" value="@Model.SubdealerName" required />
                    </div>
                    <div class="form-group mb-2">
                        <label class="form-label fw-bold">Location <span class="text-danger">*</span></label>
                        <input type="text" name="location" class="form-control" value="@Model.Location" required />
                    </div>
                    <div class="form-group mb-2">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" name="email" class="form-control" value="@Model.Email" />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label fw-bold">Primary Phone <span class="text-danger">*</span></label>
                                <input type="tel" name="primaryPhone" class="form-control" value="@Model.PrimaryPhone" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label fw-bold">Secondary Phone</label>
                                <input type="tel" name="secondaryPhone" class="form-control" value="@Model.SecondaryPhone" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label fw-bold">Sales Rep Mobile</label>
                                <input type="tel" name="salesRepMobile" class="form-control" value="@Model.SalesRepMobile" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label fw-bold">Service Rep Mobile</label>
                                <input type="tel" name="serviceRepMobile" class="form-control" value="@Model.ServiceRepMobile" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-2">
                        <label class="form-label fw-bold">Dealership</label>
                        @if (lockedId.HasValue)
                        {
                            <input type="hidden" name="dealershipId" value="@lockedId.Value" />
                            <input type="text" class="form-control" value="@Model.DealershipName" readonly />
                        }
                        else
                        {
                            <select name="dealershipId" class="form-select" required>
                                @foreach (var d in dealerships)
                                {
                                    <option value="@d.DealershipId" selected="@(d.DealershipId == Model.DealershipId)">@d.DealershipName</option>
                                }
                            </select>
                        }
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActive" @(Model.IsActive ? "checked" : null) />
                        <label class="form-check-label" for="isActive">Active</label>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label fw-bold">Current Password</label>
                        @if (Model.CanRevealPassword())
                        {
                            <div class="input-group input-group-sm">
                                <input type="password" class="form-control" id="revealPwd" value="@Model.PasswordHash" readonly />
                                <button type="button" class="btn btn-outline-secondary" id="btnRevealPwd" title="Show / hide">
                                    <i class="bi bi-eye" id="revealPwdIcon"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Hashed — set a new password below to make it viewable</span>
                        }
                    </div>
                    <small class="text-muted">User ID: @Model.UserId · Created @Model.CreatedDate.ToString("yyyy-MM-dd")</small>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Save Details
                    </button>
                </div>
            </form>
        </div>

        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title mb-0">Set / Reset Password</h3></div>
            <form method="post" asp-action="SetPassword">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />
                <div class="card-body">
                    <div class="input-group">
                        <input type="password" name="password" id="newPwd" class="form-control"
                               placeholder="New password (min 6)" required minlength="6" />
                        <button type="button" class="btn btn-outline-secondary" id="toggleNewPwd" title="Show / hide">
                            <i class="bi bi-eye" id="toggleNewPwdIcon"></i>
                        </button>
                        <button type="submit" class="btn btn-warning">Update</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title mb-0">Balance</h3></div>
            <div class="card-body p-0">
                @{
                    var primary = accounts.FirstOrDefault(a =>
                        string.Equals(a.AccountType, "Main", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(a.AccountName, "Main Account", StringComparison.OrdinalIgnoreCase))
                        ?? accounts.FirstOrDefault();
                }
                @if (primary != null)
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-end">Balance (₹)</th>
                                <th class="text-end">Available (₹)</th>
                                <th class="text-end">Reserved (₹)</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-end">@primary.CurrentBalance.ToString("N2")</td>
                                <td class="text-end text-success fw-bold">@primary.AvailableBalance.ToString("N2")</td>
                                <td class="text-end text-warning">@primary.ReservedAmount.ToString("N2")</td>
                                <td>
                                    <a href="@Url.EAction(QueryCrypto, "Statement", new { id = primary.AccountId }, "Accounts")"
                                       class="btn btn-sm btn-info"><i class="bi bi-file-text"></i> Statement</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3"><div class="alert alert-warning mb-0">No balance found.</div></div>
                }
            </div>
        </div>

        @if (accountId > 0)
        {
            <div class="card">
                <div class="card-header"><h3 class="card-title mb-0">Menu Access (Parent → Sub-menu)</h3></div>
                <form method="post" asp-action="ConfigurePermissions">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <input type="hidden" name="accountId" value="@accountId" />
                    <div class="card-body">
                        <partial name="_MenuPermissionGroups" />
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-shield-check"></i> Save Permissions
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function wireToggle(btnId, inputId, iconId) {
        const btn = document.getElementById(btnId);
        if (!btn) return;
        btn.addEventListener('click', function () {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
    }
    wireToggle('btnRevealPwd', 'revealPwd', 'revealPwdIcon');
    wireToggle('toggleNewPwd', 'newPwd', 'toggleNewPwdIcon');
</script>
}
