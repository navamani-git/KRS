@model KRSDealerManagement.Application.DTOs.SubdealerDetailDto
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Application.Queries
@using KRSDealerManagement.Shared.Constants
@{
    ViewData["Title"] = "Subdealer Details";
    var accounts = ViewBag.Accounts as IEnumerable<SubdealerAccountDto> ?? new List<SubdealerAccountDto>();
    var dealerships = ViewBag.Dealerships as IEnumerable<DealershipDto> ?? Enumerable.Empty<DealershipDto>();
    var lockedId = ViewBag.LockedDealershipId as int?;
    var canViewBalances = ViewBag.CanViewBalances as bool? ?? false;
    var canViewStatement = ViewBag.CanViewStatement as bool? ?? false;
    var primary = accounts.FirstOrDefault(a =>
        string.Equals(a.AccountType, "Main", StringComparison.OrdinalIgnoreCase)
        || string.Equals(a.AccountName, "Main Account", StringComparison.OrdinalIgnoreCase))
        ?? accounts.FirstOrDefault();
    var isFirstLogin = !Model.Logins.Any();
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-building"></i> @Model.SubdealerName</h1>
        <p class="text-muted">@Model.Location &nbsp;|&nbsp; @Model.PrimaryPhone &nbsp;|&nbsp; @Model.Logins.Count login(s)</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title mb-0">Business Details</h3></div>
            <form method="post" asp-action="Update">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.SubDealerId" />
                <div class="card-body">
                    <div class="form-group mb-2">
                        <label class="form-label fw-bold">Subdealer Name <span class="text-danger">*</span></label>
                        <input type="text" name="subdealerName" class="form-control" value="@Model.SubdealerName" required />
                    </div>
                    <div class="form-group mb-2">
                        <label class="form-label fw-bold">Location <span class="text-danger">*</span></label>
                        <input type="text" name="location" class="form-control" value="@Model.Location" required />
                    </div>
                    <div class="form-group mb-2">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" name="email" class="form-control" value="@Model.Email" />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label fw-bold">Primary Phone <span class="text-danger">*</span></label>
                                <input type="tel" name="primaryPhone" class="form-control" value="@Model.PrimaryPhone" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label fw-bold">Secondary Phone</label>
                                <input type="tel" name="secondaryPhone" class="form-control" value="@Model.SecondaryPhone" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label fw-bold">Sales Rep Mobile</label>
                                <input type="tel" name="salesRepMobile" class="form-control" value="@Model.SalesRepMobile" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label class="form-label fw-bold">Service Rep Mobile</label>
                                <input type="tel" name="serviceRepMobile" class="form-control" value="@Model.ServiceRepMobile" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-2">
                        <label class="form-label fw-bold">Dealership</label>
                        @if (lockedId.HasValue)
                        {
                            <input type="hidden" name="dealershipId" value="@lockedId.Value" />
                            <input type="text" class="form-control" value="@Model.DealershipName" readonly />
                        }
                        else
                        {
                            <select name="dealershipId" class="form-select" required>
                                @foreach (var d in dealerships)
                                {
                                    <option value="@d.DealershipId" selected="@(d.DealershipId == Model.DealershipId)">@d.DealershipName</option>
                                }
                            </select>
                        }
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActive" @(Model.IsActive ? "checked" : null) />
                        <label class="form-check-label" for="isActive">Active</label>
                    </div>
                    <small class="text-muted">Org ID: @Model.SubDealerId · Created @Model.CreatedDate.ToString("yyyy-MM-dd")</small>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Save Details
                    </button>
                </div>
            </form>
        </div>

        @if (canViewBalances && primary != null)
        {
        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title mb-0">Shared Wallet Balance</h3></div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-end">Balance (₹)</th>
                            <th class="text-end">Available (₹)</th>
                            <th class="text-end">Reserved (₹)</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-end">@primary.CurrentBalance.ToString("N2")</td>
                            <td class="text-end text-success fw-bold">@primary.AvailableBalance.ToString("N2")</td>
                            <td class="text-end text-warning">@primary.ReservedAmount.ToString("N2")</td>
                            <td>
                                <a href="@Url.EAction(QueryCrypto, "Statement", new { id = primary.AccountId }, "Accounts")"
                                   class="btn btn-sm btn-info"><i class="bi bi-file-text"></i> Statement</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        }
        else if (canViewStatement && primary != null)
        {
        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title mb-0">Account Statement</h3></div>
            <div class="card-body">
                <a href="@Url.EAction(QueryCrypto, "Statement", new { id = primary.AccountId }, "Accounts")"
                   class="btn btn-info"><i class="bi bi-file-text"></i> View Account Statement</a>
            </div>
        </div>
        }
    </div>

    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0"><i class="bi bi-people"></i> Logins (@Model.Logins.Count)</h3>
            </div>
            <div class="card-body p-0">
                @if (Model.Logins.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Username</th>
                                    <th>Display</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var login in Model.Logins)
                                {
                                    <tr>
                                        <td><code>@login.Username</code></td>
                                        <td>@login.DisplayName</td>
                                        <td>
                                            @if (login.IsPrimary)
                                            {
                                                <span class="badge bg-primary">Primary</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Login</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(login.IsActive ? "bg-success" : "bg-danger")">
                                                @(login.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="collapse" data-bs-target="#perm-@login.PermissionAccountId">
                                                <i class="bi bi-shield-check"></i> Menus
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-warning"
                                                    data-bs-toggle="collapse" data-bs-target="#pwd-@login.UserId">
                                                <i class="bi bi-key"></i> Password
                                            </button>
                                        </td>
                                    </tr>
                                    <tr class="collapse" id="perm-@login.PermissionAccountId">
                                        <td colspan="5" class="bg-light">
                                            <form method="post" asp-action="ConfigurePermissions">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.SubDealerId" />
                                                <input type="hidden" name="accountId" value="@login.PermissionAccountId" />
                                                <partial name="_LoginPermissionForm" model="login" />
                                            </form>
                                        </td>
                                    </tr>
                                    <tr class="collapse" id="pwd-@login.UserId">
                                        <td colspan="5" class="bg-light">
                                            <form method="post" asp-action="SetPassword" class="p-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.SubDealerId" />
                                                <input type="hidden" name="loginUserId" value="@login.UserId" />
                                                <div class="input-group input-group-sm" style="max-width: 400px;">
                                                    <input type="password" name="password" class="form-control" placeholder="New password (min 6)" required minlength="6" />
                                                    <button type="submit" class="btn btn-warning">Update</button>
                                                </div>
                                                @if (login.CanRevealPassword())
                                                {
                                                    <small class="text-muted d-block mt-1">Current: <code>@login.PasswordHash</code></small>
                                                }
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning m-3 mb-0">
                        <i class="bi bi-exclamation-triangle"></i> No logins yet. Add the first login below to enable access.
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title mb-0"><i class="bi bi-person-plus"></i> Add Login</h3></div>
            <form method="post" asp-action="CreateLogin">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.SubDealerId" />
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Username <span class="text-danger">*</span></label>
                                <input type="text" name="username" class="form-control" placeholder="e.g. kpn_sales" required
                                       pattern="[a-z0-9_\.]+" title="Lowercase letters, numbers, underscore, dot" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Password <span class="text-danger">*</span></label>
                                <input type="password" name="password" id="newLoginPwd" class="form-control" required minlength="6" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Display Name</label>
                                <input type="text" name="displayName" class="form-control" placeholder="e.g. Sales Floor" />
                            </div>
                        </div>
                    </div>

                    @if (canViewBalances && isFirstLogin)
                    {
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Initial Balance (₹) — first login only</label>
                        <div class="input-group" style="max-width: 280px;">
                            <span class="input-group-text">₹</span>
                            <input type="number" name="initialBalance" class="form-control" value="0" min="0" step="0.01" />
                        </div>
                    </div>
                    }
                    else
                    {
                        <input type="hidden" name="initialBalance" value="0" />
                    }

                    <div class="form-group mb-0">
                        <label class="form-label fw-bold">Menu Access</label>
                        <partial name="_MenuPermissionGroups" />
                        <small class="text-muted">Example: check only <strong>View Vehicles</strong> for a sales-only login.</small>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-person-plus"></i> Add Login
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
