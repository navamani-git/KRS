@model IEnumerable<KRSDealerManagement.Application.DTOs.UserDto>
@using KRSDealerManagement.Web.Helpers
@using KRSDealerManagement.Web.Models
@{
    ViewData["Title"] = "Subdealers";
    var isActiveFilter = ViewBag.IsActive as bool?;
    var isBranchManager = ViewBag.IsBranchManager as bool? ?? SessionHelper.IsBranchManager(Context.Session);
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-people"></i> Subdealers</h1>
        <p class="text-muted">Unique businesses — each can have multiple logins with different menu access</p>
    </div>
    <div class="col-md-6 text-end">
        <partial name="_ExportExcel" />
        @if (!isBranchManager)
        {
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Add New Subdealer
            </a>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" id="gridFilterForm">
            <div class="row">
                <div class="col-md-4">
                    <input type="text" name="searchTerm" class="form-control"
                           placeholder="Search by name, phone, email..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <select name="isActive" class="form-select">
                        <option value="">All Status</option>
                        @if (isActiveFilter == true)
                        {
                            <option value="true" selected>Active</option>
                        }
                        else
                        {
                            <option value="true">Active</option>
                        }
                        @if (isActiveFilter == false)
                        {
                            <option value="false" selected>Inactive</option>
                        }
                        else
                        {
                            <option value="false">Inactive</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="bi bi-arrow-clockwise"></i> Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-list"></i> All Subdealers (@(ViewBag.TotalItems ?? Model.Count()))</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <partial name="_GridScrollHint" />
            <div class="table-responsive">
                <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@GridIds.Subdealers">
                    <thead class="table-dark">
                        <tr>
                            <th class="grid-col-narrow">#</th>
                            <th>Subdealer Name</th>
                            <th>Location</th>
                            @if (!isBranchManager)
                            {
                                <th class="grid-col-narrow">Logins</th>
                            }
                            <th>Phone</th>
                            <th class="grid-col-narrow">Status</th>
                            <th class="grid-col-date">Created</th>
                            @if (!isBranchManager)
                            {
                                <th class="grid-col-actions">Actions</th>
                            }
                        </tr>
                        <partial name="_PaginatedGridFilters" />
                    </thead>
                    <tbody>
                        @{int sr = 1;}
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@(sr++)</td>
                                <td>
                                    <strong>@s.GetFullName()</strong>
                                    <br /><small class="text-muted">@s.Email</small>
                                </td>
                                <td>@s.LastName</td>
                                @if (!isBranchManager)
                                {
                                    <td>
                                        <span class="badge bg-info">@s.LoginCount</span>
                                        @if (!string.IsNullOrEmpty(s.Username) && s.Username != "—")
                                        {
                                            <br /><small class="text-muted"><code>@s.Username</code></small>
                                        }
                                    </td>
                                }
                                <td>@s.PhoneNumber</td>
                                <td>
                                    <span class="badge @(s.IsActive ? "bg-success" : "bg-danger")">
                                        @(s.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td><small>@s.CreatedDate.ToString("yyyy-MM-dd")</small></td>
                                @if (!isBranchManager)
                                {
                                    <td>
                                        <a href="@Url.EAction(QueryCrypto, "Details", new { id = s.SubDealerId })"
                                           class="btn btn-sm btn-info" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form method="post" asp-action="Delete" class="d-inline"
                                              onsubmit="return confirm('Deactivate this subdealer and all its logins?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.SubDealerId" />
                                            <button type="submit" class="btn btn-sm btn-danger" title="Deactivate">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No subdealers found.
                @if (!isBranchManager)
                {
                    <a href="@Url.Action("Create")">Add the first subdealer.</a>
                }
            </div>
        }
        <partial name="_Pagination" />
    </div>
</div>
