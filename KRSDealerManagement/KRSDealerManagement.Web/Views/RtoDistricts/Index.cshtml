@model IEnumerable<KRSDealerManagement.Domain.Entities.RtoDistrictMaster>
@{ ViewData["Title"] = "RTO Districts"; }
@{
    var locationCounts = ViewBag.LocationCounts as IDictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="row mb-3">
    <div class="col-md-6"><h1 class="m-0"><i class="bi bi-map"></i> RTO Districts</h1></div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Index", "RtoLocations")" class="btn btn-outline-secondary">RTO Locations</a>
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus"></i> Add District</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr><th>#</th><th>District</th><th>Active Locations</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>@(i++)</td>
                            <td>@d.DistrictName</td>
                            <td>@(locationCounts.TryGetValue(d.RtoDistrictId, out var count) ? count : 0)</td>
                            <td><span class="badge @(d.IsActive ? "bg-success" : "bg-secondary")">@(d.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-nowrap">
                                <a href="@Url.Action("Edit", new { id = d.RtoDistrictId })" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form method="post" asp-action="ToggleActive" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.RtoDistrictId" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning">@(d.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
