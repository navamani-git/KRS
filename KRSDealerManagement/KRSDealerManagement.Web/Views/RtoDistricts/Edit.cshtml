@model KRSDealerManagement.Domain.Entities.RtoDistrictMaster
@{ ViewData["Title"] = "Edit RTO District"; }
<div class="row mb-3">
    <div class="col-md-8"><h1>Edit RTO District</h1></div>
    <div class="col-md-4 text-end"><a href="@Url.Action("Index")" class="btn btn-secondary">Back</a></div>
</div>
<div class="card" style="max-width:480px">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.RtoDistrictId" />
            <div class="mb-3">
                <label class="fw-bold">District Name</label>
                <input name="districtName" class="form-control" value="@Model.DistrictName" required />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="isActive">Active</label>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>
