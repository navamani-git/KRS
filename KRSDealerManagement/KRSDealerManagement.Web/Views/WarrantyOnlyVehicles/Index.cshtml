@model IEnumerable<KRSDealerManagement.Application.DTOs.VehicleMasterDto>
@{
    ViewData["Title"] = "Warranty-Only Vehicles";
    ViewData["ExcelImportKey"] = KRSDealerManagement.Web.Helpers.ExcelImport.ExcelImportKeys.WarrantyOnlyVehicleMasters;
    ViewData["ExcelImportReturnAction"] = "Index";
    var searchTerm = ViewBag.SearchTerm as string;
    var canEdit = ViewBag.CanEdit as bool? ?? false;
    var showBranchColumn = ViewBag.ShowBranchColumn as bool? ?? false;
}

<div class="row mb-3">
    <div class="col-lg-8">
        <h1 class="m-0"><i class="bi bi-truck"></i> Warranty-Only Vehicles</h1>
        <p class="text-muted mb-0">External chassis registered for warranty claims only. Not available for allocation or sale.</p>
    </div>
    <div class="col-lg-4 text-lg-end mt-2 mt-lg-0">
        @if (canEdit)
        {
            <a href="@Url.Action("Create")" class="btn btn-primary mt-2"><i class="bi bi-plus-circle"></i> Add Vehicle</a>
        }
    </div>
</div>

@if (canEdit)
{
    <partial name="_ExcelImport" />
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label form-label-sm mb-0">Search chassis</label>
                <input type="text" name="searchTerm" class="form-control form-control-sm" value="@searchTerm" placeholder="Chassis number..." />
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-primary w-100" type="submit"><i class="bi bi-funnel"></i> Filter</button>
            </div>
            <div class="col-md-2">
                <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary w-100">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0">Registered chassis (@(ViewBag.TotalItems ?? Model.Count()))</h3>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            @if (showBranchColumn)
                            {
                                <th>Branch</th>
                            }
                            <th>Chassis</th>
                            <th>Model</th>
                            <th>Color</th>
                            <th>Remarks</th>
                            @if (canEdit)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr>
                                @if (showBranchColumn)
                                {
                                    <td>@m.DealershipName</td>
                                }
                                <td>@m.ChassisNumber</td>
                                <td>@m.ModelName</td>
                                <td>@m.ColorName</td>
                                <td>@m.Remarks</td>
                                @if (canEdit)
                                {
                                    <td class="text-end text-nowrap">
                                        <a href="@Url.Action("Edit", new { id = m.VehicleMasterId })" class="btn btn-sm btn-outline-primary">Edit</a>
                                        <form method="post" asp-action="Delete" class="d-inline" onsubmit="return confirm('Remove this chassis from warranty-only stock?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@m.VehicleMasterId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" />
        }
        else
        {
            <div class="p-4 text-muted">No warranty-only vehicles found.</div>
        }
    </div>
</div>
