@model KRSDealerManagement.Application.DTOs.WarrantyClaimDetailDto
@using KRSDealerManagement.Shared.Constants
@using KRSDealerManagement.Web.Helpers
@{
    ViewData["Title"] = $"Claim {Model.ClaimNumber}";
    var isStaff = ViewBag.IsStaff as bool? ?? false;
    var isSystemAdmin = ViewBag.IsSystemAdmin as bool? ?? false;
    var canStaffEdit = ViewBag.CanStaffEdit as bool? ?? false;
    var canStaffEditWorkflow = ViewBag.CanStaffEditWorkflow as bool? ?? false;
    var todayDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-shield-check"></i> @Model.ClaimNumber</h1>
        <p class="text-muted">@Model.ClaimType claim · <span class="badge @(Model.StatusBadgeClass ?? "bg-secondary")">@(Model.StatusName ?? Model.Status.ToString())</span></p>
    </div>
    <div class="col-md-4 text-end">
        @if (!isStaff && WarrantyClaimStatus.IsSubdealerEditable(Model.Status))
        {
            <a href="@Url.Action("Edit", new { id = Model.WarrantyClaimId })" class="btn btn-primary">Edit Claim</a>
        }
        <a href="@(isStaff ? (Model.Status == WarrantyClaimStatus.Complete ? Url.Action("Completed") : Url.Action("Index")) : (Model.Status == WarrantyClaimStatus.Complete ? Url.Action("MyCompleted") : Url.Action("MyClaims")))" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.MoreInfoNotes))
{
    <div class="alert alert-info"><strong>More info requested:</strong> @Model.MoreInfoNotes</div>
}
@if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
{
    <div class="alert alert-danger"><strong>Rejected:</strong> @Model.RejectionReason</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header"><strong>Vehicle & Customer</strong></div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-6"><small class="text-muted">Chassis</small><div>@Model.ChassisNo</div></div>
                    <div class="col-md-3"><small class="text-muted">Model</small><div>@Model.ModelName</div></div>
                    <div class="col-md-3"><small class="text-muted">Color</small><div>@Model.ColorName</div></div>
                    <div class="col-md-4"><small class="text-muted">Customer</small><div>@Model.CustomerName</div></div>
                    <div class="col-md-4"><small class="text-muted">Customer Mobile</small><div>@Model.CustomerMobile</div></div>
                    <div class="col-md-4"><small class="text-muted">KMs</small><div>@Model.CurrentKms</div></div>
                    <div class="col-md-4"><small class="text-muted">Contact Person</small><div>@Model.ContactPerson</div></div>
                    <div class="col-md-4"><small class="text-muted">Contact Mobile</small><div>@Model.ContactMobile</div></div>
                    <div class="col-md-4"><small class="text-muted">Sale Date</small><div>@(Model.SaleDate?.ToString("dd-MMM-yyyy") ?? "—")</div></div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>Failure Details</strong></div>
            <div class="card-body">
                <div class="row g-2 mb-2">
                    <div class="col-md-4"><small class="text-muted">Part</small><div>@Model.PartName</div></div>
                    <div class="col-md-4"><small class="text-muted">Part Code</small><div>@Model.PartCode</div></div>
                    <div class="col-md-4"><small class="text-muted">Serial #</small><div>@Model.FailurePartSerialNumber</div></div>
                </div>
                <div class="mb-2"><small class="text-muted">Customer Complaint</small><div>@Model.CustomerComplaint</div></div>
                <div class="mb-2"><small class="text-muted">Dealer Observation</small><div>@Model.DealerObservation</div></div>
                <div><small class="text-muted">Remarks</small><div>@Model.Remarks</div></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>Service History</strong></div>
            @if (Model.ServiceEntries.Any())
            {
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Date</th>
                                <th>KMs</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.ServiceEntries.OrderBy(e => e.SortOrder))
                            {
                                <tr>
                                    <td>@entry.ServiceType</td>
                                    <td>@(entry.ServiceDate?.ToString("dd-MMM-yyyy") ?? "—")</td>
                                    <td>@(entry.ServiceKms?.ToString() ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-muted small">No service history recorded.</div>
            }
        </div>

        @if (Model.Attachments.Any())
        {
            <div class="card mb-3">
                <div class="card-header"><strong>Attachments</strong></div>
                <div class="card-body">
                    @foreach (var a in Model.Attachments)
                    {
                        var mediaKind = WarrantyFileHelper.GetMediaKind(a.FilePath);
                        var viewUrl = Url.Action("ViewAttachment", new { id = Model.WarrantyClaimId, path = a.FilePath });
                        var downloadUrl = Url.Action("DownloadAttachment", new { id = Model.WarrantyClaimId, path = a.FilePath });
                        <div class="warranty-attachment-item mb-4 pb-3 border-bottom">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                <strong>@a.AttachmentTypeName</strong>
                                <span class="d-inline-flex gap-1">
                                    <a href="@viewUrl" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <a href="@downloadUrl" class="btn btn-sm btn-outline-secondary" data-no-loader="true">
                                        <i class="bi bi-download"></i> Download
                                    </a>
                                </span>
                            </div>
                            @if (mediaKind == "image")
                            {
                                <a href="@viewUrl" target="_blank" rel="noopener">
                                    <img src="@viewUrl" alt="@a.AttachmentTypeName" class="warranty-attachment-preview img-fluid rounded border" />
                                </a>
                            }
                            else if (mediaKind == "video")
                            {
                                <video controls class="warranty-attachment-preview w-100 rounded border" preload="metadata">
                                    <source src="@viewUrl" />
                                    Your browser does not support video playback.
                                </video>
                            }
                            else if (mediaKind == "pdf")
                            {
                                <iframe src="@viewUrl" class="warranty-attachment-pdf w-100 rounded border" title="@a.AttachmentTypeName"></iframe>
                            }
                            else
                            {
                                <div class="text-muted small">Preview not available for this file type.</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><strong>Lifecycle</strong></div>
            <div class="card-body small">
                <div class="mb-1">Submitted: @(Model.SubmittedDate?.ToString("dd-MMM-yyyy") ?? "—")</div>
                <div class="mb-1">Accepted: @(Model.AcceptedDate?.ToString("dd-MMM-yyyy") ?? "—") @Model.AcceptedByName</div>
                <div class="mb-1">Applied to Ampere: @(Model.AmpereAppliedDate?.ToString("dd-MMM-yyyy") ?? "—") @Model.AmpereAppliedByName</div>
                <div class="mb-1">Ampere Approved: @(Model.AmpereApprovedDate?.ToString("dd-MMM-yyyy") ?? "—") @Model.AmpereApprovedByName</div>
                @if (isStaff)
                {
                    <div class="mb-1">SO Number: @(Model.SoNumber ?? "—")</div>
                    <hr class="my-2" />
                    <div class="mb-1">@(Model.ResolutionPartCompleted ? "✓" : "○") Resolution + Part #: @(Model.ResolutionPartCompleted ? $"{Model.DealerResolutionTypeName} · {Model.DealerClosedPartNumber}" : "—")</div>
                    <div class="mb-1">@(Model.DealerInvoiceClosedCompleted ? "✓" : "○") Invoice + Closed: @(Model.DealerInvoiceClosedCompleted ? $"Invoice {Model.DealerClosedInvoiceNumber} · {Model.DealerClosedDate:dd-MMM-yyyy}" : "—")</div>
                    <div class="mb-1">@(Model.ReplacementPartReceivedCompleted ? "✓" : "○") Replacement received: @(Model.ReplacementPartReceivedDate?.ToString("dd-MMM-yyyy") ?? "—") @Model.ReplacementPartReceivedByName</div>
                }
                <div class="mb-1">@(Model.SubdealerPartReceivedCompleted ? "✓" : "○") Subdealer received: @(Model.SubdealerPartReceivedDate?.ToString("dd-MMM-yyyy") ?? "—") @Model.SubdealerPartReceivedByName</div>
                <div class="mb-1">@(Model.DefectiveHandoverCompleted ? "✓" : "○") Defective handover: @(Model.DefectiveHandoverDate?.ToString("dd-MMM-yyyy") ?? "—") @Model.DefectiveHandoverByName</div>
                @if (isStaff)
                {
                    <div>@(Model.DefectiveSentToAmpereCompleted ? "✓" : "○") Sent to Ampere: @(Model.DefectiveSentToAmpereDate?.ToString("dd-MMM-yyyy") ?? "—") @Model.DefectiveSentToAmpereByName</div>
                }
                @if (Model.Status == WarrantyClaimStatus.Complete)
                {
                    <hr class="my-2" />
                    <div class="text-success fw-bold">Completed: @(Model.CompletedDate?.ToString("dd-MMM-yyyy") ?? "—")</div>
                }
            </div>
        </div>

        @if (isStaff && canStaffEdit && Model.Status != WarrantyClaimStatus.Complete)
        {
            @if (WarrantyClaimStatus.CanStaffReview(Model.Status))
            {
                <div class="card mb-2">
                    <div class="card-header py-2"><strong>Review Claim</strong></div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">Accept the claim, ask the subdealer for more details, or reject it.</p>
                        <form method="post" asp-action="Accept" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <button type="submit" class="btn btn-success btn-sm w-100">Accept</button>
                        </form>
                        <form method="post" asp-action="RequestInfo" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <textarea name="notes" class="form-control form-control-sm mb-1" placeholder="What info is needed?" required></textarea>
                            <button type="submit" class="btn btn-info btn-sm w-100">Request More Info</button>
                        </form>
                        <form method="post" asp-action="Reject">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <textarea name="notes" class="form-control form-control-sm mb-1" placeholder="Rejection reason" required></textarea>
                            <button type="submit" class="btn btn-danger btn-sm w-100">Reject</button>
                        </form>
                    </div>
                </div>
            }
            @if (WarrantyClaimStatus.CanApplyToAmpere(Model.Status))
            {
                <div class="card mb-2">
                    <div class="card-header py-2"><strong>Apply to Ampere</strong></div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">Record the date this claim was sent to Ampere.</p>
                        <form method="post" asp-action="ApplyToAmpere">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">Applied Date *</label>
                            <input type="date" name="actionDate" class="form-control form-control-sm mb-1" required max="@todayDate" value="@todayDate" />
                            <button type="submit" class="btn btn-primary btn-sm w-100">Apply to Ampere</button>
                        </form>
                    </div>
                </div>
            }
            @if (WarrantyClaimStatus.CanMarkAmpereApproved(Model.Status))
            {
                <div class="card mb-2">
                    <div class="card-header py-2"><strong>Ampere Approved</strong></div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">Record when Ampere approved this claim.</p>
                        <form method="post" asp-action="MarkAmpereApproved">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">Ampere Approved Date *</label>
                            <input type="date" name="actionDate" class="form-control form-control-sm mb-1" required max="@todayDate" value="@todayDate" />
                            <button type="submit" class="btn btn-primary btn-sm w-100">Mark Ampere Approved</button>
                        </form>
                    </div>
                </div>
            }
            @if (WarrantyClaimStatus.CanStaffEditSoNumber(Model.Status, Model.DefectiveSentToAmpereCompleted))
            {
                <div class="card mb-2">
                    <div class="card-header py-2"><strong>SO Number</strong></div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">Enter or update the Ampere SO number for this claim.</p>
                        <form method="post" asp-action="UpdateSoNumber">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">SO Number</label>
                            <input type="text" name="soNumber" class="form-control form-control-sm mb-1" required maxlength="50" value="@Model.SoNumber" placeholder="Enter Ampere SO number" />
                            <button type="submit" class="btn btn-outline-primary btn-sm w-100">@(string.IsNullOrWhiteSpace(Model.SoNumber) ? "Save SO Number" : "Edit SO Number")</button>
                        </form>
                    </div>
                </div>
            }
            @if (WarrantyClaimStatus.CanStaffEditResolutionPart(Model.Status, Model.DefectiveSentToAmpereCompleted))
            {
                <div class="card mb-2">
                    <div class="card-header py-2"><strong>Resolution &amp; Part #</strong></div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">Choose how the dealer closed the case and enter the part number.</p>
                        <form method="post" asp-action="SaveResolutionPart">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">Resolution *</label>
                            <select name="dealerResolutionType" class="form-select form-select-sm mb-1" required>
                                <option value="">Select resolution</option>
                                @foreach (var resolution in WarrantyDealerResolutionTypes.All)
                                {
                                    <option value="@resolution" selected="@(string.Equals(Model.DealerResolutionType, resolution, StringComparison.OrdinalIgnoreCase))">@WarrantyDealerResolutionTypes.GetDisplayName(resolution)</option>
                                }
                            </select>
                            <label class="form-label small mb-1">Part # *</label>
                            <input type="text" name="dealerClosedPartNumber" class="form-control form-control-sm mb-1" required maxlength="100" value="@Model.DealerClosedPartNumber" />
                            <button type="submit" class="btn btn-success btn-sm w-100">@(Model.ResolutionPartCompleted ? "Edit Resolution & Part #" : "Save Resolution & Part #")</button>
                        </form>
                    </div>
                </div>
            }
            @if (WarrantyClaimStatus.CanStaffEditDealerInvoiceClosed(Model.Status, Model.DefectiveSentToAmpereCompleted))
            {
                <div class="card mb-2">
                    <div class="card-header py-2"><strong>Invoice &amp; Closed Date</strong></div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">Enter the dealer invoice number and the date the case was closed.</p>
                        <form method="post" asp-action="SaveDealerInvoiceClosed">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">Invoice # *</label>
                            <input type="text" name="dealerClosedInvoiceNumber" class="form-control form-control-sm mb-1" required maxlength="50" value="@Model.DealerClosedInvoiceNumber" />
                            <label class="form-label small mb-1">Closed Date *</label>
                            <input type="date" name="actionDate" class="form-control form-control-sm mb-1" required max="@todayDate" value="@(Model.DealerClosedDate?.ToString("yyyy-MM-dd") ?? todayDate)" />
                            <button type="submit" class="btn btn-success btn-sm w-100">@(Model.DealerInvoiceClosedCompleted ? "Edit Invoice & Closed Date" : "Save Invoice & Closed Date")</button>
                        </form>
                    </div>
                </div>
            }
            @if (WarrantyClaimStatus.CanStaffEditReplacementPartReceived(Model.Status, Model.DefectiveSentToAmpereCompleted))
            {
                <div class="card mb-2">
                    <div class="card-header py-2"><strong>Replacement Part Received</strong></div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">Record when the replacement part was received at the dealer.</p>
                        <form method="post" asp-action="MarkReplacementPartReceived">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">Replacement Part Received Date *</label>
                            <input type="date" name="actionDate" class="form-control form-control-sm mb-1" required max="@todayDate" value="@(Model.ReplacementPartReceivedDate?.ToString("yyyy-MM-dd") ?? todayDate)" />
                            <button type="submit" class="btn btn-primary btn-sm w-100">@(Model.ReplacementPartReceivedCompleted ? "Edit Replacement Part Received" : "Mark Replacement Part Received")</button>
                        </form>
                    </div>
                </div>
            }
            @if (WarrantyClaimStatus.CanStaffEditSubdealerPartReceived(Model.Status, Model.DefectiveSentToAmpereCompleted))
            {
                <div class="card mb-2">
                    <div class="card-header py-2"><strong>Subdealer — Part Received</strong></div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">Record on behalf of the subdealer who received the replacement part.</p>
                        <form method="post" asp-action="StaffMarkSubdealerPartReceived">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">Received By *</label>
                            <input type="text" name="receivedByName" class="form-control form-control-sm mb-1" required maxlength="200" value="@Model.SubdealerPartReceivedByName" placeholder="Who received the new part" />
                            <label class="form-label small mb-1">Received Date *</label>
                            <input type="date" name="actionDate" class="form-control form-control-sm mb-1" required max="@todayDate" value="@(Model.SubdealerPartReceivedDate?.ToString("yyyy-MM-dd") ?? todayDate)" />
                            <button type="submit" class="btn btn-primary btn-sm w-100">@(Model.SubdealerPartReceivedCompleted ? "Edit Part Received (on behalf)" : "Record Part Received (on behalf)")</button>
                        </form>
                    </div>
                </div>
            }
            @if (WarrantyClaimStatus.CanStaffEditDefectiveHandover(Model.Status, Model.DefectiveSentToAmpereCompleted))
            {
                <div class="card mb-2">
                    <div class="card-header py-2"><strong>Subdealer — Defective Handover</strong></div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">Record on behalf of the subdealer who handed over the defective part.</p>
                        <form method="post" asp-action="StaffMarkDefectiveHandover">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">Handover By *</label>
                            <input type="text" name="handoverByName" class="form-control form-control-sm mb-1" required maxlength="200" value="@Model.DefectiveHandoverByName" placeholder="Who handed over defective part" />
                            <label class="form-label small mb-1">Handover Date *</label>
                            <input type="date" name="actionDate" class="form-control form-control-sm mb-1" required max="@todayDate" value="@(Model.DefectiveHandoverDate?.ToString("yyyy-MM-dd") ?? todayDate)" />
                            <button type="submit" class="btn btn-warning btn-sm w-100">@(Model.DefectiveHandoverCompleted ? "Edit Defective Handover (on behalf)" : "Record Defective Handover (on behalf)")</button>
                        </form>
                    </div>
                </div>
            }
            @if (WarrantyClaimStatus.CanStaffMarkDefectiveSentToAmpere(Model.Status, Model.DefectiveSentToAmpereCompleted) && !Model.DefectiveSentToAmpereCompleted)
            {
                <div class="card mb-2">
                    <div class="card-header py-2"><strong>Sent to Ampere</strong></div>
                    <div class="card-body py-2">
                        <p class="small text-muted mb-2">Record when the defective part was handed over to Ampere.</p>
                        <form method="post" asp-action="MarkDefectiveSentToAmpere">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">Handover to Ampere Date *</label>
                            <input type="date" name="actionDate" class="form-control form-control-sm mb-1" required max="@todayDate" value="@todayDate" />
                            <button type="submit" class="btn btn-dark btn-sm w-100">Mark Defective Sent to Ampere</button>
                        </form>
                    </div>
                </div>
            }
        }
        else if (isStaff)
        {
            <div class="alert alert-secondary small">You have view-only access to warranty claims.</div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-header"><strong>Your Actions</strong></div>
                <div class="card-body">
                    @if (Model.SubdealerPartReceivedLockedByStaff)
                    {
                        <div class="alert alert-info small py-2 mb-2">Part receipt was recorded by dealer staff. You cannot change it.</div>
                    }
                    else if (WarrantyClaimStatus.CanSubdealerMarkSubdealerPartReceived(Model.Status, Model.SubdealerPartReceivedCompleted, Model.SubdealerPartReceivedLockedByStaff))
                    {
                        <form method="post" asp-action="MarkSubdealerPartReceived">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">Received By *</label>
                            <input type="text" name="receivedByName" class="form-control form-control-sm mb-1" required maxlength="200" placeholder="Who received the new part" />
                            <label class="form-label small mb-1">Received Date *</label>
                            <input type="date" name="actionDate" class="form-control form-control-sm mb-1" required max="@todayDate" value="@todayDate" />
                            <button type="submit" class="btn btn-primary btn-sm w-100">Confirm Part Received</button>
                        </form>
                    }
                    @if (Model.DefectiveHandoverLockedByStaff)
                    {
                        <div class="alert alert-info small py-2 mb-2 mt-2">Defective handover was recorded by dealer staff. You cannot change it.</div>
                    }
                    else if (WarrantyClaimStatus.CanSubdealerMarkDefectiveHandover(Model.Status, Model.DefectiveHandoverCompleted, Model.DefectiveHandoverLockedByStaff))
                    {
                        <form method="post" asp-action="MarkDefectiveHandover" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.WarrantyClaimId" />
                            <label class="form-label small mb-1">Handover By *</label>
                            <input type="text" name="handoverByName" class="form-control form-control-sm mb-1" required maxlength="200" placeholder="Who handed over defective part" />
                            <label class="form-label small mb-1">Handover Date *</label>
                            <input type="date" name="actionDate" class="form-control form-control-sm mb-1" required max="@todayDate" value="@todayDate" />
                            <button type="submit" class="btn btn-warning btn-sm w-100">Submit Defective Handover</button>
                        </form>
                    }
                </div>
            </div>
        }

    </div>
</div>
