@model KRSDealerManagement.Domain.Entities.StatusLookup
@{
    ViewData["Title"] = "Edit Status";
    var badgeOptions = ViewBag.BadgeOptions as IReadOnlyList<(string Value, string Label)>;
    var categoryDisplay = ViewBag.CategoryDisplay as string ?? Model.Category;
}

<div class="row mb-3">
    <div class="col-md-8"><h1 class="m-0">Edit Status</h1></div>
    <div class="col-md-4 text-end">
        <a href="@QueryStringUrlHelper.EncryptedAction(Url, QueryCrypto, "Index", new { category = Model.Category })" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="card card-primary" style="max-width:640px">
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.StatusLookupId" />
        <div class="card-body">
            <div class="alert alert-info py-2">
                <strong>@categoryDisplay</strong> · Value <code>@Model.StatusValue</code> · Code <code>@Model.StatusCode</code>
                <br /><small class="text-muted">Category, value, and code cannot be changed (used in existing records).</small>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Display Name <span class="text-danger">*</span></label>
                <input name="statusName" class="form-control" value="@Model.StatusName" required />
            </div>
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label class="fw-bold">Badge Style</label>
                    <select name="badgeClass" class="form-select">
                        @if (badgeOptions != null)
                        {
                            @foreach (var b in badgeOptions)
                            {
                                <option value="@b.Value" selected="@(Model.BadgeClass == b.Value)">@b.Label</option>
                            }
                        }
                    </select>
                    <div class="mt-2">Preview: <span class="badge @Model.BadgeClass">@Model.StatusName</span></div>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Sort Order</label>
                    <input type="number" name="sortOrder" class="form-control" value="@Model.SortOrder" min="0" />
                </div>
            </div>
            <div class="form-check">
                <input type="checkbox" name="isActive" value="true" class="form-check-input" id="isActive"
                       @(Model.IsActive ? "checked" : "") />
                <label class="form-check-label" for="isActive">Active (shown in filters and labels)</label>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>
