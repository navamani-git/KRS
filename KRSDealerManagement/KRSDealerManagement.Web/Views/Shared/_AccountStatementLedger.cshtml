@model IEnumerable<KRSDealerManagement.Application.DTOs.AccountTransactionDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Shared.Helpers
@using KRSDealerManagement.Web.Helpers
@using KRSDealerManagement.Web.Models
@using System.Text
@using System.Text.Json

@{
    var totals = ViewBag.StatementTotals as AccountStatementTotalsViewModel;
    var gridId = ViewBag.GridId as string ?? GridIds.AccountStatement;
    var currentPage = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? ListPagingHelper.DefaultPageSize);
    var rowOffset = (currentPage - 1) * pageSize;
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    string EncodeTxnDetail(object payload) =>
        Convert.ToBase64String(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(payload, jsonOptions)));
}

@if (Model.Any())
{
    <partial name="_GridScrollHint" />
    <div class="table-responsive">
        <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@gridId">
            <thead class="table-dark">
                <tr>
                    <th class="grid-col-rownum">#</th>
                    <th>Credit/Debit Date</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Customer</th>
                    <th>Pay Type</th>
                    <th>Finance</th>
                    <th>VIN</th>
                    <th class="text-end">Requested Amt (₹)</th>
                    <th class="text-end">Approved Amt (₹)</th>
                    <th class="text-end text-danger">Debit (₹)</th>
                    <th class="text-end text-success">Credit (₹)</th>
                    <th>Details</th>
                </tr>
                <partial name="_PaginatedGridFilters" />
            </thead>
            <tbody>
                @{ var sr = rowOffset + 1; }
                @foreach (var t in Model)
                {
                    var statementTime = IstTime.ToIst(t.CreatedDate);
                    var isOpeningRow = t.TransactionId <= 0;
                    var rowClass = isOpeningRow
                        ? "table-secondary"
                        : (t.IsDebit() ? "table-danger" : "table-success");
                    var vin = t.VinNumber ?? t.ChassisNumber ?? "-";
                    var txnDetailPayload = EncodeTxnDetail(new
                    {
                        subtitle = $"{t.StatementDate:yyyy-MM-dd HH:mm} · {t.CategoryLabel}",
                        statementDate = t.StatementDate.ToString("yyyy-MM-dd HH:mm"),
                        categoryLabel = t.CategoryLabel,
                        description = string.IsNullOrWhiteSpace(t.Reason) ? null : t.Reason,
                        customer = t.CustomerName,
                        paymentType = t.PaymentType,
                        finance = t.FinanceName,
                        vin = vin == "-" ? null : vin,
                        requestedAmount = t.RequestedAmount.HasValue ? $"₹{t.RequestedAmount.Value:N2}" : null,
                        approvedAmount = t.ApprovedPaymentAmount.HasValue ? $"₹{t.ApprovedPaymentAmount.Value:N2}" : null,
                        debit = t.IsDebit() ? $"₹{t.Amount:N2}" : null,
                        credit = t.IsCredit() ? $"₹{t.Amount:N2}" : null,
                        reference = string.IsNullOrWhiteSpace(t.ReferenceType)
                            ? null
                            : $"{t.ReferenceType}{(t.ReferenceId.HasValue ? $" #{t.ReferenceId}" : "")}",
                        remarks = string.IsNullOrWhiteSpace(t.Remarks) ? null : t.Remarks,
                        dates = t.DetailDates.Select(d => new
                        {
                            label = d.Label,
                            value = d.DateOnly
                                ? d.Value.ToString("yyyy-MM-dd")
                                : d.Value.ToString("yyyy-MM-dd HH:mm")
                        })
                    });
                    <tr class="@rowClass bg-opacity-25">
                        <td class="grid-col-rownum">@(sr++)</td>
                        <td>
                            <small>@t.StatementDate.ToString("yyyy-MM-dd")</small><br />
                            <small class="text-muted">@(statementTime?.ToString("HH:mm") ?? "—")</small>
                        </td>
                        <td><span class="badge bg-secondary">@t.CategoryLabel</span></td>
                        <td class="grid-cell-wrap">
                            @if (!string.IsNullOrEmpty(t.Reason))
                            {
                                @Html.Raw(System.Net.WebUtility.HtmlEncode(t.Reason).Replace("\n", "<br />"))
                            }
                            else
                            {
                                <small class="text-muted">—</small>
                            }
                        </td>
                        <td><small>@(t.CustomerName ?? "-")</small></td>
                        <td><small>@(t.PaymentType ?? "-")</small></td>
                        <td><small>@(t.FinanceName ?? "-")</small></td>
                        <td><small><code>@vin</code></small></td>
                        <td class="text-end">
                            @(t.RequestedAmount.HasValue ? $"₹{t.RequestedAmount.Value:N2}" : "-")
                        </td>
                        <td class="text-end text-success fw-bold">
                            @(t.ApprovedPaymentAmount.HasValue ? $"₹{t.ApprovedPaymentAmount.Value:N2}" : "-")
                        </td>
                        <td class="text-end text-danger fw-bold">
                            @(t.IsDebit() ? $"₹{t.Amount:N2}" : "-")
                        </td>
                        <td class="text-end text-success fw-bold">
                            @(t.IsCredit() ? $"₹{t.Amount:N2}" : "-")
                        </td>
                        <td>
                            @if (!isOpeningRow)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-info statement-detail-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#statementDetailModal"
                                        data-txn-detail="@txnDetailPayload"
                                        title="View full transaction details">
                                    <i class="bi bi-eye"></i> View
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            @if (totals != null)
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="8">Total (@totals.TransactionCount filtered)</td>
                        <td></td>
                        <td class="text-end text-success">₹@totals.TotalApproved.ToString("N2")</td>
                        <td class="text-end text-danger">₹@totals.TotalDebit.ToString("N2")</td>
                        <td class="text-end text-success">₹@totals.TotalCredit.ToString("N2")</td>
                        <td></td>
                    </tr>
                    <tr class="table-secondary">
                        <td colspan="11" class="text-end">Net (Credit − Debit)</td>
                        <td class="text-end @(totals.NetCreditMinusDebit >= 0 ? "text-success" : "text-danger")">
                            ₹@totals.NetCreditMinusDebit.ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
    <div class="px-3 pb-3">
        <partial name="_Pagination" />
    </div>

    <div class="modal fade" id="statementDetailModal" tabindex="-1" aria-labelledby="statementDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="statementDetailModalLabel">Transaction Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3" id="statementDetailSubtitle"></p>
                    <div class="row g-2 mb-3 small">
                        <div class="col-md-6">
                            <div class="text-muted">Description</div>
                            <div id="statementDetailDescription" class="text-break">—</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted">Reference</div>
                            <div id="statementDetailReference">—</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted">Customer</div>
                            <div id="statementDetailCustomer">—</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted">Pay Type</div>
                            <div id="statementDetailPayType">—</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted">Finance</div>
                            <div id="statementDetailFinance">—</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted">VIN / Chassis</div>
                            <div id="statementDetailVin"><code>—</code></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted">Requested</div>
                            <div id="statementDetailRequested">—</div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted">Approved</div>
                            <div id="statementDetailApproved">—</div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted">Debit</div>
                            <div id="statementDetailDebit" class="text-danger">—</div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted">Credit</div>
                            <div id="statementDetailCredit" class="text-success">—</div>
                        </div>
                    </div>
                    <h6 class="mb-2">Milestone dates</h6>
                    <table class="table table-sm table-borderless mb-0">
                        <tbody id="statementDetailDates"></tbody>
                    </table>
                    <div class="mt-3">
                        <span class="text-muted">Remarks</span>
                        <div id="statementDetailRemarks" class="text-break">—</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <script src="~/js/account-statement-detail.js" asp-append-version="true"></script>
}
else
{
    <div class="alert alert-info mb-0">
        <i class="bi bi-info-circle"></i> No transactions found for this account.
    </div>
}
