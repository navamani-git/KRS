@model IEnumerable<KRSDealerManagement.Application.DTOs.AccountTransactionDto>
@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Web.Helpers
@using KRSDealerManagement.Web.Models
@using System.Text.Json

@{
    var totals = ViewBag.StatementTotals as AccountStatementTotalsViewModel;
    var gridId = ViewBag.GridId as string ?? GridIds.AccountStatement;
    var currentPage = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? ListPagingHelper.DefaultPageSize);
    var rowOffset = (currentPage - 1) * pageSize;
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@if (Model.Any())
{
    <partial name="_GridScrollHint" />
    <div class="table-responsive">
        <table class="table table-sm table-hover table-striped mb-0 grid-excel-table grid-data-table" data-grid-id="@gridId">
            <thead class="table-dark">
                <tr>
                    <th class="grid-col-rownum">#</th>
                    <th>Credit/Debit Date</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Customer</th>
                    <th>Pay Type</th>
                    <th>Finance</th>
                    <th>VIN</th>
                    <th class="text-end">Requested Amt (₹)</th>
                    <th class="text-end">Approved Amt (₹)</th>
                    <th class="text-end text-danger">Debit (₹)</th>
                    <th class="text-end text-success">Credit (₹)</th>
                    <th>Details</th>
                </tr>
                <partial name="_PaginatedGridFilters" />
            </thead>
            <tbody>
                @{ var sr = rowOffset + 1; }
                @foreach (var t in Model)
                {
                    var isOpeningRow = t.TransactionId <= 0;
                    var rowClass = isOpeningRow
                        ? "table-secondary"
                        : (t.IsDebit() ? "table-danger" : "table-success");
                    var detailDatesJson = JsonSerializer.Serialize(
                        t.DetailDates.Select(d => new
                        {
                            label = d.Label,
                            value = d.DateOnly
                                ? d.Value.ToString("yyyy-MM-dd")
                                : d.Value.ToString("yyyy-MM-dd HH:mm")
                        }),
                        jsonOptions);
                    <tr class="@rowClass bg-opacity-25">
                        <td class="grid-col-rownum">@(sr++)</td>
                        <td>
                            <small>@t.StatementDate.ToString("yyyy-MM-dd")</small><br />
                            <small class="text-muted">@t.StatementDate.ToString("HH:mm")</small>
                        </td>
                        <td><span class="badge bg-secondary">@t.CategoryLabel</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(t.Reason))
                            {
                                @Html.Raw(System.Net.WebUtility.HtmlEncode(t.Reason).Replace("\n", "<br />"))
                            }
                            else if (t.IsPaymentTransaction() && t.ReferenceId.HasValue)
                            {
                                <small class="text-muted">Payment #@t.ReferenceId</small>
                            }
                        </td>
                        <td><small>@(t.CustomerName ?? "-")</small></td>
                        <td><small>@(t.PaymentType ?? "-")</small></td>
                        <td><small>@(t.FinanceName ?? "-")</small></td>
                        <td><small><code>@(t.VinNumber ?? t.ChassisNumber ?? "-")</code></small></td>
                        <td class="text-end">
                            @(t.RequestedAmount.HasValue ? $"₹{t.RequestedAmount.Value:N2}" : "-")
                        </td>
                        <td class="text-end text-success fw-bold">
                            @(t.ApprovedPaymentAmount.HasValue ? $"₹{t.ApprovedPaymentAmount.Value:N2}" : "-")
                        </td>
                        <td class="text-end text-danger fw-bold">
                            @(t.IsDebit() ? $"₹{t.Amount:N2}" : "-")
                        </td>
                        <td class="text-end text-success fw-bold">
                            @(t.IsCredit() ? $"₹{t.Amount:N2}" : "-")
                        </td>
                        <td>
                            @if (!isOpeningRow)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-info statement-detail-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#statementDetailModal"
                                        data-txn-label="@t.StatementDate.ToString("yyyy-MM-dd HH:mm") · @t.CategoryLabel"
                                        data-detail-dates="@System.Net.WebUtility.HtmlEncode(detailDatesJson)"
                                        data-remarks="@(t.Remarks ?? "-")"
                                        title="View full transaction details">
                                    <i class="bi bi-eye"></i> View
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            @if (totals != null)
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="8">Total (@totals.TransactionCount filtered)</td>
                        <td></td>
                        <td class="text-end text-success">₹@totals.TotalApproved.ToString("N2")</td>
                        <td class="text-end text-danger">₹@totals.TotalDebit.ToString("N2")</td>
                        <td class="text-end text-success">₹@totals.TotalCredit.ToString("N2")</td>
                        <td></td>
                    </tr>
                    <tr class="table-secondary">
                        <td colspan="11" class="text-end">Net (Credit − Debit)</td>
                        <td class="text-end @(totals.NetCreditMinusDebit >= 0 ? "text-success" : "text-danger")">
                            ₹@totals.NetCreditMinusDebit.ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
    <div class="px-3 pb-3">
        <partial name="_Pagination" />
    </div>

    <div class="modal fade" id="statementDetailModal" tabindex="-1" aria-labelledby="statementDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="statementDetailModalLabel">Transaction Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3" id="statementDetailSubtitle"></p>
                    <table class="table table-sm table-borderless mb-0">
                        <tbody id="statementDetailDates"></tbody>
                    </table>
                    <div class="mt-2">
                        <span class="text-muted">Remarks</span>
                        <div id="statementDetailRemarks" class="text-break">-</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.querySelectorAll('.statement-detail-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('statementDetailSubtitle').textContent = btn.dataset.txnLabel || '';
                document.getElementById('statementDetailRemarks').textContent = btn.dataset.remarks || '-';

                var tbody = document.getElementById('statementDetailDates');
                tbody.innerHTML = '';
                var raw = btn.dataset.detailDates || '[]';
                try {
                    var dates = JSON.parse(raw);
                    dates.forEach(function (d) {
                        var tr = document.createElement('tr');
                        var label = document.createElement('td');
                        label.className = 'text-muted';
                        label.style.width = '40%';
                        label.textContent = d.label || '-';
                        var value = document.createElement('td');
                        value.textContent = d.value || '-';
                        tr.appendChild(label);
                        tr.appendChild(value);
                        tbody.appendChild(tr);
                    });
                } catch (e) {
                    var tr = document.createElement('tr');
                    tr.innerHTML = '<td class="text-muted" colspan="2">No date details available.</td>';
                    tbody.appendChild(tr);
                }
            });
        });
    </script>
}
else
{
    <div class="alert alert-info mb-0">
        <i class="bi bi-info-circle"></i> No transactions found for this account.
    </div>
}
