@using KRSDealerManagement.Web.Helpers
@{
    var fontOption = SessionHelper.GetFontSizeOption(Context.Session);
}

<form method="post"
      action="@Url.Action("SetFontSize", "Account")"
      class="dropdown krs-font-dropdown mb-0"
      data-krs-font-form="1">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
    <input type="hidden" name="fontSizePreset" value="@fontOption.Code" data-krs-font-input />
    <button type="button"
            class="btn btn-sm btn-outline-light dropdown-toggle"
            data-bs-toggle="dropdown"
            data-bs-display="static"
            data-bs-auto-close="true"
            aria-expanded="false"
            title="Font size">
        <span class="d-none d-lg-inline me-1">Font</span>@fontOption.Label
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        @foreach (var opt in SessionHelper.FontSizeOptions)
        {
            <li>
                <button type="button"
                        class="dropdown-item@(fontOption.Code.Equals(opt.Code, StringComparison.OrdinalIgnoreCase) ? " active" : "")"
                        data-font-preset="@opt.Code">
                    @opt.Label
                </button>
            </li>
        }
    </ul>
</form>
