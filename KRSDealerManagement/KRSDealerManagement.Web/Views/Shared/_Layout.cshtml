@using KRSDealerManagement.Web.Helpers
@using KRSDealerManagement.Shared.Constants
@{
    var userId = SessionHelper.GetUserId(Context.Session);
    var username = SessionHelper.GetUsername(Context.Session) ?? "Guest";
    var fullName = SessionHelper.GetFullName(Context.Session) ?? "Guest User";
    var roleName = SessionHelper.GetRoleName(Context.Session) ?? "Unknown";
    var dealershipName = SessionHelper.GetDealershipName(Context.Session);
    var isStaff = SessionHelper.IsStaff(Context.Session);
    var isSubdealer = SessionHelper.IsSubdealer(Context.Session);
    var session = Context.Session;
    var navController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var navAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    if (string.Equals(navController, "ExcelImport", StringComparison.OrdinalIgnoreCase))
    {
        var returnController = Context.Request.Query["returnController"].ToString();
        if (!string.IsNullOrWhiteSpace(returnController))
        {
            navController = returnController;
            var returnAction = Context.Request.Query["returnAction"].ToString();
            if (!string.IsNullOrWhiteSpace(returnAction))
                navAction = returnAction;
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KRS Dealer Management</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
    
    <!-- AdminLTE CSS -->
    <link href="https://cdn.jsdelivr.net/npm/admin-lte@3/dist/css/adminlte.min.css" rel="stylesheet">
    
    <link rel="shortcut icon" href="~/images/krslogo.png" type="image/png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        .sidebar-dark-primary {
            background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
        }
        
        .brand-link {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        
        .nav-sidebar .nav-link.active,
        .sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link.active {
            background-color: rgba(255, 255, 255, 0.28) !important;
            color: #fff !important;
            font-weight: 600;
            box-shadow: inset 3px 0 0 #fff;
        }
        
        .nav-sidebar .nav-link.active .nav-icon {
            color: #fff;
        }
        
        .user-panel {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="bi bi-list"></i></a>
                </li>
                <li class="nav-item d-none d-md-inline-block">
                    <a href="@Url.Action("Index", "Dashboard")" class="nav-link">Home</a>
                </li>
            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Profile", "Account")" title="My login">
                        <i class="bi bi-person-circle"></i> @fullName (@roleName)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Logout", "Account")" title="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Sidebar -->
            <div class="sidebar">
                <!-- User Panel -->
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="image">
                        <i class="bi bi-person-circle" style="font-size: 2rem; color: white;"></i>
                    </div>
                    <div class="info">
                        <a href="@Url.Action("Profile", "Account")" class="d-block text-white">@fullName</a>
                        <small class="text-white-50">@roleName@(string.IsNullOrEmpty(dealershipName) ? "" : " · " + dealershipName)</small>
                    </div>
                </div>

                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                        
                        <!-- Dashboard -->
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Dashboard")" class="nav-link @NavMenuHelper.ActiveClass(navController, navAction, "Dashboard")">
                                <i class="nav-icon bi bi-speedometer2"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>

                        @if (isStaff)
                        {
                            @foreach (var group in StaffMenuAccess.GetStaffMenuGroups())
                            {
                                var visible = group.Children
                                    .Where(c => SessionHelper.HasMenuAccess(session, c.Key))
                                    .ToList();
                                if (!visible.Any()) { continue; }

                                if (visible.Count == 1 && group.Children.Count == 1)
                                {
                                    var item = visible[0];
                                    <li class="nav-item">
                                        <a href="@(item.RouteValues is { Count: > 0 } ? Url.Action(item.Action, item.Controller, item.RouteValues) : Url.Action(item.Action, item.Controller))" class="nav-link @NavMenuHelper.ActiveClassForMenuItem(navController, navAction, item, Context.Request)">
                                            <i class="nav-icon bi @(item.Icon ?? "bi-circle")"></i>
                                            <p>@item.Name</p>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    var open = NavMenuHelper.IsMenuGroupOpen(group.ParentKey, navController, navAction, Context.Request, visible);
                                    <li class="nav-item has-treeview @(open ? "menu-open" : "")">
                                        <a href="#" class="nav-link @(open ? "active" : "")">
                                            <i class="nav-icon bi @(group.Icon ?? "bi-folder")"></i>
                                            <p>
                                                @group.ParentName
                                                <i class="right bi bi-chevron-left"></i>
                                            </p>
                                        </a>
                                        <ul class="nav nav-treeview">
                                            @foreach (var item in visible)
                                            {
                                                <li class="nav-item">
                                                    <a href="@(item.RouteValues is { Count: > 0 } ? Url.Action(item.Action, item.Controller, item.RouteValues) : Url.Action(item.Action, item.Controller))" class="nav-link @NavMenuHelper.ActiveClassForMenuItem(navController, navAction, item, Context.Request)">
                                                        <i class="nav-icon bi @(item.Icon ?? "bi-circle")"></i>
                                                        <p>@item.Name</p>
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </li>
                                }
                            }
                        }

                        @if (isSubdealer)
                        {
                            @foreach (var group in MenuKeys.GetSubdealerMenuGroups())
                            {
                                var visible = group.Children
                                    .Where(c => PermissionHelper.HasAccess(session, c.Key))
                                    .ToList();
                                if (!visible.Any()) { continue; }

                                if (visible.Count == 1 && group.Children.Count == 1)
                                {
                                    var item = visible[0];
                                    <li class="nav-item">
                                        <a href="@(item.RouteValues is { Count: > 0 } ? Url.Action(item.Action, item.Controller, item.RouteValues) : Url.Action(item.Action, item.Controller))" class="nav-link @NavMenuHelper.ActiveClassForMenuItem(navController, navAction, item, Context.Request)">
                                            <i class="nav-icon bi @(item.Icon ?? "bi-circle")"></i>
                                            <p>@item.Name</p>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    var open = NavMenuHelper.IsMenuGroupOpen(group.ParentKey, navController, navAction, Context.Request, visible);
                                    <li class="nav-item has-treeview @(open ? "menu-open" : "")">
                                        <a href="#" class="nav-link @(open ? "active" : "")">
                                            <i class="nav-icon bi @(group.Icon ?? "bi-folder")"></i>
                                            <p>
                                                @group.ParentName
                                                <i class="right bi bi-chevron-left"></i>
                                            </p>
                                        </a>
                                        <ul class="nav nav-treeview">
                                            @foreach (var item in visible)
                                            {
                                                <li class="nav-item">
                                                    <a href="@(item.RouteValues is { Count: > 0 } ? Url.Action(item.Action, item.Controller, item.RouteValues) : Url.Action(item.Action, item.Controller))" class="nav-link @NavMenuHelper.ActiveClassForMenuItem(navController, navAction, item, Context.Request)">
                                                        <i class="nav-icon bi @(item.Icon ?? "bi-circle")"></i>
                                                        <p>@item.Name</p>
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </li>
                                }
                            }
                        }

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <!-- Content Header (Page header) -->
            <div class="content-header">
                <div class="container-fluid">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                            <i class="bi bi-check-circle"></i> @TempData["Success"]
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                            <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
                        </div>
                    }
                </div>
            </div>

            <!-- Main content -->
            <div class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>&copy; @DateTime.Now.Year <a href="#">KRS Dealer Management</a>.</strong> All rights reserved.
            <div class="float-right d-none d-sm-inline-block">
                <b>Version</b> 1.0.0
            </div>
        </footer>
    </div>

    @if (userId.HasValue)
    {
        @await Component.InvokeAsync("QuickActions")
    }

    <div id="krsPageLoader" class="krs-page-loader" hidden aria-live="polite" aria-busy="false">
        <div class="krs-page-loader-panel">
            <div class="spinner-border krs-page-loader-spinner" role="status" aria-hidden="true"></div>
            <div class="krs-page-loader-text">Please wait...</div>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site-loader.js" asp-append-version="true"></script>
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3/dist/js/adminlte.min.js"></script>
    <script src="~/js/query-string.js" asp-append-version="true"></script>
    <script>
        window.krsGridDistinctValuesUrl = '@Url.Action("DistinctValues", "Grids")';
    </script>
    <script src="~/js/grid-scroll.js" asp-append-version="true"></script>
    <script src="~/js/grid-columns.js" asp-append-version="true"></script>
    <script src="~/js/grid-resize.js" asp-append-version="true"></script>
    <script src="~/js/grid-combobox.js" asp-append-version="true"></script>
    <script src="~/js/amount-format.js" asp-append-version="true"></script>
    <partial name="_VehicleChassisModal" />
    <script src="~/js/vehicle-chassis-modal.js" asp-append-version="true"></script>
    @if (userId.HasValue)
    {
        <script src="~/js/quick-actions-widget.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
