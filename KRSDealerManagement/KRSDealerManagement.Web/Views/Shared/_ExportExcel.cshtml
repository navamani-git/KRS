@using KRSDealerManagement.Web.Helpers
@if (!SessionHelper.CanExport(Context.Session))
{
    return;
}
@{
    var qs = Context.Request.QueryString.Value ?? "";
    if (qs.StartsWith("?")) qs = qs[1..];
    var actionName = ViewData["ExportAction"] as string ?? "Export";
    var exportUrl = Url.Action(actionName) + (string.IsNullOrEmpty(qs) ? "" : "?" + qs);
}
<a href="@exportUrl" class="btn btn-sm btn-success" data-krs-export="true" data-loader-message="Exporting to Excel...">
    <i class="bi bi-file-earmark-excel"></i> Export Excel
</a>
