@using KRSDealerManagement.Application.DTOs
@model IEnumerable<VehicleColorDto>
@{
    var selectedIds = ViewBag.SelectedColorIds as IEnumerable<int> ?? Enumerable.Empty<int>();
    var selectedSet = selectedIds.ToHashSet();
}

<div class="form-group mb-3">
    <label class="form-label fw-bold">
        Available Colors <span class="text-danger">*</span>
    </label>
    <small class="d-block text-muted mb-2">Select at least one color available for this model.</small>

    @if (Model != null && Model.Any())
    {
        <div class="border rounded p-3" style="max-height: 280px; overflow-y: auto;">
            @foreach (var color in Model)
            {
                <div class="form-check mb-2">
                    <input class="form-check-input"
                           type="checkbox"
                           name="colorIds"
                           value="@color.ColorId"
                           id="color_@color.ColorId"
                           @(selectedSet.Contains(color.ColorId) ? "checked" : "") />
                    <label class="form-check-label d-flex align-items-center gap-2" for="color_@color.ColorId">
                        @if (!string.IsNullOrEmpty(color.HexCode))
                        {
                            <span style="display:inline-block; width:18px; height:18px; background-color:@color.HexCode;
                                  border-radius:50%; border:1px solid #ccc;"></span>
                        }
                        <span>@color.GetColorDisplay()</span>
                    </label>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning mb-0">
            <i class="bi bi-exclamation-triangle"></i>
            No colors found. <a href="@Url.Action("Create", "VehicleColors")">Add colors</a> first, then map them here.
        </div>
    }
</div>
