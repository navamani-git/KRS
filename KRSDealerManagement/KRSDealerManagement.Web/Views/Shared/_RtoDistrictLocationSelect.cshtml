@using KRSDealerManagement.Domain.Entities
@{
    var districts = ViewBag.RtoDistricts as IEnumerable<RtoDistrictMaster> ?? Enumerable.Empty<RtoDistrictMaster>();
    var locations = ViewBag.RtoLocations as IEnumerable<RtoLocationMaster> ?? Enumerable.Empty<RtoLocationMaster>();
    var selectedDistrictId = ViewBag.SelectedRtoDistrictId as int?;
    var selectedLocationId = ViewBag.SelectedRtoLocationId as int?;
    var locationsJson = System.Text.Json.JsonSerializer.Serialize(
        locations.Select(l => new { rtoLocationId = l.RtoLocationId, rtoDistrictId = l.RtoDistrictId, locationName = l.LocationName }));
}

<div class="col-md-4">
    <label class="fw-bold">RTO District <span class="text-danger">*</span></label>
    <select id="rtoDistrictId" class="form-select" required>
        <option value="">-- Select district --</option>
        @foreach (var d in districts.Where(d => d.IsActive).OrderBy(d => d.DistrictName))
        {
            if (selectedDistrictId == d.RtoDistrictId)
            {
                <option value="@d.RtoDistrictId" selected>@d.DistrictName</option>
            }
            else
            {
                <option value="@d.RtoDistrictId">@d.DistrictName</option>
            }
        }
    </select>
</div>
<div class="col-md-4">
    <label class="fw-bold">RTO Location <span class="text-danger">*</span></label>
    <select name="rtoLocationId" id="rtoLocationId" class="form-select" required>
        <option value="">-- Select location --</option>
    </select>
</div>

<script>
    (function () {
        const allLocations = @Html.Raw(locationsJson);
        const districtSelect = document.getElementById('rtoDistrictId');
        const locationSelect = document.getElementById('rtoLocationId');
        const selectedLocationId = @(selectedLocationId?.ToString() ?? "null");
        let tomChangeBound = false;

        function getSelectValue(el) {
            if (!el) return '';
            if (el.tomselect) {
                const value = el.tomselect.getValue();
                return Array.isArray(value) ? (value[0] || '') : (value || '');
            }
            return el.value || '';
        }

        function locationDistrictId(row) {
            return row.rtoDistrictId ?? row.RtoDistrictId;
        }

        function locationRowId(row) {
            return row.rtoLocationId ?? row.RtoLocationId;
        }

        function locationRowName(row) {
            return row.locationName ?? row.LocationName ?? '';
        }

        function refreshLocationSelect() {
            if (!districtSelect || !locationSelect) return;

            const districtId = parseInt(getSelectValue(districtSelect), 10);

            if (window.KrsSearchableSelect) {
                window.KrsSearchableSelect.destroy(locationSelect);
            }

            locationSelect.innerHTML = '<option value="">-- Select location --</option>';
            if (!districtId) {
                if (window.KrsSearchableSelect) {
                    window.KrsSearchableSelect.init(locationSelect);
                }
                return;
            }

            allLocations
                .filter(function (row) { return locationDistrictId(row) === districtId; })
                .sort(function (a, b) { return locationRowName(a).localeCompare(locationRowName(b)); })
                .forEach(function (row) {
                    const opt = document.createElement('option');
                    const id = locationRowId(row);
                    opt.value = id;
                    opt.textContent = locationRowName(row);
                    if (selectedLocationId && selectedLocationId === id) {
                        opt.selected = true;
                    }
                    locationSelect.appendChild(opt);
                });

            if (window.KrsSearchableSelect) {
                window.KrsSearchableSelect.init(locationSelect);
            }
        }

        function bindDistrictChange() {
            if (!districtSelect || districtSelect.dataset.rtoCascadeBound === '1') return;
            districtSelect.dataset.rtoCascadeBound = '1';
            districtSelect.addEventListener('change', refreshLocationSelect);
        }

        function bindTomSelectDistrictChange() {
            if (!districtSelect || !districtSelect.tomselect || tomChangeBound) return;
            tomChangeBound = true;
            districtSelect.tomselect.on('change', refreshLocationSelect);
        }

        function initRtoCascade() {
            bindDistrictChange();
            bindTomSelectDistrictChange();
            refreshLocationSelect();
        }

        function scheduleInit() {
            initRtoCascade();
            requestAnimationFrame(initRtoCascade);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', scheduleInit);
        } else {
            scheduleInit();
        }
        window.addEventListener('load', scheduleInit);
    })();
</script>
