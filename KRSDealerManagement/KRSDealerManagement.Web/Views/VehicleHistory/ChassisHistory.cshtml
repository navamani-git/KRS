@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Chassis History";
    var query = ViewBag.ChassisQuery as string ?? "";
    var history = ViewBag.History as VehicleChassisHistoryDto;
    var error = ViewBag.Error as string;
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-clock-history"></i> Chassis History</h1>
        <p class="text-muted mb-0">Full lifecycle timeline in chronological order (oldest first).</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-bold mb-1">Chassis number</label>
                <input type="text" name="chassis" class="form-control text-uppercase" value="@query"
                       placeholder="Enter full chassis number" required autofocus />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> @error</div>
}

@if (history != null)
{
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h3 class="card-title mb-0"><code>@history.ChassisNumber</code></h3>
            <span class="badge bg-primary">@(history.CurrentStatusName ?? history.CurrentStatus.ToString())</span>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-md-3">
                    <div class="border rounded p-2 h-100 bg-light">
                        <div class="text-muted small">Model</div>
                        <div class="fw-semibold">@history.ModelName</div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="border rounded p-2 h-100 bg-light">
                        <div class="text-muted small">Color</div>
                        <div class="fw-semibold">@history.ColorName</div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="border rounded p-2 h-100 bg-light">
                        <div class="text-muted small">Current holder</div>
                        <div class="fw-semibold">@history.CurrentHolder</div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="border rounded p-2 h-100 bg-light">
                        <div class="text-muted small">Total events</div>
                        <div class="fw-semibold">@history.Events.Count</div>
                    </div>
                </div>
            </div>

            @if (history.Events.Any())
            {
                var dateGroups = history.Events.GroupBy(e => e.OccurredAtLocal.Date).OrderBy(g => g.Key);
                <style>
                    .chassis-timeline { position: relative; padding-left: 0.25rem; }
                    .chassis-timeline-day {
                        font-weight: 600;
                        color: #495057;
                        margin: 1.25rem 0 0.75rem;
                        padding: 0.5rem 0.75rem;
                        background: #f8f9fa;
                        border-left: 4px solid #0d6efd;
                        border-radius: 0.25rem;
                    }
                    .chassis-timeline-day:first-child { margin-top: 0; }
                    .chassis-timeline-item {
                        display: grid;
                        grid-template-columns: 2.75rem 1fr;
                        gap: 0.75rem 1rem;
                        margin-bottom: 0.75rem;
                        padding-bottom: 0.75rem;
                        border-bottom: 1px solid #e9ecef;
                    }
                    .chassis-timeline-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
                    .chassis-timeline-step {
                        width: 2.75rem;
                        height: 2.75rem;
                        border-radius: 50%;
                        background: #e7f1ff;
                        color: #0d6efd;
                        font-weight: 700;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        flex-shrink: 0;
                    }
                    .chassis-timeline-card {
                        background: #fff;
                        border: 1px solid #dee2e6;
                        border-radius: 0.5rem;
                        padding: 0.85rem 1rem;
                    }
                    .chassis-timeline-meta {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 0.5rem 1rem;
                        align-items: center;
                        margin-bottom: 0.5rem;
                    }
                    .chassis-timeline-desc {
                        line-height: 1.5;
                        margin-bottom: 0.35rem;
                        word-break: break-word;
                    }
                    .chassis-timeline-footer {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 0.5rem 1.25rem;
                        font-size: 0.875rem;
                        color: #6c757d;
                    }
                    .chassis-timeline-footer span { white-space: nowrap; }
                    @@media (max-width: 576px) {
                        .chassis-timeline-item { grid-template-columns: 2.25rem 1fr; }
                        .chassis-timeline-step { width: 2.25rem; height: 2.25rem; font-size: 0.85rem; }
                    }
                </style>

                <div class="chassis-timeline">
                    @foreach (var group in dateGroups)
                    {
                        <div class="chassis-timeline-day">
                            <i class="bi bi-calendar3"></i>
                            @group.Key.ToString("dddd, dd MMMM yyyy")
                        </div>

                        @foreach (var e in group.OrderBy(x => x.OccurredAt).ThenBy(x => x.Step))
                        {
                            <div class="chassis-timeline-item">
                                <div class="chassis-timeline-step">@e.Step</div>
                                <div class="chassis-timeline-card">
                                    <div class="chassis-timeline-meta">
                                        <span class="badge @(e.StatusBadgeClass ?? "bg-secondary")">@e.Title</span>
                                        <span class="text-muted small">
                                            <i class="bi bi-clock"></i> @e.OccurredAtLocal.ToString("HH:mm")
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(e.OrderNumber))
                                        {
                                            <span class="text-muted small">
                                                <i class="bi bi-receipt"></i> @e.OrderNumber
                                            </span>
                                        }
                                    </div>
                                    <div class="chassis-timeline-desc">@e.Description</div>
                                    <div class="chassis-timeline-footer">
                                        @if (!string.IsNullOrWhiteSpace(e.Actor))
                                        {
                                            <span><i class="bi bi-person"></i> @e.Actor</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(e.Location))
                                        {
                                            <span><i class="bi bi-geo-alt"></i> @e.Location</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">No lifecycle events recorded yet for this chassis.</div>
            }
        </div>
    </div>
}
