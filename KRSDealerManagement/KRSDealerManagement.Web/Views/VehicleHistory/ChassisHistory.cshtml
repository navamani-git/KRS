@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Chassis History";
    var query = ViewBag.ChassisQuery as string ?? "";
    var history = ViewBag.History as VehicleChassisHistoryDto;
    var error = ViewBag.Error as string;
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-clock-history"></i> Chassis History</h1>
        <p class="text-muted mb-0">Full lifecycle history in chronological order (oldest first).</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-bold mb-1">Chassis number</label>
                <input type="text" name="chassis" class="form-control text-uppercase" value="@query"
                       placeholder="Enter full chassis number" required autofocus />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> @error</div>
}

@if (history != null)
{
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h3 class="card-title mb-0"><code>@history.ChassisNumber</code></h3>
            <span class="badge bg-primary">@(history.CurrentStatusName ?? history.CurrentStatus.ToString())</span>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-md-3">
                    <div class="border rounded p-2 h-100 bg-light">
                        <div class="text-muted small">Model</div>
                        <div class="fw-semibold">@history.ModelName</div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="border rounded p-2 h-100 bg-light">
                        <div class="text-muted small">Color</div>
                        <div class="fw-semibold">@history.ColorName</div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="border rounded p-2 h-100 bg-light">
                        <div class="text-muted small">Current holder</div>
                        <div class="fw-semibold">@history.CurrentHolder</div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="border rounded p-2 h-100 bg-light">
                        <div class="text-muted small">Total events</div>
                        <div class="fw-semibold">@history.Events.Count</div>
                    </div>
                </div>
            </div>

            @if (history.Events.Any())
            {
                <partial name="_GridScrollHint" />
                <div class="table-responsive">
                    <table class="table table-sm table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="grid-col-rownum">#</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Description</th>
                                <th>Order</th>
                                <th>Actor</th>
                                <th>Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in history.Events.OrderBy(x => x.OccurredAt).ThenBy(x => x.Step))
                            {
                                <tr>
                                    <td>@e.Step</td>
                                    <td>@e.OccurredAtLocal.ToString("dd-MMM-yyyy")</td>
                                    <td>@e.OccurredAtLocal.ToString("HH:mm")</td>
                                    <td><span class="badge @(e.StatusBadgeClass ?? "bg-secondary")">@e.Title</span></td>
                                    <td>@e.Description</td>
                                    <td>@(e.OrderNumber ?? "—")</td>
                                    <td>@(e.Actor ?? "—")</td>
                                    <td>@(e.Location ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">No lifecycle events recorded yet for this chassis.</div>
            }
        </div>
    </div>
}
