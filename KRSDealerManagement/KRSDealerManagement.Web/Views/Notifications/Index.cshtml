@model IReadOnlyList<KRSDealerManagement.Application.DTOs.SubdealerNotificationListItemDto>
@using KRSDealerManagement.Shared.Helpers
@{
    ViewData["Title"] = "Notifications";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-bell"></i> Notifications</h1>
        <p class="text-muted">Messages from KRS admin for your location</p>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-muted text-center">No notifications yet.</div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var item in Model)
                {
                    var sentAt = IstTime.ToIst(item.CreatedDate);
                    <a href="@Url.Action("Details", new { id = item.NotificationId })"
                       class="list-group-item list-group-item-action @(item.IsRead ? "" : "list-group-item-warning")">
                        <div class="d-flex w-100 justify-content-between align-items-start">
                            <div>
                                <h5 class="mb-1">
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge bg-danger me-1">New</span>
                                    }
                                    @item.Title
                                </h5>
                                <p class="mb-1 text-muted">@item.BodyPreview</p>
                            </div>
                            <small class="text-muted ms-2">@(sentAt?.ToString("dd-MMM-yyyy HH:mm") ?? "—")</small>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>
