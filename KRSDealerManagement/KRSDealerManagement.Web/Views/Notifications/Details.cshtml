@model KRSDealerManagement.Application.DTOs.SubdealerNotificationDetailDto
@using KRSDealerManagement.Shared.Helpers
@{
    ViewData["Title"] = Model.Title;
    var sentAt = IstTime.ToIst(Model.CreatedDate);
    var readAt = IstTime.ToIst(Model.ReadDate);
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0">@Model.Title</h1>
        <p class="text-muted">@(sentAt?.ToString("dd-MMM-yyyy HH:mm") ?? "—")</p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="notification-body mb-3">@Model.Body</div>
        <small class="text-muted">
            @if (Model.IsRead && readAt.HasValue)
            {
                <span>Read on @readAt.Value.ToString("dd-MMM-yyyy HH:mm")</span>
            }
            else
            {
                <span class="text-success">Marked as read</span>
            }
        </small>
    </div>
</div>

<style>
    .notification-body { white-space: pre-wrap; }
</style>
