@model KRSDealerManagement.Web.Controllers.RoleTemplateFormModel
@{
    ViewData["Title"] = "Create Role Template";
    ViewData["RoleForm"] = new KRSDealerManagement.Web.Controllers.StaffRoleFormModel
    {
        MenuKeys = Model.MenuKeys,
        MenuAccessLevels = Model.MenuAccessLevels
    };
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-plus-circle"></i> Create Role Template</h1>
        <p class="text-muted mb-0">Define a reusable menu preset. Staff roles can be created from this template.</p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="card card-primary mb-3">
        <div class="card-header"><h3 class="card-title mb-0">Template Details</h3></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Template Code <span class="text-danger">*</span></label>
                    <input type="text" name="TemplateCode" class="form-control text-uppercase" value="@Model.TemplateCode" required placeholder="e.g. SALES_COORDINATOR" />
                    <small class="text-muted">Unique code (letters, numbers, underscore). Cannot match built-in templates.</small>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Display Name <span class="text-danger">*</span></label>
                    <input type="text" name="TemplateName" class="form-control" value="@Model.TemplateName" required placeholder="e.g. Sales Coordinator" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Legacy User Role</label>
                    <select name="LegacyUserRole" class="form-select">
                        <option value="4" selected="@(Model.LegacyUserRole == 4)">Staff (4)</option>
                        <option value="3" selected="@(Model.LegacyUserRole == 3)">Finance (3)</option>
                    </select>
                    <small class="text-muted">Used for session compatibility when staff log in.</small>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Description</label>
                    <input type="text" name="Description" class="form-control" value="@Model.Description" placeholder="What this template is for" />
                </div>
            </div>
        </div>
    </div>

    <partial name="../StaffRoles/_MenuPermissionMatrix" />

    <div class="mt-3">
        <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-save"></i> Create Template</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg ms-2">Cancel</a>
    </div>
</form>
