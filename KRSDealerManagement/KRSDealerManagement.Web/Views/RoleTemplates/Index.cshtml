@model IReadOnlyList<KRSDealerManagement.Application.Services.RoleTemplateCatalogItem>
@{
    ViewData["Title"] = "Role Templates";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h1 class="m-0"><i class="bi bi-diagram-3"></i> Role Templates</h1>
        <p class="text-muted mb-0">Built-in presets plus custom templates you create. Use templates when adding staff roles.</p>
    </div>
    <div class="col-md-4 text-end">
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Create Template</a>
        <a href="@Url.Action("Index", "StaffRoles")" class="btn btn-outline-secondary"><i class="bi bi-shield-lock"></i> Staff Roles</a>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Template</th>
                    <th>Code</th>
                    <th>Type</th>
                    <th>Menus</th>
                    <th>Roles using</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>
                            <strong>@t.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(t.Description))
                            {
                                <br /><small class="text-muted">@t.Description</small>
                            }
                        </td>
                        <td><code>@t.Code</code></td>
                        <td>
                            @if (t.IsBuiltIn)
                            {
                                <span class="badge bg-info text-dark">Built-in</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Custom</span>
                            }
                        </td>
                        <td>@t.MenuCount</td>
                        <td>@t.RoleCount</td>
                        <td>
                            @if (t.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!t.IsBuiltIn && t.RoleTemplateId.HasValue)
                            {
                                <a href="@Url.Action("Edit", new { id = t.RoleTemplateId })" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">Read-only</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
