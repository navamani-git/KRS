@model KRSDealerManagement.Application.DTOs.PurchaseOrderDto

@using KRSDealerManagement.Application.DTOs

@{

    ViewData["Title"] = "Allocate Vehicles";

    var items = ViewBag.Items as IEnumerable<PurchaseOrderItemDto> ?? Enumerable.Empty<PurchaseOrderItemDto>();

    var pending = items.Where(i => i.CanBeAllocated()).ToList();
    var dealershipId = ViewBag.DealershipId as int?;

}



<div class="row mb-3">

    <div class="col-md-8">

        <h1 class="m-0"><i class="bi bi-box-seam"></i> Allocate / Approve — @Model.OrderNumber</h1>

        <p class="text-muted">@Model.SubdealerName · Ordered @Model.TotalQuantity · Pending @pending.Count · Approved @Model.ApprovedItemCount</p>
        <p class="small text-muted mb-0"><i class="bi bi-info-circle"></i> <strong>Approve</strong> — pick chassis from dealer stock; serial numbers auto-fill. <strong>Reject</strong> — no chassis needed.</p>

    </div>

    <div class="col-md-4 text-end">

        <a href="@Url.EAction(QueryCrypto, "Details", new { id = Model.OrderId })" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>

    </div>

</div>



@if (!pending.Any())

{

    <div class="alert alert-info">No pending vehicles to allocate on this order.</div>

}

else

{

<form method="post" asp-action="Allocate" id="allocForm" novalidate>

    @Html.AntiForgeryToken()

    <input type="hidden" name="orderId" value="@Model.OrderId" />



    <div class="card mb-3">

        <div class="card-header d-flex justify-content-between flex-wrap gap-2">

            <h3 class="card-title mb-0">Pending vehicles (@pending.Count)</h3>

            <div>

                <button type="button" class="btn btn-sm btn-outline-success" onclick="markAll('approve')">Approve all</button>

                <button type="button" class="btn btn-sm btn-outline-danger" onclick="markAll('reject')">Reject all</button>

                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="markAll('pending')">Clear all</button>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-sm table-bordered mb-0 align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th class="grid-col-rownum">#</th>

                            <th>Model</th>

                            <th>Color</th>

                            <th class="text-end">Price</th>

                            <th>Action</th>

                            <th>Chassis No</th>

                            <th>Motor No</th>

                            <th>Battery No</th>

                            <th>Charger No</th>

                            <th>Controller No</th>

                            <th>Converter No</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{ int idx = 0; }

                        @foreach (var item in pending)

                        {

                            <tr data-model-id="@item.ModelId" data-color-id="@item.ColorId">

                                <td>

                                    @(idx + 1)

                                    <input type="hidden" name="orderItemIds[@idx]" value="@item.OrderItemId" />

                                </td>

                                <td>@item.ModelName</td>

                                <td>@item.ColorName</td>

                                <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>

                                <td style="min-width:140px">

                                    <select name="actionFlags[@idx]" class="form-select form-select-sm action-flag" data-idx="@idx" onchange="toggleSerials(@idx)">

                                        <option value="pending" selected>Pending</option>

                                        <option value="approve">Approve</option>

                                        <option value="reject">Reject</option>

                                    </select>

                                </td>

                                <td>
                                    <select name="vehicleMasterIds[@idx]" id="master_@idx" class="form-select form-select-sm chassis-select" data-idx="@idx" disabled>
                                        <option value="">Select chassis</option>
                                    </select>
                                    <input type="hidden" name="chassisNumbers[@idx]" id="chassis_@idx" />
                                </td>

                                <td><input type="text" name="motorNos[@idx]" id="motor_@idx" class="form-control form-control-sm serial" readonly disabled /></td>

                                <td><input type="text" name="batteryNos[@idx]" id="battery_@idx" class="form-control form-control-sm serial" readonly disabled /></td>

                                <td><input type="text" name="chargerNos[@idx]" id="charger_@idx" class="form-control form-control-sm serial" readonly disabled /></td>

                                <td><input type="text" name="controllerNos[@idx]" id="controller_@idx" class="form-control form-control-sm serial" readonly disabled /></td>

                                <td><input type="text" name="converterNos[@idx]" id="converter_@idx" class="form-control form-control-sm serial" readonly disabled /></td>

                            </tr>

                            idx++;

                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="card-footer">

            <div class="mb-2">

                <label class="fw-bold">Remarks</label>

                <input type="text" name="remarks" class="form-control" placeholder="Optional overall remarks" />

            </div>

            <button type="submit" class="btn btn-primary btn-lg">

                <i class="bi bi-check2-all"></i> Submit Allocation

            </button>

            <p class="text-muted small mt-2 mb-0">

                Set each row to <strong>Approve</strong> or <strong>Reject</strong> before submit. Rows left as <strong>Pending</strong> are skipped — allocate one vehicle or many in the same submit.

                Approved rows require selecting a chassis from dealer stock.

            </p>

        </div>

    </div>

</form>

}



<!-- Already processed items -->

@{

    var done = items.Where(i => !i.CanBeAllocated()).ToList();

}

@if (done.Any())

{

    <div class="card">

        <div class="card-header"><h3 class="card-title mb-0">Already processed (@done.Count)</h3></div>

        <div class="card-body p-0">

            <table class="table table-sm mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Model</th><th>Color</th><th>Status</th><th>Chassis</th>

                        <th>Motor</th><th>Battery</th><th>Charger</th><th>Controller</th><th>Converter</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var i in done)

                    {

                        <tr>

                            <td>@i.ModelName</td>

                            <td>@i.ColorName</td>

                            <td><span class="badge @i.GetBadgeClass()">@i.GetStatusDisplay()</span></td>

                            <td><small>@i.ChassisNumber</small></td>

                            <td><small>@i.MotorNo</small></td>

                            <td><small>@i.BatteryNo</small></td>

                            <td><small>@i.ChargerNo</small></td>

                            <td><small>@i.ControllerNo</small></td>

                            <td><small>@i.ConverterNo</small></td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

}



@section Scripts {

<script>
    const dealershipId = @(dealershipId?.ToString() ?? "null");
    const masterCache = {};

    async function loadMasters(idx) {
        const row = document.querySelector(`select[name="actionFlags[${idx}]"]`).closest('tr');
        const modelId = row.dataset.modelId;
        const colorId = row.dataset.colorId;
        const key = `${modelId}_${colorId}`;
        const select = document.getElementById(`master_${idx}`);
        if (!dealershipId || !modelId || !colorId) return;

        if (!masterCache[key]) {
            const res = await fetch(`/VehicleMasters/Available?dealershipId=${dealershipId}&modelId=${modelId}&colorId=${colorId}`);
            masterCache[key] = await res.json();
        }

        const current = select.value;
        select.innerHTML = '<option value="">Select chassis</option>';
        masterCache[key].forEach(m => {
            const opt = document.createElement('option');
            opt.value = m.vehicleMasterId;
            opt.textContent = m.chassisNumber;
            opt.dataset.motor = m.motorNo || '';
            opt.dataset.battery = m.batteryNo || '';
            opt.dataset.charger = m.chargerNo || '';
            opt.dataset.controller = m.controllerNo || '';
            opt.dataset.converter = m.converterNo || '';
            opt.dataset.chassis = m.chassisNumber || '';
            select.appendChild(opt);
        });
        if (current) select.value = current;
    }

    function applyMasterSelection(idx) {
        const select = document.getElementById(`master_${idx}`);
        const opt = select.selectedOptions[0];
        document.getElementById(`chassis_${idx}`).value = opt?.dataset.chassis || '';
        document.getElementById(`motor_${idx}`).value = opt?.dataset.motor || '';
        document.getElementById(`battery_${idx}`).value = opt?.dataset.battery || '';
        document.getElementById(`charger_${idx}`).value = opt?.dataset.charger || '';
        document.getElementById(`controller_${idx}`).value = opt?.dataset.controller || '';
        document.getElementById(`converter_${idx}`).value = opt?.dataset.converter || '';
    }

    function toggleSerials(idx) {
        const action = document.querySelector(`select[name="actionFlags[${idx}]"]`).value;
        const approve = action === 'approve';
        const masterSelect = document.getElementById(`master_${idx}`);
        masterSelect.disabled = !approve;
        masterSelect.required = approve;
        ['motor','battery','charger','controller','converter'].forEach(p => {
            const el = document.getElementById(`${p}_${idx}`);
            el.disabled = !approve;
            if (!approve) el.value = '';
        });
        if (approve) {
            loadMasters(idx);
        } else {
            masterSelect.value = '';
            document.getElementById(`chassis_${idx}`).value = '';
        }
    }

    function markAll(action) {
        document.querySelectorAll('.action-flag').forEach(sel => {
            sel.value = action;
            toggleSerials(sel.dataset.idx);
        });
    }

    document.querySelectorAll('.chassis-select').forEach(sel => {
        sel.addEventListener('change', () => applyMasterSelection(sel.dataset.idx));
    });

    document.getElementById('allocForm')?.addEventListener('submit', function (e) {
        let hasWork = false;
        const masterSeen = new Set();

        document.querySelectorAll('.action-flag').forEach(sel => {
            const action = sel.value;
            if (action === 'approve' || action === 'reject') hasWork = true;

            if (action === 'approve') {
                const idx = sel.dataset.idx;
                const masterSelect = document.getElementById(`master_${idx}`);
                if (!masterSelect.value) {
                    e.preventDefault();
                    masterSelect.focus();
                    alert('Select a chassis from dealer stock for each approved row.');
                    return;
                }
                if (masterSeen.has(masterSelect.value)) {
                    e.preventDefault();
                    masterSelect.focus();
                    alert('The same chassis cannot be allocated to multiple rows.');
                    return;
                }
                masterSeen.add(masterSelect.value);
                applyMasterSelection(idx);
            }
        });

        if (!hasWork) {
            e.preventDefault();
            alert('Set at least one row to Approve or Reject before submitting.');
        }
    });

    document.querySelectorAll('.action-flag').forEach(sel => toggleSerials(sel.dataset.idx));
</script>

}


