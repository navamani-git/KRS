@using KRSDealerManagement.Application.DTOs
@using KRSDealerManagement.Web.Helpers
@{
    ViewData["Title"] = "Create Order for Subdealer";
    var subdealers = ViewBag.Subdealers as IEnumerable<UserDto>;
    var models = ViewBag.Models as IEnumerable<VehicleModelDto>;
    var modelColorMapJson = ViewBag.ModelColorMapJson as string ?? "{}";
    var canViewBalances = ViewBag.CanViewBalances as bool? ?? false;
    ViewData["ExcelImportKey"] = KRSDealerManagement.Web.Helpers.ExcelImport.ExcelImportKeys.OrdersForSubdealer;
    ViewData["ExcelImportReturnAction"] = "CreateForSubdealer";
}

<style>
    #itemsTable th.chassis-col,
    #itemsTable td.chassis-col {
        min-width: 300px;
        width: 300px;
    }
    #itemsTable select.chassis-select {
        min-width: 300px;
        width: 100%;
        font-family: ui-monospace, Consolas, "Courier New", monospace;
        font-size: 0.85rem;
        white-space: nowrap;
    }
</style>

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-cart-plus"></i> Create Order for Subdealer</h1>
        <p class="text-muted">Auto-approved from dealer stock — pick chassis per vehicle. Staff may proceed even if balance is low or negative.</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-list-check"></i> Manage Orders
        </a>
    </div>
</div>

<partial name="_ExcelImport" />

<form method="post" id="orderForm">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-3">
            <div class="card card-primary">
                <div class="card-header"><h3 class="card-title">@(canViewBalances ? "Subdealer & Balance" : "Subdealer")</h3></div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label class="fw-bold">Subdealer <span class="text-danger">*</span></label>
                        <select name="subdealerId" id="subdealerId" class="form-select" required onchange="onSubdealerChanged()">
                            <option value="">-- Select Subdealer --</option>
                            @if (subdealers != null)
                            {
                                @foreach (var s in subdealers)
                                {
                                    <option value="@s.UserId" data-dealership-id="@s.DealershipId">@s.GetFullName()</option>
                                }
                            }
                        </select>
                    </div>

                    @if (canViewBalances)
                    {
                    <div id="balancePanel" class="d-none">
                        <div class="alert alert-success p-2 mb-2">
                            <small>Available Balance:</small>
                            <strong id="availableBalance" class="d-block fs-5">₹0.00</strong>
                        </div>
                        <div class="alert alert-warning p-2 mb-0">
                            <small>Order Total:</small>
                            <strong id="orderTotal" class="d-block fs-5">₹0.00</strong>
                        </div>
                        <div id="balanceWarning" class="alert alert-info p-2 mt-2 mb-0 d-none">
                            <i class="bi bi-info-circle"></i>
                            <small>Order exceeds available balance. You can still proceed; balance may go negative.</small>
                        </div>
                    </div>

                    <div id="noAccountMsg" class="alert alert-danger d-none">
                        <i class="bi bi-exclamation-triangle"></i> No account found for selected subdealer.
                    </div>
                    }

                    <div class="form-group mt-3">
                        <label class="fw-bold">Admin Notes</label>
                        <textarea name="adminNotes" class="form-control" rows="3"
                                  placeholder="Optional notes for this order"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Vehicles to Approve</h3>
                    <button type="button" class="btn btn-sm btn-success" onclick="addItem()">
                        <i class="bi bi-plus-circle"></i> Add Vehicle
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm mb-0 align-middle" id="itemsTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>Model</th>
                                    <th>Color</th>
                                    <th>Price (₹)</th>
                                    <th class="chassis-col">Chassis (Dealer Stock) <span class="text-danger">*</span></th>
                                    <th>Motor No</th>
                                    <th>Battery No</th>
                                    <th>Charger No</th>
                                    <th>Controller No</th>
                                    <th>Converter No</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="itemsBody"></tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="2" class="text-end">Grand Total:</td>
                                    <td id="grandTotal" class="text-success">₹0.00</td>
                                    <td colspan="7"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div id="noItemsMsg" class="alert alert-warning m-3">
                        <i class="bi bi-info-circle"></i> Select a subdealer and click "Add Vehicle". Pick chassis from dealer stock for each row.
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-lg" id="placeOrderBtn" disabled>
                        <i class="bi bi-check-circle"></i> Create &amp; Approve Order
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/model-color-filter.js"></script>
    <script>
        (function () {
            const canViewBalances = @(canViewBalances ? "true" : "false");
            const sessionDealershipId = @(SessionHelper.GetDealershipScope(Context.Session)?.ToString() ?? "null");
            const models = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (models ?? new List<VehicleModelDto>())
                .Select(m => new { id = m.ModelId, name = m.ModelName })));

            KrsModelColors.init(@Html.Raw(modelColorMapJson));

            let availableBalance = 0;
            let nextRowId = 0;
            const chassisCache = {};

            function chassisSelectEls() {
                return document.querySelectorAll('#itemsBody select[name="vehicleMasterIds"]');
            }

            function selectedMasterIds(exceptId) {
                const taken = new Set();
                chassisSelectEls().forEach(el => {
                    const rid = el.id.replace('master_', '');
                    if (String(rid) === String(exceptId)) return;
                    if (el.value) taken.add(String(el.value));
                });
                return taken;
            }

            function cacheKey(dealershipId, modelId, colorId) {
                return `${dealershipId}_${modelId}_${colorId}`;
            }

            function fillChassisSelect(id, options) {
                const select = document.getElementById(`master_${id}`);
                if (!select) return;
                const taken = selectedMasterIds(id);
                const current = select.value;
                select.innerHTML = '<option value="">Select chassis</option>';
                let shown = 0;
                (options || []).forEach(m => {
                    const vid = String(m.vehicleMasterId || m.VehicleMasterId || '');
                    if (!vid) return;
                    if (taken.has(vid) && vid !== String(current)) return;
                    const opt = document.createElement('option');
                    opt.value = vid;
                    opt.textContent = m.chassisNumber || m.ChassisNumber || '';
                    opt.dataset.motor = m.motorNo || m.MotorNo || '';
                    opt.dataset.battery = m.batteryNo || m.BatteryNo || '';
                    opt.dataset.charger = m.chargerNo || m.ChargerNo || '';
                    opt.dataset.controller = m.controllerNo || m.ControllerNo || '';
                    opt.dataset.converter = m.converterNo || m.ConverterNo || '';
                    select.appendChild(opt);
                    shown += 1;
                });
                if (current) select.value = current;
                if (shown === 0) {
                    const empty = document.createElement('option');
                    empty.value = '';
                    empty.textContent = 'No chassis in dealer stock for this model/color';
                    select.appendChild(empty);
                }
            }

            function refreshOtherChassisDropdowns(exceptId) {
                const dealershipId = resolveDealershipId();
                chassisSelectEls().forEach(el => {
                    const id = el.id.replace('master_', '');
                    if (!id || String(id) === String(exceptId)) return;
                    const modelId = document.getElementById(`model_${id}`)?.value;
                    const colorId = document.getElementById(`color_${id}`)?.value;
                    if (!dealershipId || !modelId || !colorId) return;
                    const cached = chassisCache[cacheKey(dealershipId, modelId, colorId)];
                    if (cached) fillChassisSelect(id, cached);
                });
            }

            function fillSerials(id) {
                const select = document.getElementById(`master_${id}`);
                const opt = select?.selectedOptions?.[0];
                document.getElementById(`motor_${id}`).value = opt?.dataset.motor || '';
                document.getElementById(`battery_${id}`).value = opt?.dataset.battery || '';
                document.getElementById(`charger_${id}`).value = opt?.dataset.charger || '';
                document.getElementById(`controller_${id}`).value = opt?.dataset.controller || '';
                document.getElementById(`converter_${id}`).value = opt?.dataset.converter || '';
            }

            function buildModelSelect(id, onChange) {
                let opts = `<option value="">-- Select --</option>`;
                models.forEach(o => opts += `<option value="${o.id}">${o.name}</option>`);
                return `<select name="modelIds" id="${id}" class="form-select form-select-sm" required onchange="${onChange}">${opts}</select>`;
            }

            function buildColorSelect(id, onChange) {
                return `<select name="colorIds" id="${id}" class="form-select form-select-sm" required onchange="${onChange}">
                    <option value="">-- Select Model First --</option></select>`;
            }

            function chassisSelect(id) {
                return `<select name="vehicleMasterIds" id="master_${id}" class="form-select form-select-sm chassis-select" required onchange="onChassisChanged(${id})">
                    <option value="">Select chassis</option></select>`;
            }

            function readonlySerial(name, fieldId) {
                return `<input type="text" name="${name}" id="${fieldId}" class="form-control form-control-sm" readonly />`;
            }

            window.onChassisChanged = function (id) {
                fillSerials(id);
                refreshOtherChassisDropdowns(id);
            };

            function resolveDealershipId() {
                if (sessionDealershipId)
                    return sessionDealershipId;
                const opt = document.getElementById('subdealerId')?.selectedOptions?.[0];
                const id = parseInt(opt?.dataset.dealershipId || '0', 10);
                return id > 0 ? id : null;
            }

            async function loadChassisOptions(id) {
                const modelId = document.getElementById(`model_${id}`).value;
                const colorId = document.getElementById(`color_${id}`).value;
                const select = document.getElementById(`master_${id}`);
                const dealershipId = resolveDealershipId();
                if (!select) return;
                select.innerHTML = '<option value="">Select chassis</option>';
                fillSerials(id);
                if (!dealershipId || !modelId || !colorId) return;
                const key = cacheKey(dealershipId, modelId, colorId);
                try {
                    if (!chassisCache[key]) {
                        const res = await KrsQueryString.fetchGet('/VehicleMasters/Available', {
                            dealershipId: String(dealershipId),
                            modelId: String(modelId),
                            colorId: String(colorId)
                        });
                        if (!res.ok) return;
                        chassisCache[key] = await res.json();
                    }
                    fillChassisSelect(id, chassisCache[key]);
                    fillSerials(id);
                    refreshOtherChassisDropdowns(id);
                } catch (e) {
                    console.error(e);
                }
            }

            window.onSubdealerChanged = function () {
                if (canViewBalances) loadAccount();
                Object.keys(chassisCache).forEach(k => delete chassisCache[k]);
                chassisSelectEls().forEach(el => {
                    const id = el.id.replace('master_', '');
                    if (id) loadChassisOptions(id);
                });
            };

            window.loadAccount = function () {
                if (!canViewBalances) return;

                const subdealerId = document.getElementById('subdealerId').value;
                availableBalance = 0;
                document.getElementById('balancePanel').classList.add('d-none');
                document.getElementById('noAccountMsg').classList.add('d-none');
                updateTotals();

                if (!subdealerId) return;

                KrsQueryString.fetchGet('/Orders/GetSubdealerAccount', { subdealerId })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            availableBalance = data.availableBalance;
                            document.getElementById('availableBalance').textContent =
                                `₹${availableBalance.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
                            document.getElementById('balancePanel').classList.remove('d-none');
                            updateTotals();
                        } else {
                            document.getElementById('noAccountMsg').classList.remove('d-none');
                            alert(data.message);
                        }
                    });
            };

            window.addItem = function () {
                const subdealerId = document.getElementById('subdealerId').value;
                if (!subdealerId) {
                    alert('Please select a subdealer first.');
                    return;
                }

                nextRowId += 1;
                const id = nextRowId;
                const row = document.createElement('tr');
                row.id = `row_${id}`;
                row.innerHTML = `
                    <td>${buildModelSelect(`model_${id}`, `onModelChanged(${id})`)}</td>
                    <td>${buildColorSelect(`color_${id}`, `onColorChanged(${id})`)}</td>
                    <td>
                        <input type="text" name="unitPrices" id="price_${id}" class="form-control form-control-sm amount-input"
                            value="0.00" readonly style="width:130px"/>
                        <span id="total_${id}" class="d-none">0</span>
                    </td>
                    <td class="chassis-col">${chassisSelect(id)}</td>
                    <td>${readonlySerial('motorNos', `motor_${id}`)}</td>
                    <td>${readonlySerial('batteryNos', `battery_${id}`)}</td>
                    <td>${readonlySerial('chargerNos', `charger_${id}`)}</td>
                    <td>${readonlySerial('controllerNos', `controller_${id}`)}</td>
                    <td>${readonlySerial('converterNos', `converter_${id}`)}</td>
                    <td><button type="button" class="btn btn-sm btn-danger" onclick="removeItem(${id})">
                        <i class="bi bi-trash"></i></button></td>`;
                document.getElementById('itemsBody').appendChild(row);
                document.getElementById('noItemsMsg').classList.add('d-none');
                updateTotals();
            };

            window.removeItem = function (id) {
                document.getElementById(`row_${id}`)?.remove();
                if (document.getElementById('itemsBody').rows.length === 0) {
                    document.getElementById('noItemsMsg').classList.remove('d-none');
                }
                refreshOtherChassisDropdowns(null);
                updateTotals();
            };

            window.onColorChanged = function (id) {
                loadChassisOptions(id);
                loadPrice(id);
            };

            window.onModelChanged = function (id) {
                const modelSelect = document.getElementById(`model_${id}`);
                const colorSelect = document.getElementById(`color_${id}`);
                KrsModelColors.populateSelect(colorSelect, modelSelect.value, null);
                if (window.krsSetIndianAmount) window.krsSetIndianAmount(document.getElementById(`price_${id}`), 0);
                else document.getElementById(`price_${id}`).value = '0.00';
                document.getElementById(`total_${id}`).textContent = 0;
                loadChassisOptions(id);
                updateTotals();
            };

            window.loadPrice = function (id) {
                const modelId = document.getElementById(`model_${id}`).value;
                const colorId = document.getElementById(`color_${id}`).value;
                if (!modelId || !colorId) return;

                KrsQueryString.fetchGet('/Orders/GetPrice', { modelId, colorId })
                    .then(r => r.json())
                    .then(data => {
                        const price = data.success ? data.price : 0;
                        const el = document.getElementById(`price_${id}`);
                        if (window.krsSetIndianAmount) window.krsSetIndianAmount(el, price);
                        else el.value = Number(price).toFixed(2);
                        document.getElementById(`total_${id}`).textContent = price;
                        updateTotals();
                        if (!data.success) alert(data.message);
                    })
                    .catch(() => {
                        const el = document.getElementById(`price_${id}`);
                        if (window.krsSetIndianAmount) window.krsSetIndianAmount(el, 0);
                        else el.value = '0.00';
                        document.getElementById(`total_${id}`).textContent = 0;
                        updateTotals();
                    });
            };

            function updateTotals() {
                let grand = 0;
                document.querySelectorAll('[id^="price_"]').forEach(el => {
                    grand += window.krsParseIndianAmount
                        ? (window.krsParseIndianAmount(el.value) || 0)
                        : (parseFloat(String(el.value).replace(/,/g, '')) || 0);
                });
                document.getElementById('grandTotal').textContent =
                    `₹${grand.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;

                const orderTotalEl = document.getElementById('orderTotal');
                if (orderTotalEl) {
                    orderTotalEl.textContent = `₹${grand.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
                }

                const btn = document.getElementById('placeOrderBtn');
                const hasItems = document.getElementById('itemsBody').rows.length > 0;
                const hasSubdealer = !!document.getElementById('subdealerId').value;
                const warn = document.getElementById('balanceWarning');
                if (warn) {
                    warn.classList.toggle('d-none', !(canViewBalances && grand > 0 && grand > availableBalance));
                }
                btn.disabled = !(hasSubdealer && hasItems && grand > 0);
            }
        })();
    </script>
}
