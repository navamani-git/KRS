@using KRSDealerManagement.Application.DTOs
@{
    ViewData["Title"] = "Create Order for Subdealer";
    var subdealers = ViewBag.Subdealers as IEnumerable<UserDto>;
    var models = ViewBag.Models as IEnumerable<VehicleModelDto>;
    var modelColorMapJson = ViewBag.ModelColorMapJson as string ?? "{}";
    var canViewBalances = ViewBag.CanViewBalances as bool? ?? false;
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1 class="m-0"><i class="bi bi-cart-plus"></i> Create Order for Subdealer</h1>
        <p class="text-muted">Auto-approved with serial numbers — same as the allocate/approve step. Staff may proceed even if balance is low or negative.</p>
    </div>
    <div class="col-md-6 text-end">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-list-check"></i> Manage Orders
        </a>
    </div>
</div>

<form method="post" id="orderForm">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-3">
            <div class="card card-primary">
                <div class="card-header"><h3 class="card-title">@(canViewBalances ? "Subdealer & Balance" : "Subdealer")</h3></div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label class="fw-bold">Subdealer <span class="text-danger">*</span></label>
                        <select name="subdealerId" id="subdealerId" class="form-select" required @(canViewBalances ? "onchange=\"loadAccount()\"" : "")>
                            <option value="">-- Select Subdealer --</option>
                            @if (subdealers != null)
                            {
                                @foreach (var s in subdealers)
                                {
                                    <option value="@s.UserId">@s.GetFullName()</option>
                                }
                            }
                        </select>
                    </div>

                    @if (canViewBalances)
                    {
                    <div id="balancePanel" class="d-none">
                        <div class="alert alert-success p-2 mb-2">
                            <small>Available Balance:</small>
                            <strong id="availableBalance" class="d-block fs-5">₹0.00</strong>
                        </div>
                        <div class="alert alert-warning p-2 mb-0">
                            <small>Order Total:</small>
                            <strong id="orderTotal" class="d-block fs-5">₹0.00</strong>
                        </div>
                        <div id="balanceWarning" class="alert alert-info p-2 mt-2 mb-0 d-none">
                            <i class="bi bi-info-circle"></i>
                            <small>Order exceeds available balance. You can still proceed; balance may go negative.</small>
                        </div>
                    </div>

                    <div id="noAccountMsg" class="alert alert-danger d-none">
                        <i class="bi bi-exclamation-triangle"></i> No account found for selected subdealer.
                    </div>
                    }

                    <div class="form-group mt-3">
                        <label class="fw-bold">Admin Notes</label>
                        <textarea name="adminNotes" class="form-control" rows="3"
                                  placeholder="Optional notes for this order"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Vehicles to Approve</h3>
                    <button type="button" class="btn btn-sm btn-success" onclick="addItem()">
                        <i class="bi bi-plus-circle"></i> Add Vehicle
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm mb-0 align-middle" id="itemsTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>Model</th>
                                    <th>Color</th>
                                    <th>Price (₹)</th>
                                    <th>Chassis No <span class="text-danger">*</span></th>
                                    <th>Motor No <span class="text-danger">*</span></th>
                                    <th>Battery No <span class="text-danger">*</span></th>
                                    <th>Charger No <span class="text-danger">*</span></th>
                                    <th>Controller No <span class="text-danger">*</span></th>
                                    <th>Converter No <span class="text-danger">*</span></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="itemsBody"></tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="2" class="text-end">Grand Total:</td>
                                    <td id="grandTotal" class="text-success">₹0.00</td>
                                    <td colspan="7"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div id="noItemsMsg" class="alert alert-warning m-3">
                        <i class="bi bi-info-circle"></i> Select a subdealer and click "Add Vehicle". Enter serial numbers for each vehicle (one row = one approved vehicle).
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary btn-lg" id="placeOrderBtn" disabled>
                        <i class="bi bi-check-circle"></i> Create &amp; Approve Order
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/model-color-filter.js"></script>
    <script>
        (function () {
            const canViewBalances = @(canViewBalances ? "true" : "false");
            const models = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (models ?? new List<VehicleModelDto>())
                .Select(m => new { id = m.ModelId, name = m.ModelName })));

            KrsModelColors.init(@Html.Raw(modelColorMapJson));

            let availableBalance = 0;
            let nextRowId = 0;

            function buildModelSelect(id, onChange) {
                let opts = `<option value="">-- Select --</option>`;
                models.forEach(o => opts += `<option value="${o.id}">${o.name}</option>`);
                return `<select name="modelIds" id="${id}" class="form-select form-select-sm" required onchange="${onChange}">${opts}</select>`;
            }

            function buildColorSelect(id, onChange) {
                return `<select name="colorIds" id="${id}" class="form-select form-select-sm" required onchange="${onChange}">
                    <option value="">-- Select Model First --</option></select>`;
            }

            function serialInput(name) {
                return `<input type="text" name="${name}" class="form-control form-control-sm serial-input" required />`;
            }

            window.loadAccount = function () {
                if (!canViewBalances) return;

                const subdealerId = document.getElementById('subdealerId').value;
                availableBalance = 0;
                document.getElementById('balancePanel').classList.add('d-none');
                document.getElementById('noAccountMsg').classList.add('d-none');
                updateTotals();

                if (!subdealerId) return;

                KrsQueryString.fetchGet('/Orders/GetSubdealerAccount', { subdealerId })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            availableBalance = data.availableBalance;
                            document.getElementById('availableBalance').textContent =
                                `₹${availableBalance.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
                            document.getElementById('balancePanel').classList.remove('d-none');
                            updateTotals();
                        } else {
                            document.getElementById('noAccountMsg').classList.remove('d-none');
                            alert(data.message);
                        }
                    });
            };

            window.addItem = function () {
                const subdealerId = document.getElementById('subdealerId').value;
                if (!subdealerId) {
                    alert('Please select a subdealer first.');
                    return;
                }

                nextRowId += 1;
                const id = nextRowId;
                const row = document.createElement('tr');
                row.id = `row_${id}`;
                row.innerHTML = `
                    <td>${buildModelSelect(`model_${id}`, `onModelChanged(${id})`)}</td>
                    <td>${buildColorSelect(`color_${id}`, `loadPrice(${id})`)}</td>
                    <td>
                        <input type="number" name="unitPrices" id="price_${id}" class="form-control form-control-sm"
                            value="0" min="0" step="0.01" readonly style="width:100px"/>
                        <span id="total_${id}" class="d-none">0</span>
                    </td>
                    <td>${serialInput('chassisNumbers')}</td>
                    <td>${serialInput('motorNos')}</td>
                    <td>${serialInput('batteryNos')}</td>
                    <td>${serialInput('chargerNos')}</td>
                    <td>${serialInput('controllerNos')}</td>
                    <td>${serialInput('converterNos')}</td>
                    <td><button type="button" class="btn btn-sm btn-danger" onclick="removeItem(${id})">
                        <i class="bi bi-trash"></i></button></td>`;
                document.getElementById('itemsBody').appendChild(row);
                document.getElementById('noItemsMsg').classList.add('d-none');
                updateTotals();
            };

            window.removeItem = function (id) {
                document.getElementById(`row_${id}`)?.remove();
                if (document.getElementById('itemsBody').rows.length === 0) {
                    document.getElementById('noItemsMsg').classList.remove('d-none');
                }
                updateTotals();
            };

            window.onModelChanged = function (id) {
                const modelSelect = document.getElementById(`model_${id}`);
                const colorSelect = document.getElementById(`color_${id}`);
                KrsModelColors.populateSelect(colorSelect, modelSelect.value, null);
                document.getElementById(`price_${id}`).value = 0;
                document.getElementById(`total_${id}`).textContent = 0;
                updateTotals();
            };

            window.loadPrice = function (id) {
                const modelId = document.getElementById(`model_${id}`).value;
                const colorId = document.getElementById(`color_${id}`).value;
                if (!modelId || !colorId) return;

                KrsQueryString.fetchGet('/Orders/GetPrice', { modelId, colorId })
                    .then(r => r.json())
                    .then(data => {
                        document.getElementById(`price_${id}`).value = data.success ? data.price : 0;
                        document.getElementById(`total_${id}`).textContent = data.success ? data.price : 0;
                        updateTotals();
                        if (!data.success) alert(data.message);
                    });
            };

            function updateTotals() {
                let grand = 0;
                document.querySelectorAll('[id^="price_"]').forEach(el => {
                    grand += parseFloat(el.value || 0);
                });
                document.getElementById('grandTotal').textContent =
                    `₹${grand.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;

                const orderTotalEl = document.getElementById('orderTotal');
                if (orderTotalEl) {
                    orderTotalEl.textContent = `₹${grand.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
                }

                const btn = document.getElementById('placeOrderBtn');
                const hasItems = document.getElementById('itemsBody').rows.length > 0;
                const hasSubdealer = !!document.getElementById('subdealerId').value;
                const warn = document.getElementById('balanceWarning');
                if (warn) {
                    warn.classList.toggle('d-none', !(canViewBalances && grand > 0 && grand > availableBalance));
                }
                btn.disabled = !(hasSubdealer && hasItems && grand > 0);
            }
        })();
    </script>
}
